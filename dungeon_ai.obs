use API.Ollama, Collection, System.Concurrency;

class AIRequest {
    @key    : String;
    @prompt : String;

    New(k : String, p : String) {
        @key := k; @prompt := p;
    }

    method : public : GetKey()    ~ String { return @key; }
    method : public : GetPrompt() ~ String { return @prompt; }
}

class AIWorker from Thread {
    @queue  : static : Queue<AIRequest>;
    @cache  : static : Hash<String, String>;
    @mutex  : static : ThreadMutex;
    @model  : static : String;
    @active : static : Bool;

    New() { Parent("ai-worker"); }

    function : Init(model_name : String) ~ Nil {
        @queue  := Queue->New()<AIRequest>;
        @cache  := Hash->New()<String, String>;
        @mutex  := ThreadMutex->New("ai-cache");
        @model  := model_name;
        @active := false;
    }

    function : Post(key : String, prompt : String) ~ Nil {
        if(@queue = Nil | @mutex = Nil) { return; };
        critical(@mutex) {
            @queue->AddBack(AIRequest->New(key, prompt));
        };
    }

    function : GetCached(key : String) ~ String {
        if(@cache = Nil | @mutex = Nil) { return Nil; };
        result : String;
        critical(@mutex) {
            result := @cache->Find(key);
        };
        return result;
    }

    function : HasCached(key : String) ~ Bool {
        if(@cache = Nil | @mutex = Nil) { return false; };
        found : Bool;
        critical(@mutex) { found := @cache->Has(key); };
        return found;
    }

    method : public : Run(data : Base) ~ Nil {
        @active := true;
        while(@active) {
            entry : AIRequest;
            critical(@mutex) {
                if(<>@queue->IsEmpty()) {
                    entry := @queue->RemoveFront();
                };
            };

            if(entry <> Nil) {
                key := entry->GetKey();
                already : Bool;
                critical(@mutex) { already := @cache->Has(key); };
                if(<>already) {
                    result := Completion->Generate(@model, entry->GetPrompt(), Options->New()->SetTemperature(0.9));
                    if(result <> Nil) {
                        clipped := DungeonAI->Clip(result);
                        if(clipped <> Nil) {
                            critical(@mutex) {
                                @cache->Insert(key, clipped);
                            };
                        };
                    };
                };
            }
            else {
                Thread->Sleep(10);
            };
        };
    }
}

class DungeonAI {
    @model : static : String;
    @is_ready : static : Bool;
    @boss_round : static : Int;
    @worker : static : AIWorker;

    # --- Q-Learning Combat AI ---
    @q_table   : static : Float[];  # 9 states x 3 actions = 27 values
    @q_state   : static : Int;
    @q_action  : static : Int;
    @q_epsilon : static : Float;
    @q_fights  : static : Int;

    consts QAction {
        ATTACK  := 0,
        ABILITY := 1,
        DEFEND  := 2
    }

    # --- Dungeon Theme (generated once at game start) ---
    @theme_name      : static : String;
    @theme_lore      : static : String;
    @theme_archetype : static : Int;   # 0=undead 1=beast 2=infernal 3=arcane
    @theme_treasure  : static : Int;   # 0=weapon 1=magic 2=gold
    @theme_ready     : static : Bool;
    @theme_thread    : static : Thread;

    @world_name   : static : String;
    @world_threat : static : String;
    @world_ready  : static : Bool;
    @world_thread : static : Thread;

    consts Archetype {
        UNDEAD   := 0,
        BEAST    := 1,
        INFERNAL := 2,
        ARCANE   := 3
    }

    consts Treasure {
        WEAPON := 0,
        MAGIC  := 1,
        GOLD   := 2
    }

    function : InitModel() ~ String {
        models := Model->List();
        if(models = Nil) {
            @is_ready := false;
            return Nil;
        };
        if(models->Size() = 0) {
            @is_ready := false;
            return Nil;
        };

        m := models->Get(0)->As(Model);
        if(m = Nil) {
            @is_ready := false;
            return Nil;
        };

        mp := m->GetPulled();
        if(mp = Nil) {
            @is_ready := false;
            return Nil;
        };

        @model := mp->GetName();
        @boss_round := 0;
        InitQTable();
        # Start async worker before setting @is_ready so callers see a consistent state
        AIWorker->Init(@model);
        w := AIWorker->New();
        w->Execute(Nil);
        @worker := w;
        @is_ready := true;
        return @model;
    }

    function : IsReady() ~ Bool {
        return @is_ready;
    }

    function : StartThemeAsync() ~ Nil {
        if(<>@is_ready | @theme_thread <> Nil) { return; };
        @theme_thread := ThemeLoaderThread->New();
        @theme_thread->Execute(Nil);
    }

    function : GetModelName() ~ String {
        return @model;
    }

    # --- Async worker interface ---

    function : PostRequest(key : String, prompt : String) ~ Nil {
        if(@worker = Nil | <>@is_ready) { return; };
        if(<>AIWorker->HasCached(key)) {
            AIWorker->Post(key, prompt);
        };
    }

    function : GetCached(key : String) ~ String {
        if(@worker = Nil) { return Nil; };
        return AIWorker->GetCached(key);
    }

    function : PostFloorBattleCries(floor : Int, class_name : String) ~ Nil {
        if(@worker = Nil | <>@is_ready) { return; };
        PostCry("Mimic", class_name);
        if(floor = 1) {
            PostCry("Giant Rat", class_name);    PostCry("Cave Bat", class_name);
            PostCry("Skeleton", class_name);     PostCry("Dungeon Spider", class_name);
            PostCry("Zombie", class_name);       PostCry("Mushroom Fiend", class_name);
            PostCry("Kobold", class_name);
        }
        else if(floor = 2) {
            PostCry("Ghost", class_name);        PostCry("Shadow", class_name);
            PostCry("Ghoul", class_name);        PostCry("Wraith", class_name);
            PostCry("Dark Priest", class_name);  PostCry("Vampire", class_name);
            PostCry("Banshee", class_name);
        }
        else if(floor = 3) {
            PostCry("Ogre", class_name);         PostCry("Troll", class_name);
            PostCry("Dark Knight", class_name);  PostCry("Gargoyle", class_name);
            PostCry("Lich", class_name);         PostCry("Stone Golem", class_name);
            PostCry("Werewolf", class_name);     PostCry("Medusa", class_name);
        }
        else {
            PostCry("Demon", class_name);        PostCry("Hellhound", class_name);
            PostCry("Dark Sorcerer", class_name); PostCry("Dragon", class_name);
            PostCry("Balor", class_name);        PostCry("Eye Tyrant", class_name);
            PostCry("Nightmare", class_name);
        };
    }

    function : PostCry(monster_name : String, class_name : String) ~ Nil {
        key := "cry:{$monster_name}";
        if(AIWorker->HasCached(key)) { return; };
        prompt := "A {$monster_name} lunges at a {$class_name} in a dark dungeon. ONE menacing battle cry, max 9 words. No quotes.";
        AIWorker->Post(key, prompt);
    }

    # --- Town / Castle async messages ---

    function : PostTownMessages(class_name : String, world_name : String) ~ Nil {
        if(@worker = Nil | <>@is_ready) { return; };
        PostRequest("inn_rest",     "The {$class_name} rests at an inn in {$world_name}. Write ONE brief, atmospheric rest message, max 10 words. No quotes.");
        PostRequest("healer_greet", "A dungeon healer greets a weary {$class_name}. ONE short welcoming line, max 9 words. No quotes.");
        PostRequest("tavern_rumor", "A tavern keeper in {$world_name} shares a cryptic dungeon rumor with a {$class_name}. ONE sentence, max 12 words. No quotes.");
        PostRequest("shop_greet",   "A weapon merchant greets an adventurous {$class_name}. ONE short sales line, max 8 words. No quotes.");
    }

    function : PostCastleMessages(class_name : String, threat : String) ~ Nil {
        if(@worker = Nil | <>@is_ready) { return; };
        if(threat <> Nil & <>threat->IsEmpty()) {
            PostRequest("lord_speech", "A castle lord tells a {$class_name}: '{$threat}'. Rephrase urgently in ONE sentence, max 13 words. No quotes.");
        }
        else {
            PostRequest("lord_speech", "A castle lord urges a {$class_name} to descend into Greyhold and defeat the demon lord. ONE dramatic sentence, max 13 words. No quotes.");
        };
        PostRequest("lord_reward",  "A castle lord thanks a {$class_name} for defeating a demon lord. ONE grateful royal line, max 10 words. No quotes.");
    }

    function : GetTownMsg(key : String) ~ String {
        return GetCached(key);
    }

    function : Clip(text : String) ~ String {
        if(text = Nil) { return Nil; };
        if(text->IsEmpty()) { return Nil; };
        # strip DeepSeek R1 <think>...</think> reasoning block
        think_end := text->Find("</think>");
        if(think_end >= 0) {
            after_start := think_end + 8;
            after_len := text->Size() - after_start;
            if(after_len > 0) {
                sub := text->SubString(after_start, after_len);
                if(sub = Nil) { return Nil; };
                text := sub->Trim();
            }
            else {
                return Nil;
            };
        }
        else {
            text := text->Trim();
        };
        if(text = Nil) { return Nil; };
        if(text->IsEmpty()) { return Nil; };
        if(text->Size() > 72) {
            clipped := text->SubString(0, 69);
            clipped->Append("...");
            return clipped;
        };
        return text;
    }

    function : PlaqueText(floor : Int, player_class : String) ~ String {
        if(<>@is_ready) { return Nil; };
        prompt := "Write a cryptic dungeon wall inscription for Greyhold dungeon floor {$floor}. A {$player_class} reads it. ONE sentence, max 11 words, ominous and mysterious. No quotes.";
        return Clip(Completion->Generate(@model, prompt, Options->New()->SetTemperature(0.9)));
    }

    function : RuneRiddle(seq_str : String) ~ String {
        if(<>@is_ready) { return Nil; };
        prompt := "A dungeon door opens by pressing these directions: {$seq_str}. Write ONE cryptic riddle hint (max 12 words) that alludes to these directions. No quotes.";
        return Clip(Completion->Generate(@model, prompt, Options->New()->SetTemperature(0.8)));
    }

    function : SpellHint(element : String) ~ String {
        if(<>@is_ready) { return Nil; };
        prompt := "A magical dungeon door requires the element {$element} to open. Write ONE cryptic riddle hint (max 11 words) alluding to {$element}. No quotes.";
        return Clip(Completion->Generate(@model, prompt, Options->New()->SetTemperature(0.8)));
    }

    function : MerchantGreet(player_class : String, gold : Int, floor : Int) ~ String {
        if(<>@is_ready) { return Nil; };
        prompt := "You are a sly dungeon merchant. A {$player_class} with {$gold} gold arrives on floor {$floor} of a dark dungeon. Greet them in ONE sentence, max 12 words, sly tone. No quotes.";
        return Clip(Completion->Generate(@model, prompt, Options->New()->SetTemperature(0.85)));
    }

    function : MerchantReact(item : String, afforded : Bool) ~ String {
        if(<>@is_ready) { return Nil; };

        ai_response : String;
        if(afforded) {
            prompt := "Sly dungeon merchant just sold an item called '{$item}'. ONE witty satisfied line, max 9 words. No quotes.";
            ai_response := Clip(Completion->Generate(@model, prompt, Options->New()->SetTemperature(0.85)));
        }
        else {
            prompt := "Sly dungeon merchant: customer cannot afford '{$item}'. ONE mocking line, max 9 words. No quotes.";
            ai_response := Clip(Completion->Generate(@model, prompt, Options->New()->SetTemperature(0.85)));
        };

        return ai_response;
    }

    function : BossIntro(player_class : String, floor : Int, kills : Int) ~ String {
        if(<>@is_ready) { return Nil; };
        @boss_round := 0;
        prompt := "You are Malachar, an ancient demon lord in a dark fantasy dungeon. A {$player_class} who slew {$kills} of your minions stands before you. Greet them with contempt in ONE sentence, max 14 words. No quotes.";
        return Clip(Completion->Generate(@model, prompt, Options->New()->SetTemperature(0.8)));
    }

    function : BossTaunt(player_class : String, boss_hp_perc : Int) ~ String {
        if(<>@is_ready) { return Nil; };
        @boss_round += 1;
        round := @boss_round;

        mood : String;
        if(boss_hp_perc > 66) {
            mood := "powerful and contemptuous";
        }
        else if(boss_hp_perc > 33) {
            mood := "angered and focused";
        }
        else {
            mood := "enraged and desperate";
        };

        prompt := "You are Malachar, demon lord at {$boss_hp_perc}% HP, feeling {$mood}. Fighting a {$player_class}, round {$round}. ONE sinister battle taunt, max 11 words. No quotes.";
        return Clip(Completion->Generate(@model, prompt, Options->New()->SetTemperature(0.85)));
    }

    # --- Q-Learning Combat AI ---

    function : InitQTable() ~ Nil {
        @q_table := Float->New[27];
        for(s := 0; s < 9; s += 1;) {
            @q_table[s * 3 + 0] := 1.0;  # ATTACK default
            @q_table[s * 3 + 1] := 0.5;  # ABILITY default
            @q_table[s * 3 + 2] := 0.3;  # DEFEND default
        };
        # monster critical HP: bias toward DEFEND or ABILITY
        @q_table[6 * 3 + 2] := 0.9;  # mon_crit + player_healthy -> DEFEND
        @q_table[7 * 3 + 2] := 0.7;  # mon_crit + player_hurt   -> DEFEND
        @q_table[8 * 3 + 1] := 0.9;  # mon_crit + player_crit   -> ABILITY (gamble)
        @q_epsilon := 0.3;
        @q_fights  := 0;
    }

    function : GetHpBucket(hp_perc : Int) ~ Int {
        if(hp_perc > 60) { return 0; }
        else if(hp_perc > 30) { return 1; }
        else { return 2; };
    }

    function : GetQState(mon_hp_perc : Int, player_hp_perc : Int) ~ Int {
        return GetHpBucket(mon_hp_perc) * 3 + GetHpBucket(player_hp_perc);
    }

    function : ChooseAction(mon_hp_perc : Int, player_hp_perc : Int, has_ability : Bool) ~ Int {
        if(@q_table = Nil) { return DungeonAI->QAction->ATTACK; };

        state := GetQState(mon_hp_perc, player_hp_perc);
        @q_state := state;

        # epsilon-greedy exploration
        explore := Int->Random(99)->As(Float) / 99.0;
        if(explore < @q_epsilon) {
            action : Int;
            if(has_ability) { action := Int->Random(3); }
            else {
                action := Int->Random(2);
                if(action = 1) { action := DungeonAI->QAction->DEFEND; };
            };
            @q_action := action;
            return action;
        };

        # greedy: pick highest Q value
        base := state * 3;
        best_action := DungeonAI->QAction->ATTACK;
        best_q := @q_table[base];

        if(has_ability & @q_table[base + 1] > best_q) {
            best_q := @q_table[base + 1];
            best_action := DungeonAI->QAction->ABILITY;
        };
        if(@q_table[base + 2] > best_q) {
            best_action := DungeonAI->QAction->DEFEND;
        };

        @q_action := best_action;
        return best_action;
    }

    function : UpdateQ(reward : Float, new_mon_hp_perc : Int, new_player_hp_perc : Int) ~ Nil {
        if(@q_table = Nil) { return; };

        alpha := 0.15;
        gamma := 0.8;

        new_state := GetQState(new_mon_hp_perc, new_player_hp_perc);
        new_base  := new_state * 3;

        max_next := @q_table[new_base];
        if(@q_table[new_base + 1] > max_next) { max_next := @q_table[new_base + 1]; };
        if(@q_table[new_base + 2] > max_next) { max_next := @q_table[new_base + 2]; };

        idx := @q_state * 3 + @q_action;
        old_q := @q_table[idx];
        @q_table[idx] := old_q + alpha * (reward + gamma * max_next - old_q);
    }

    function : EndFight() ~ Nil {
        @q_fights += 1;
        if(@q_epsilon > 0.05) {
            @q_epsilon := @q_epsilon - 0.01;
            if(@q_epsilon < 0.05) { @q_epsilon := 0.05; };
        };
    }

    # --- Theme generation ---

    function : GenerateTheme() ~ Nil {
        if(<>@is_ready) { return; };

        prompt := "Generate a dark fantasy dungeon theme. Respond in EXACTLY this format with no extra text:\nNAME: [2-4 word dungeon name]\nLORE: [one ominous sentence, max 11 words]\nTYPE: [undead or beast or infernal or arcane]\nLOOT: [weapon or magic or gold]";
        response := Completion->Generate(@model, prompt, Options->New()->SetTemperature(0.85));
        if(response = Nil) { return; };
        response := response->Trim();

        # strip DeepSeek R1 reasoning block
        think_end := response->Find("</think>");
        if(think_end >= 0) {
            after := think_end + 8;
            if(after < response->Size()) {
                response := response->SubString(after, response->Size() - after)->Trim();
            }
            else {
                return;
            };
        };

        @theme_name := ParseField(response, "NAME:");
        @theme_lore := ParseField(response, "LORE:");

        type_str := ParseField(response, "TYPE:");
        if(type_str <> Nil) {
            if(type_str->Find("ndead") >= 0) {
                @theme_archetype := DungeonAI->Archetype->UNDEAD;
            }
            else if(type_str->Find("east") >= 0) {
                @theme_archetype := DungeonAI->Archetype->BEAST;
            }
            else if(type_str->Find("nfernal") >= 0) {
                @theme_archetype := DungeonAI->Archetype->INFERNAL;
            }
            else {
                @theme_archetype := DungeonAI->Archetype->ARCANE;
            };
        };

        loot_str := ParseField(response, "LOOT:");
        if(loot_str <> Nil) {
            if(loot_str->Find("eapon") >= 0) {
                @theme_treasure := DungeonAI->Treasure->WEAPON;
            }
            else if(loot_str->Find("agic") >= 0) {
                @theme_treasure := DungeonAI->Treasure->MAGIC;
            }
            else {
                @theme_treasure := DungeonAI->Treasure->GOLD;
            };
        };

        if(@theme_name <> Nil & @theme_lore <> Nil) {
            @theme_ready := true;
        };
    }

    function : ParseField(response : String, key : String) ~ String {
        pos := response->Find(key);
        if(pos < 0) { return Nil; };
        start := pos + key->Size();
        if(start >= response->Size()) { return Nil; };
        rest := response->SubString(start, response->Size() - start);
        if(rest = Nil) { return Nil; };
        rest := rest->Trim();
        if(rest->IsEmpty()) { return Nil; };
        nl := rest->Find("\n");
        if(nl > 0) {
            return rest->SubString(0, nl)->Trim();
        };
        return rest;
    }

    function : IsThemeReady() ~ Bool {
        return @theme_ready;
    }

    function : GetThemeName() ~ String {
        return @theme_name;
    }

    function : GetThemeLore() ~ String {
        return @theme_lore;
    }

    function : GetArchetype() ~ Int {
        return @theme_archetype;
    }

    function : GetTreasure() ~ Int {
        return @theme_treasure;
    }

    function : ThemeBiasedRoll(floor : Int) ~ Int {
        if(floor = 1) {
            if(@theme_archetype = DungeonAI->Archetype->UNDEAD) {
                return Int->Random(39, 79);
            }
            else if(@theme_archetype = DungeonAI->Archetype->BEAST) {
                r := Int->Random(4);
                if(r = 0) { return Int->Random(0, 20); }
                else if(r = 1) { return Int->Random(21, 38); }
                else if(r = 2) { return Int->Random(53, 66); }
                else { return Int->Random(90, 98); };
            };
        }
        else if(floor = 2) {
            if(@theme_archetype = DungeonAI->Archetype->UNDEAD) {
                return Int->Random(0, 88);
            }
            else if(@theme_archetype = DungeonAI->Archetype->ARCANE) {
                return Int->Random(63, 76);
            };
        }
        else if(floor = 3) {
            if(@theme_archetype = DungeonAI->Archetype->UNDEAD) {
                return Int->Random(60, 70);
            }
            else if(@theme_archetype = DungeonAI->Archetype->BEAST) {
                if(Int->Random(2) = 0) { return Int->Random(0, 31); }
                else { return Int->Random(82, 91); };
            }
            else if(@theme_archetype = DungeonAI->Archetype->INFERNAL) {
                return Int->Random(32, 46);
            }
            else if(@theme_archetype = DungeonAI->Archetype->ARCANE) {
                if(Int->Random(2) = 0) { return Int->Random(47, 59); }
                else { return Int->Random(92, 98); };
            };
        }
        else {
            if(@theme_archetype = DungeonAI->Archetype->INFERNAL) {
                r := Int->Random(5);
                if(r = 0) { return Int->Random(0, 17); }
                else if(r = 1) { return Int->Random(18, 34); }
                else if(r = 2) { return Int->Random(51, 64); }
                else if(r = 3) { return Int->Random(65, 76); }
                else { return Int->Random(89, 98); };
            }
            else if(@theme_archetype = DungeonAI->Archetype->ARCANE) {
                if(Int->Random(2) = 0) { return Int->Random(35, 50); }
                else { return Int->Random(77, 88); };
            };
        };
        return Int->Random(99);
    }

    function : IsWorldReady() ~ Bool { return @world_ready; }
    function : GetWorldName()   ~ String { return @world_name   = Nil ? "World of Greyhold" : @world_name; }
    function : GetWorldThreat() ~ String { return @world_threat = Nil ? "Malachar the demon lord must be stopped." : @world_threat; }

    function : StartWorldGenAsync() ~ Nil {
        if(@world_thread <> Nil) { return; };
        @world_thread := WorldGenLoaderThread->New();
        @world_thread->Execute(Nil);
    }

    function : GenerateWorldSeed() ~ Nil {
        if(<>@is_ready) { return; };
        prompt := "Generate a dark fantasy overworld name and threat. Respond EXACTLY this format:\nWORLD: [3-5 word name]\nTHREAT: [one sentence why Malachar must be stopped, max 12 words]";
        response := Completion->Generate(@model, prompt, Options->New()->SetTemperature(0.85));
        if(response = Nil) { return; };
        think_end := response->Find("</think>");
        if(think_end >= 0) {
            after := think_end + 8;
            if(response->Size() - after > 0) { response := response->SubString(after, response->Size() - after)->Trim(); }
            else { return; };
        };
        world_idx := response->Find("WORLD:");
        if(world_idx >= 0) {
            name_start := world_idx + 6;
            remaining := response->Size() - name_start;
            if(remaining > 0) {
                name_line := response->SubString(name_start, remaining)->Trim();
                if(name_line <> Nil & <>name_line->IsEmpty()) {
                    nl := name_line->Find("\n");
                    if(nl >= 0) { name_line := name_line->SubString(0, nl)->Trim(); };
                    if(name_line->Size() > 36) { name_line := name_line->SubString(0, 33); name_line->Append("..."); };
                    @world_name := name_line;
                };
            };
        };
        if(@world_name = Nil) { @world_name := "World of Greyhold"; };
        @world_threat := ParseField(response, "THREAT:");
        @world_ready := true;
    }

    # Non-blocking: returns cached result instantly; posts to worker if not yet cached.
    # Call site should also poll GetCached(key) each render frame.
    function : MonsterBattleCry(monster_name : String, player_class : String) ~ String {
        if(<>@is_ready | @worker = Nil) { return Nil; };
        key := "cry:{$monster_name}";
        cached := AIWorker->GetCached(key);
        if(cached <> Nil) { return cached; };
        prompt := "A {$monster_name} lunges at a {$player_class} in a dark dungeon. Write ONE menacing battle cry, max 9 words. No quotes.";
        AIWorker->Post(key, prompt);
        return Nil;
    }

    # Non-blocking: returns cached result instantly; posts to worker if not yet cached.
    function : LevelUpQuip(class_name : String, level : Int) ~ String {
        if(<>@is_ready | @worker = Nil) { return Nil; };
        key := "quip:{$level}";
        cached := AIWorker->GetCached(key);
        if(cached <> Nil) { return cached; };
        prompt := "A dungeon {$class_name} just reached level {$level}. Write ONE short triumphant line, max 8 words. No quotes.";
        AIWorker->Post(key, prompt);
        return Nil;
    }

    function : VictoryEpilogue(class_name : String, kills : Int, gold : Int) ~ String {
        if(<>@is_ready) { return Nil; };
        prompt := "A {$class_name} just defeated an ancient demon lord in a dark dungeon after slaying {$kills} monsters and collecting {$gold} gold. Write a triumphant two-sentence epilogue describing their legend. No quotes.";
        response := Completion->Generate(@model, prompt, Options->New()->SetTemperature(0.85));
        if(response = Nil) { return Nil; };
        think_end := response->Find("</think>");
        if(think_end >= 0) {
            after := think_end + 8;
            if(response->Size() - after > 0) { response := response->SubString(after, response->Size() - after)->Trim(); }
            else { return Nil; };
        }
        else {
            response := response->Trim();
        };
        if(response = Nil | response->IsEmpty()) { return Nil; };
        if(response->Size() > 160) {
            response := response->SubString(0, 157);
            response->Append("...");
        };
        return response;
    }

    function : DeathEulogy(class_name : String, floor : Int, kills : Int) ~ String {
        if(<>@is_ready) { return Nil; };
        prompt := "A {$class_name} died on floor {$floor} of a dark dungeon after slaying {$kills} monsters. Write a somber one-sentence epitaph for their tomb. No quotes. Max 14 words.";
        return Clip(Completion->Generate(@model, prompt, Options->New()->SetTemperature(0.8)));
    }
}

class ThemeLoaderThread from Thread {
    New() { Parent("theme-loader"); }

    method : public : Run(data : Base) ~ Nil {
        DungeonAI->GenerateTheme();
    }
}

class WorldGenLoaderThread from Thread {
    New() { Parent("world-gen-loader"); }

    method : public : Run(data : Base) ~ Nil {
        DungeonAI->GenerateWorldSeed();
    }
}
