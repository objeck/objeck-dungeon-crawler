use Collection;
use Game.SDL2;
use Game.Framework;
use Data.JSON;
use System.IO.Filesystem;

class TinyDungeon {
	@framework : GameFramework;
	@sprite_manager : SpriteManager;
	@sound_manager : SoundManager;
	@map_manager : MapManager;

	@quit : Bool;

	@player_location : Int[];
	@player_nav_map : Int[,];
	@player_direction : MapManager->Direction;

	@dungeon_renderer : DungeonRenderer;

	@view_type : MapManager->Type;
	@view_forward_type : MapManager->Type;

	@can_preview_item : Bool;
	@can_show_item : Bool;

	@monster_sprint_index : Int;

	@monster : Monster;
	@monster_hit : Int;

	@player : Player;
	@player_hit : Int;

	@encounter_perc : Int;

	@stat_box : Rectangle;
	@stat_box_texts : TextSprite[];

	@item_box : Rectangle;
	@item_box_texts : TextSprite[];

	@text_color : Color;
	@clear_color : Color;
	@box_color : Color;
	@border_color : Color;

	# --- Animation ---
	@anim_counter : Int;
	@anim_type : Int;
	@anim_max_frames : Int;

	# --- Atmosphere ---
	@flicker_counter : Int;
	@flicker_color : Color;
	@flavor_color : Color;
	@gameover_color : Color;
	@victory_color : Color;
	@border_rects : Rectangle[];
	@compass_text : TextSprite;
	@floor_text : TextSprite;
	@flavor_texts : String[];
	@flavor_text : TextSprite;
	@flavor_timer : Int;
	@quest_text : TextSprite;

	# FPS counter (profiling; renderer cost only, not frame-capped sleep)
	@fps_text : TextSprite;
	@fps_ema : Float;
	@fps_ticks : Int;

	# --- Merchant ---
	@merchant_option : Int;

	# --- Reusable temp arrays (avoid per-frame allocations) ---
	@tri_vx : Int[];
	@tri_vy : Int[];

	# --- Plaques ---
	@plaque_texts : String[];
	@plaque_text_sprite : TextSprite;
	@plaque_timer : Int;

	# --- Game State ---
	@game_state : Int;
	@current_floor : Int;
	@max_floors : Int;
	@monsters_killed : Int;
	@boss_fight : Bool;
	@mini_boss_fight : Bool;
	@ai_text : TextSprite;
	@ai_timer : Int;
	@monster_defending : Bool;
	@boss_combat_round : Int;
	@ctrl_btn : Int;
	@controller_open : Bool;
	@controller : GameController;
	@axis_cooldown : Int;
	@hud_hint_text : TextSprite;

	# --- Combat UI ---
	@monster_name_text : TextSprite;
	@damage_text : TextSprite;
	@damage_timer : Int;
	@damage_is_player : Bool;
	@reward_text : TextSprite;
	@reward_timer : Int;
	@levelup_text : TextSprite;
	@levelup_timer : Int;

	# --- Puzzle Door State ---
	@puzzle_active : Bool;
	@puzzle_type : Int;          # 0=rune, 1=spell, 2=key
	@puzzle_sequence : Int[];    # rune door: direction sequence (0=N,1=S,2=E,3=W)
	@puzzle_seq_len : Int;
	@puzzle_input_pos : Int;     # how many correct inputs so far
	@puzzle_text : TextSprite;
	@puzzle_timer : Int;
	@puzzle_spell_element : Int; # spell door: 0=fire,1=frost,2=lightning
	@has_dungeon_key : Bool;

	# --- Combat Attack Animation ---
	@attack_anim_timer : Int;
	@attack_anim_type : Int;   # 0=none, 1=slash, 2=smite, 3=bolt, 4=cut
	@attack_anim_frame : Int;

	# --- Terminal screen texts ---
	@terminal_title : TextSprite;
	@terminal_stats : TextSprite[];
	@terminal_epilogue : TextSprite;

	# --- Title Screen ---
	@title_text : TextSprite;
	@title_sub : TextSprite;
	@title_prompt : TextSprite;
	@title_lore : TextSprite[];
	@title_char_idx : Int;
	@title_timer : Int;
	@title_has_save : Bool;
	@title_continue : TextSprite;

	# --- Class Selection ---
	@class_texts : TextSprite[];
	@class_desc : TextSprite[];
	@class_cursor : Int;
	@class_select_text : TextSprite;
	@class_inst_text : TextSprite;

	# --- Spell Menu ---
	@spell_menu_active : Bool;
	@spell_menu_cursor : Int;
	@spell_menu_title : TextSprite;
	@spell_menu_sprites : TextSprite[];
	@spell_menu_cancel : TextSprite;

	# --- Floor Entry Overlay ---
	@floor_entry_timer : Int;
	@floor_entry_name : TextSprite;
	@floor_entry_lore : TextSprite;

	# --- Async AI poll state ---
	@quip_pending    : Bool;
	@last_quip_level : Int;

	# --- Town ---
	@town_state  : Int;  # 0=menu 1=weapon 2=armor 3=healer 4=inn 5=potions
	@town_cursor : Int;
	@town_name   : String;
	@town_title  : TextSprite;
	@town_desc   : TextSprite;
	@town_opts   : TextSprite[];  # 7 options
	@town_detail_a : TextSprite;
	@town_detail_b : TextSprite;
	@town_status : TextSprite;
	@town_msg    : TextSprite;

	# --- Castle ---
	@castle_state  : Int;  # 0=menu 1=speaking
	@castle_cursor : Int;
	@castle_title  : TextSprite;
	@castle_opts   : TextSprite[];  # 3 options
	@castle_speech : TextSprite;
	@castle_speech2 : TextSprite;

	# --- Vehicles ---
	@has_boat : Bool;

	# --- Overworld ---
	@overworld_manager   : OverworldManager;
	@ow_player_r         : Int;
	@ow_player_c         : Int;
	@ow_move_cooldown    : Int;
	@came_from_overworld : Bool;
	@ow_encounter_tile   : Int;    # tile type where surface encounter started
	@ow_step_count       : Int;
	@ow_last_dr          : Int;
	@ow_last_dc          : Int;
	@ow_world_name       : String;
	@ow_encounter_banner : TextSprite;

	New() {
		@framework := GameFramework->New(Game->SCREEN_WIDTH, Game->SCREEN_HEIGHT, "Warden of Greyhold");
		@clear_color := Color->New(30, 15, 5);
		@framework->SetClearColor(@clear_color);

		# player is created during class selection
		@player := Nil;
		@encounter_perc := 15;

		@text_color := Color->New(248, 240, 227);
		MakeManagers();
		MakeTexts();
		MakeAtmosphere();
		MakeCombatUI();
		MakeTitleScreen();

		@player_location := Int->New[3];

		@monster_sprint_index := 0;

		# game state: -1=TITLE, 0=PLAYING, 1=GAME_OVER, 2=VICTORY
		@game_state := -1;
		@current_floor := 1;
		@max_floors := 4;
		@monsters_killed := 0;
		@boss_fight := false;
		@mini_boss_fight := false;

		# animation
		@anim_counter := 0;
		@anim_type := 0;
		@anim_max_frames := 12;

		# puzzle state
		@puzzle_active := false;
		@puzzle_sequence := Int->New[4];
		@puzzle_seq_len := 3;
		@puzzle_input_pos := 0;
		@puzzle_timer := 0;
		@has_dungeon_key := false;
		@attack_anim_timer := 0;
		@tri_vx := Int->New[3];
		@tri_vy := Int->New[3];
		@attack_anim_type := 0;
		@attack_anim_frame := 0;
		@ai_timer := 0;
		@boss_combat_round := 0;

	}

	method : MakeTitleScreen() ~ Nil {
		@title_text := @framework->AddTextSprite();
		@title_sub := @framework->AddTextSprite();
		@title_prompt := @framework->AddTextSprite();

		@title_lore := TextSprite->New[5];
		each(i : @title_lore) {
			@title_lore[i] := @framework->AddTextSprite();
		};

		@title_text->RenderedText("WARDEN OF GREYHOLD", Color->New(220, 180, 60));
		@title_sub->RenderedText("A Dungeon of Darkness Awaits", Color->New(160, 140, 100));
		@title_prompt->RenderedText("Press SPACE to begin", Color->New(245, 235, 200));
		@title_has_save := File->Exists("save.json");
		@title_continue := @framework->AddTextSprite();
		if(@title_has_save) {
			@title_continue->RenderedText("C to continue saved game", Color->New(200, 175, 90));
		};

		@title_lore[0]->RenderedText("The ancient evil stirs beneath the city.", Color->New(140, 120, 90));
		@title_lore[1]->RenderedText("Demons claw at the seals of binding.", Color->New(140, 120, 90));
		@title_lore[2]->RenderedText("The Order of Wardens has fallen.", Color->New(140, 120, 90));
		@title_lore[3]->RenderedText("You alone remain.", Color->New(160, 140, 100));
		@title_lore[4]->RenderedText("Descend. Survive. End this.", Color->New(180, 160, 110));

		@title_char_idx := 0;
		@title_timer := 0;

		# class selection
		@class_cursor := 0;
		@class_select_text := @framework->AddTextSprite();
		@class_select_text->RenderedText("Choose Your Class", Color->New(220, 180, 60));

		@class_inst_text := @framework->AddTextSprite();
		@class_inst_text->RenderedText("UP/DOWN to select, SPACE to confirm, ESC to go back", Color->New(120, 110, 90));

		@class_texts := TextSprite->New[4];
		@class_desc := TextSprite->New[4];
		each(i : @class_texts) {
			@class_texts[i] := @framework->AddTextSprite();
			@class_desc[i] := @framework->AddTextSprite();
		};

		@class_texts[0]->RenderedText("KNIGHT", Color->New(200, 200, 220));
		@class_desc[0]->RenderedText("High HP, strong arms, heavy armor. The stalwart shield.", Color->New(140, 130, 120));

		@class_texts[1]->RenderedText("CLERIC", Color->New(220, 220, 180));
		@class_desc[1]->RenderedText("Healing magic, holy power. The light in the dark.", Color->New(140, 130, 120));

		@class_texts[2]->RenderedText("MAGE", Color->New(180, 180, 240));
		@class_desc[2]->RenderedText("Devastating spells, vast mana. The arcane force.", Color->New(140, 130, 120));

		@class_texts[3]->RenderedText("NINJA", Color->New(200, 180, 200));
		@class_desc[3]->RenderedText("Swift strikes, deadly crits, elusive. The shadow blade.", Color->New(140, 130, 120));

		@spell_menu_title := @framework->AddTextSprite();
		@spell_menu_title->RenderedText("CHOOSE SPELL", Color->New(220, 180, 60));
		@spell_menu_sprites := TextSprite->New[7];
		each(i : @spell_menu_sprites) {
			@spell_menu_sprites[i] := @framework->AddTextSprite();
		};
		@spell_menu_cancel := @framework->AddTextSprite();
		@spell_menu_cancel->RenderedText("ESC to cancel", Color->New(110, 100, 85));

		@floor_entry_name := @framework->AddTextSprite();
		@floor_entry_lore := @framework->AddTextSprite();
		@floor_entry_timer := 0;

		@overworld_manager := OverworldManager->New(@framework, 42);
		start_pos := @overworld_manager->GetStartPos();
		@ow_player_r := start_pos[0];
		@ow_player_c := start_pos[1];
		@ow_move_cooldown := 0;
		@came_from_overworld := false;
		@ow_world_name := "World of Greyhold";
		@ow_encounter_banner := @framework->AddTextSprite();

		# Town sprites
		@town_title   := @framework->AddTextSprite();
		@town_desc    := @framework->AddTextSprite();
		@town_opts    := TextSprite->New[7];
		each(i : @town_opts)   { @town_opts[i]   := @framework->AddTextSprite(); };
		@town_detail_a := @framework->AddTextSprite();
		@town_detail_b := @framework->AddTextSprite();
		@town_status  := @framework->AddTextSprite();
		@town_msg     := @framework->AddTextSprite();

		# Castle sprites
		@castle_title  := @framework->AddTextSprite();
		@castle_opts   := TextSprite->New[3];
		each(i : @castle_opts) { @castle_opts[i] := @framework->AddTextSprite(); };
		@castle_speech  := @framework->AddTextSprite();
		@castle_speech2 := @framework->AddTextSprite();
	}

	function : Main(args : String[]) ~ Nil {
		TinyDungeon->New()->Run();
	}

	method : Run() ~ Nil {
		if(<>@map_manager->Load()) {
			"--- Unable to load maps! ---"->ErrorLine();
			return;
		};

		if(<>@sprite_manager->Load()) {
			"--- Unable to load sprites! ---"->ErrorLine();
			return;
		};

		if(<>@sound_manager->Load()) {
			"--- Unable to load sounds! ---"->ErrorLine();
			return;
		};

		ai_model := DungeonAI->InitModel();
		if(ai_model <> Nil) {
			"[AI] Connected: {$ai_model}"->ErrorLine();
			DungeonAI->StartThemeAsync();
			if(Joystick->Number() > 0 & GameController->IsController(0)) {
				@controller_open := true;
				@controller := GameController->New(0);
				"[Controller] Gamepad detected"->ErrorLine();
			};
		}
		else {
			"[AI] Ollama not available - AI features disabled"->ErrorLine();
		};

		leaving {
			@map_manager->Unload();
			@sprite_manager->Unload();
			@sound_manager->Unload();
		};

		if(@framework->IsOk()) {
			@dungeon_renderer := DungeonRenderer->New(@framework->GetRenderer());

			frame_count := 0;
			@quit := false;

			e := @framework->GetEvent();
			while(<>@quit) {
				@framework->FrameStart();

				# process input
				while(e->Poll() <> 0) {
					# quit
					if(e->GetType() = EventType->SDL_QUIT) {
						@quit := true;
					}
					# keyboard
					else if(e->GetType() = EventType->SDL_KEYDOWN & e->GetKey()->GetRepeat() = 0) {
				        GetInput(e);
				    }
					# controller buttons
					else if(e->GetType() = EventType->SDL_CONTROLLERBUTTONDOWN & @controller_open) {
						GetControllerInput(e);
					};
				};

				PollController();

				render_start := Timer->GetTicks();
				Render(frame_count);
				render_ms := Timer->GetTicks() - render_start;

				# EMA-smoothed implied fps (render cost only; inverse of ms)
				inst_fps := 1000.0;
				if(render_ms > 0) {
					inst_fps := 1000.0 / render_ms->As(Float);
				};
				if(@fps_ema = 0.0) {
					@fps_ema := inst_fps;
				}
				else {
					@fps_ema := @fps_ema * 0.9 + inst_fps * 0.1;
				};
				@fps_ticks += 1;
				if(@fps_ticks >= 15) {
					@fps_ticks := 0;
					fps_int := @fps_ema->As(Int);
					fps_label := "{$fps_int} fps ({$render_ms}ms)";
					@fps_text->RenderedText(fps_label, Color->New(120, 180, 120));
				};

				@framework->FrameEnd();

				frame_count += 1;
				if(frame_count >= @framework->GetFps()) {
					frame_count := 0;
				};
			};
		}
		else {
			"--- Error Initializing Environment ---"->ErrorLine();
			return;
		};
	}

	method : MakeManagers() ~ Nil {
		@sprite_manager := SpriteManager->New("./images", @framework);
		@sound_manager := SoundManager->New("./sounds", @framework);
		@map_manager := MapManager->New("./maps");
	}

	method : MakeTexts() ~ Nil {
		@box_color := Color->New(78,53,36);

		# make stat box
		@stat_box := @framework->AddRectangle(400, 165);
		@stat_box->SetFill(true);
		@stat_box->SetColor(@box_color);

		@stat_box_texts := TextSprite->New[7];
		each(i : @stat_box_texts) {
			@stat_box_texts[i] := @framework->AddTextSprite();
		};
		RefreshStats();

		# make item box
		@item_box := @framework->AddRectangle(305, 165);
		@item_box->SetFill(true);
		@item_box->SetColor(@box_color);

		@item_box_texts := TextSprite->New[5];
		each(i : @item_box_texts) {
			@item_box_texts[i] := @framework->AddTextSprite();
		};
		RefreshItems();

		# terminal screen texts
		@terminal_title := @framework->AddTextSprite();
		@terminal_epilogue := @framework->AddTextSprite();
		@terminal_stats := TextSprite->New[7];
		each(i : @terminal_stats) {
			@terminal_stats[i] := @framework->AddTextSprite();
		};
	}

	method : MakeAtmosphere() ~ Nil {
		# reusable colors (avoid GC collecting while framework references them)
		@flicker_color := Color->New(30, 15, 5);
		@flavor_color := Color->New(160, 140, 100);
		@gameover_color := Color->New(40, 5, 5);
		@victory_color := Color->New(40, 35, 5);

		# border rectangles (top, bottom, left, right)
		@border_color := Color->New(45, 25, 10);
		@border_rects := Rectangle->New[4];
		each(i : @border_rects) {
			@border_rects[i] := @framework->AddRectangle(1, 1);
			@border_rects[i]->SetFill(true);
			@border_rects[i]->SetColor(@border_color);
		};

		# compass
		@compass_text := @framework->AddTextSprite();
		@compass_text->RenderedText("N", Color->New(220, 200, 140));

		# floor indicator
		@floor_text := @framework->AddTextSprite();
		@floor_text->RenderedText("Floor 1", Color->New(220, 200, 140));

		# FPS counter (renderer budget, not frame-cap)
		@fps_text := @framework->AddTextSprite();
		@fps_text->RenderedText("-- fps", Color->New(120, 180, 120));
		@fps_ema := 0.0;

		# flavor texts
		@flavor_texts := String->New[12];
		@flavor_texts[0] := "You hear dripping water...";
		@flavor_texts[1] := "A cold wind blows...";
		@flavor_texts[2] := "Shadows dance on the walls...";
		@flavor_texts[3] := "The air smells of decay...";
		@flavor_texts[4] := "Distant footsteps echo...";
		@flavor_texts[5] := "Torchlight flickers ominously...";
		@flavor_texts[6] := "A faint growl in the dark...";
		@flavor_texts[7] := "Stones crumble underfoot...";
		@flavor_texts[8] := "Strange runes glow ahead...";
		@flavor_texts[9] := "Spores drift in the stale air...";
		@flavor_texts[10] := "Something moves in the chest...";
		@flavor_texts[11] := "A sealed door blocks the way...";

		@flavor_text := @framework->AddTextSprite();
		@flavor_text->RenderedText(@flavor_texts[0], Color->New(160, 140, 100));
		@flavor_timer := 0;

		# quest objective
		@quest_text := @framework->AddTextSprite();
		@quest_text->RenderedText("Find the ladder down to Floor 2", Color->New(180, 170, 130));

		# wall plaque messages
		@plaque_texts := String->New[24];
		@plaque_texts[0] := "The Warden Order fell in the Third Age.";
		@plaque_texts[1] := "Search the walls. Not all stone is solid.";
		@plaque_texts[2] := "Fire melts ice. Frost quenches flame.";
		@plaque_texts[3] := "The deeper you go, the darker it gets.";
		@plaque_texts[4] := "Tents restore body and spirit alike.";
		@plaque_texts[5] := "Beware the chest that bites back.";
		@plaque_texts[6] := "A merchant lurks in these halls.";
		@plaque_texts[7] := "Cursed steel cuts deep but poisons the soul.";
		@plaque_texts[8] := "The runes speak to those who listen.";
		@plaque_texts[9] := "Remember the sequence. Forget and bleed.";
		@plaque_texts[10] := "Champions guard the treasures of old.";
		@plaque_texts[11] := "Malachar waits below. Are you ready?";
		@plaque_texts[12] := "Here lie the bones of the 4th Warden.";
		@plaque_texts[13] := "The eyes see all. Close yours.";
		@plaque_texts[14] := "Stone does not breathe. Stone does not die.";
		@plaque_texts[15] := "Fungi thrive where the dead decay.";
		@plaque_texts[16] := "The knight strikes hard. The ninja strikes true.";
		@plaque_texts[17] := "Pray at altars. Rest at camps.";
		@plaque_texts[18] := "Gold buys safety. Courage buys glory.";
		@plaque_texts[19] := "Three fell to poison. One fell to pride.";
		@plaque_texts[20] := "The seal requires the right element.";
		@plaque_texts[21] := "Every step deeper brings new horrors.";
		@plaque_texts[22] := "Keys open what force cannot.";
		@plaque_texts[23] := "Turn back. Or don't. It matters not.";
		@plaque_text_sprite := @framework->AddTextSprite();
		@plaque_timer := 0;
	}

	method : MakeCombatUI() ~ Nil {
		@monster_name_text := @framework->AddTextSprite();
		@damage_text := @framework->AddTextSprite();
		@damage_timer := 0;
		@damage_is_player := false;
		@reward_text := @framework->AddTextSprite();
		@reward_timer := 0;
		@levelup_text := @framework->AddTextSprite();
		@levelup_timer := 0;
		@puzzle_text := @framework->AddTextSprite();
		@ai_text := @framework->AddTextSprite();
		@hud_hint_text := @framework->AddTextSprite();
	}

	method : RefreshStats() ~ Nil {
		if(@player = Nil) { return; };
		# health, armor and hp
		player_health := @player->GetHealth() = Nil ? "None" : @player->GetHealth()->ToString();
		player_weapon := @player->GetWeapon() = Nil ? "None" : @player->GetWeapon()->ToString();
		player_armor := @player->GetArmor() = Nil ? "None" : @player->GetArmor()->ToString();
		player_hp := @player->GetHp();
		player_max_hp := @player->GetMaxHp();
		player_level := @player->GetLevel();
		player_xp := @player->GetXP();

		# spells
		player_spell1 := @player->GetSpell(0) = Nil ? "None" : @player->GetSpell(0)->ToString();
		player_spell2 := @player->GetSpell(1) = Nil ? "None" : @player->GetSpell(1)->ToString();

		stat_box_copy := [
			"Lv:{$player_level} HP:{$player_hp}/{$player_max_hp}",
			"XP: {$player_xp}",
			"Condition: {$player_health}",
			"{$player_weapon}, {$player_armor}",
			"Spells",
			"  1: {$player_spell1}",
			"  2: {$player_spell2}"];

		if(stat_box_copy->Size() <> @stat_box_texts->Size()) {
			"--- Stat box copy mismatch ---"->ErrorLine();
			Runtime->Exit(1);
		};

		each(i :@stat_box_texts) {
			@stat_box_texts[i]->RenderedText(stat_box_copy[i], @text_color);
		};
	}

	method : RefreshItems() ~ Nil {
		if(@player = Nil) { return; };
		# potions
		potion1_text : String;
		player_potion1 := @player->GetPotion1();
		if(player_potion1 <> Nil & @player->GetPotion1()->GetCount() > 0) {
			 potion_desc := @player->GetPotion1()->ToString();
			 potion_count := @player->GetPotion1()->GetCount();
			 potion1_text := "{$potion_desc} x {$potion_count}";
		}
		else {
			potion1_text := "None";
		};

		potion2_text : String;
		player_potion2 := @player->GetPotion2();
		if(player_potion2 <> Nil & player_potion2->GetCount() > 0) {
			 potion_desc := player_potion2->ToString();
			 potion_count := player_potion2->GetCount();
			 potion2_text := "{$potion_desc} x {$potion_count}";
		}
		else {
			potion2_text := "None";
		};

		potion3_text : String;
		player_potion3 := @player->GetPotion3();
		if(player_potion3 <> Nil & player_potion3->GetCount() > 0) {
			 potion_desc := player_potion3->ToString();
			 potion_count := player_potion3->GetCount();
			 potion3_text := "{$potion_desc} x {$potion_count}";
		}
		else {
			potion3_text := "None";
		};

		# gold and tents
		player_gold_text := @player->GetGold();
		player_tent_text := @player->GetTents();

		item_box_copy := [
			"Gold={$player_gold_text}, Tent x {$player_tent_text}",
			"Potions",
			"  A: {$potion1_text}",
			"  B: {$potion2_text}",
			"  C: {$potion3_text}"];

		if(item_box_copy->Size() <> @item_box_texts->Size()) {
			"--- Item box copy mismatch ---"->ErrorLine();
			Runtime->Exit(1);
		};

		each(i : @item_box_texts) {
			@item_box_texts[i]->RenderedText(item_box_copy[i], @text_color);
		};
	}

	method : UpdateCompass() ~ Nil {
		dir_str : String;
		select(@player_direction) {
			label MapManager->Direction->NORTH {
				dir_str := "N";
			}
			label MapManager->Direction->SOUTH {
				dir_str := "S";
			}
			label MapManager->Direction->EAST {
				dir_str := "E";
			}
			label MapManager->Direction->WEST {
				dir_str := "W";
			}
		};
		@compass_text->RenderedText(dir_str, Color->New(220, 200, 140));
	}

	method : UpdateFloorText() ~ Nil {
		floor_str := "Floor {$@current_floor}";
		@floor_text->RenderedText(floor_str, Color->New(220, 200, 140));
	}

	method : UpdateQuestText() ~ Nil {
		quest_str : String;
		if(@current_floor < @max_floors) {
			next_floor := @current_floor + 1;
			quest_str := "Find the ladder down to Floor {$next_floor}";
		}
		else {
			quest_str := "Defeat the Dungeon Lord!";
		};
		@quest_text->RenderedText(quest_str, Color->New(180, 170, 130));
	}

	method : OverworldCheckEvent() ~ Nil {
		evt := @overworld_manager->GetEvent(@ow_player_r, @ow_player_c);
		if(evt = OverworldEvent->DUNGEON) {
			# descend into Greyhold — NOT a surface encounter; player stays underground
			@came_from_overworld := false;
			@game_state := 0;
			@current_floor := 1;
			StartLevel(0);
			return;
		};
		if(evt = OverworldEvent->TOWN) {
			EnterTown();
			return;
		};
		if(evt = OverworldEvent->CASTLE) {
			EnterCastle();
			return;
		};

		# random encounter on GRASS/FOREST
		tile := @overworld_manager->GetTile(@ow_player_r, @ow_player_c);
		rate := 0;
		if(tile = OverworldTile->FOREST) { rate := 18; }
		else if(tile = OverworldTile->GRASS) { rate := 7; };
		if(rate > 0 & @monster = Nil & Int->Random(99) < rate) {
			@came_from_overworld := true;
			@current_floor := 1;
			StartLevel(0);        # initializes player_location, nav_map, view state
			@game_state := 0;     # switch to dungeon render AFTER state is ready
			SpawnOverworldEncounter();
		};
	}

	method : SpawnOverworldEncounter() ~ Nil {
		fl := 1;
		roll := Int->Random(99);
		@ow_encounter_tile := @overworld_manager->GetTile(@ow_player_r, @ow_player_c);

		if(@ow_encounter_tile = OverworldTile->FOREST) {
			# Forest: larger predators, humanoid raiders, giant arachnids
			if(roll < 20)      { @monster := Monster->CreateByFloor("Giant Spider",   fl, 9,  10, 14, 5,  28.0, 9.0,  12, false); @monster_sprint_index := MonsterID->SPIDER; }
			else if(roll < 38) { @monster := Monster->CreateByFloor("Dire Wolf",      fl, 11, 13, 12, 7,  32.0, 10.0, 15, false); @monster_sprint_index := MonsterID->HELLHOUND; }
			else if(roll < 55) { @monster := Monster->CreateByFloor("Forest Troll",   fl, 18, 14, 6,  12, 36.0, 18.0, 22, false); @monster_sprint_index := MonsterID->TROLL; }
			else if(roll < 70) { @monster := Monster->CreateByFloor("Bandit Archer",  fl, 8,  11, 12, 6,  30.0, 11.0, 14, false); @monster_sprint_index := MonsterID->SHADOW; }
			else if(roll < 83) { @monster := Monster->CreateByFloor("Kobold Shaman",  fl, 7,  9,  13, 5,  26.0, 8.0,  13, false); @monster_sprint_index := MonsterID->KOBOLD; }
			else               { @monster := Monster->CreateByFloor("Werewolf",       fl, 14, 15, 12, 9,  40.0, 16.0, 25, false); @monster_sprint_index := MonsterID->WEREWOLF; };
		}
		else {
			# Grassland: small pests, brigands, scouts
			if(roll < 22)      { @monster := Monster->CreateByFloor("Wild Rat",      fl, 7,  11, 10, 4,  26.0, 8.0,  11, false); @monster_sprint_index := MonsterID->RAT; }
			else if(roll < 42) { @monster := Monster->CreateByFloor("Giant Bat",     fl, 6,  9,  14, 4,  24.0, 7.0,  10, false); @monster_sprint_index := MonsterID->BAT; }
			else if(roll < 58) { @monster := Monster->CreateByFloor("Kobold Scout",  fl, 6,  8,  14, 4,  22.0, 7.0,  11, false); @monster_sprint_index := MonsterID->KOBOLD; }
			else if(roll < 72) { @monster := Monster->CreateByFloor("Highwayman",    fl, 9,  12, 10, 7,  30.0, 12.0, 14, false); @monster_sprint_index := MonsterID->DARK_KNIGHT; }
			else if(roll < 85) { @monster := Monster->CreateByFloor("Road Bandit",   fl, 8,  11, 9,  6,  28.0, 10.0, 13, false); @monster_sprint_index := MonsterID->ZOMBIE; }
			else               { @monster := Monster->CreateByFloor("Giant Spider",  fl, 8,  9,  13, 5,  26.0, 9.0,  12, false); @monster_sprint_index := MonsterID->SPIDER; };
		};
		monster_name := @monster->GetName();
		@monster_name_text->RenderedText(monster_name, Color->New(255, 200, 200));
		@quip_pending := false;   # battle cry takes AI display priority
		if(DungeonAI->IsReady() & @ai_timer = 0) {
			# Always try — MonsterBattleCry returns cached instantly or posts and returns Nil
			cry := DungeonAI->MonsterBattleCry(monster_name, GetPlayerClassName());
			if(cry <> Nil) {
				@ai_text->RenderedText(cry, Color->New(255, 140, 100));
				@ai_timer := 120;
			};
			# Otherwise poll loop in Render() will display it when the worker responds
		};
	}

	# ================================================================
	# TOWN (game_state = 4)
	# ================================================================

	method : EnterTown() ~ Nil {
		if(@player = Nil) { return; };
		@game_state  := 4;
		@town_state  := 0;
		@town_cursor := 0;
		wn := DungeonAI->IsWorldReady() ? DungeonAI->GetWorldName() : "A Wayward Town";
		@town_name := wn;
		@town_title->RenderedText("— {$wn} —", Color->New(220, 180, 60));
		@town_desc->RenderedText("Torchlight and the smell of ale greet you.", Color->New(160, 140, 100));
		# Pre-warm AI messages for this town
		if(DungeonAI->IsReady()) {
			DungeonAI->PostTownMessages(GetPlayerClassName(), wn);
		};
		RefreshTownOpts();
	}

	method : RefreshTownOpts() ~ Nil {
		if(@player = Nil) { return; };
		gold := @player->GetGold();
		wpn_tier : Int; arm_tier : Int;
		if(@player->GetWeapon() <> Nil) { wpn_tier := @player->GetWeapon()->GetTier(); } else { wpn_tier := 0; };
		if(@player->GetArmor()  <> Nil) { arm_tier := @player->GetArmor()->GetTier(); }  else { arm_tier := 0; };
		heal_cost := @player->GetMaxHp() - @player->GetHp();
		if(heal_cost < 0) { heal_cost := 0; };
		heal_cost := heal_cost * 2;
		if(heal_cost < 10) { heal_cost := 10; };

		opts_text := String->New[7];
		opts_text[0] := "1. Weapon Shop";
		opts_text[1] := "2. Armor Shop";
		opts_text[2] := "3. Healer       ({$heal_cost}g)";
		opts_text[3] := "4. Inn          (30g)";
		opts_text[4] := "5. Potions      (10g each)";
		if(@has_boat) { opts_text[5] := "6. Boat         (owned)"; }
		else          { opts_text[5] := "6. Buy Boat     (200g)"; };
		opts_text[6] := "7. Leave town";

		for(i := 0; i < 7; i += 1;) {
			sel := i = @town_cursor;
			if(sel) { @town_opts[i]->RenderedText(opts_text[i], Color->New(255, 220, 80)); }
			else    { @town_opts[i]->RenderedText(opts_text[i], Color->New(200, 185, 155)); };
		};

		g_str := "Gold: {$gold}   HP: {$@player->GetHp()}/{$@player->GetMaxHp()}   MP: {$@player->GetMp()}/{$@player->GetMaxMp()}";
		@town_status->RenderedText(g_str, Color->New(140, 200, 130));
	}

	method : HandleTownInput(code : Int) ~ Nil {
		if(@town_state = 0) {
			# Main menu navigation
			if(code = Scancode->SDL_SCANCODE_UP | code = Scancode->SDL_SCANCODE_W) {
				@town_cursor -= 1;
				if(@town_cursor < 0) { @town_cursor := 6; };
				RefreshTownOpts();
			}
			else if(code = Scancode->SDL_SCANCODE_DOWN | code = Scancode->SDL_SCANCODE_S) {
				@town_cursor += 1;
				if(@town_cursor > 6) { @town_cursor := 0; };
				RefreshTownOpts();
			}
			else if(code = Scancode->SDL_SCANCODE_SPACE | code = Scancode->SDL_SCANCODE_RETURN |
			        code = Scancode->SDL_SCANCODE_1 | code = Scancode->SDL_SCANCODE_2 |
			        code = Scancode->SDL_SCANCODE_3 | code = Scancode->SDL_SCANCODE_4 |
			        code = Scancode->SDL_SCANCODE_5 | code = Scancode->SDL_SCANCODE_6 |
			        code = Scancode->SDL_SCANCODE_7) {
				sel := @town_cursor;
				if(code = Scancode->SDL_SCANCODE_1) { sel := 0; }
				else if(code = Scancode->SDL_SCANCODE_2) { sel := 1; }
				else if(code = Scancode->SDL_SCANCODE_3) { sel := 2; }
				else if(code = Scancode->SDL_SCANCODE_4) { sel := 3; }
				else if(code = Scancode->SDL_SCANCODE_5) { sel := 4; }
				else if(code = Scancode->SDL_SCANCODE_6) { sel := 5; }
				else if(code = Scancode->SDL_SCANCODE_7) { sel := 6; };
				TownSelect(sel);
			}
			else if(code = Scancode->SDL_SCANCODE_ESCAPE) {
				@game_state := 3;
			};
		}
		else {
			# Sub-screen: any key returns to main menu
			if(code = Scancode->SDL_SCANCODE_ESCAPE | code = Scancode->SDL_SCANCODE_SPACE |
			   code = Scancode->SDL_SCANCODE_RETURN | code = Scancode->SDL_SCANCODE_BACKSPACE) {
				@town_state := 0;
				@town_msg->RenderedText("", Color->New(0, 0, 0));
				RefreshTownOpts();
			};
		};
	}

	method : TownSelect(sel : Int) ~ Nil {
		if(@player = Nil) { return; };
		select(sel) {
			label 0 { TownWeaponShop(); }
			label 1 { TownArmorShop(); }
			label 2 { TownHeal(); }
			label 3 { TownInn(); }
			label 4 { TownPotions(); }
			label 5 { TownBuyBoat(); }
			label 6 { @game_state := 3; }
		};
	}

	method : TownWeaponShop() ~ Nil {
		@town_state := 1;
		wpn := @player->GetWeapon();
		tier := wpn <> Nil ? wpn->GetTier() : 0;
		curr_name := wpn <> Nil ? wpn->ToString() : "Fists";
		next_tier := tier + 1;
		if(next_tier > 7) {
			@town_detail_a->RenderedText("You wield the finest weapon!", Color->New(255, 220, 80));
			@town_detail_b->RenderedText("", Color->New(0, 0, 0));
			@town_msg->RenderedText("Current: {$curr_name}", Color->New(200, 185, 155));
			return;
		};
		next_wpn := TieredWeapon->Create(next_tier);
		price := 50 + tier * 30;
		next_name := next_wpn->ToString();
		@town_detail_a->RenderedText("Current: {$curr_name}", Color->New(180, 165, 135));
		@town_detail_b->RenderedText("Upgrade: {$next_name}  —  {$price} gold", Color->New(255, 220, 80));
		if(@player->GetGold() >= price) {
			@player->AddGold(-price);
			@player->SetWeapon(next_wpn);
			@town_msg->RenderedText("Purchased! You now wield the {$next_name}.", Color->New(100, 220, 100));
			RefreshTownOpts();
		}
		else {
			@town_msg->RenderedText("Not enough gold. Need {$price}g.", Color->New(255, 100, 80));
		};
		shop_greet := DungeonAI->GetTownMsg("shop_greet");
		if(shop_greet <> Nil) {
			@town_desc->RenderedText(shop_greet, Color->New(200, 180, 120));
		};
	}

	method : TownArmorShop() ~ Nil {
		@town_state := 2;
		arm := @player->GetArmor();
		tier := arm <> Nil ? arm->GetTier() : 0;
		curr_name := arm <> Nil ? arm->ToString() : "Rags";
		next_tier := tier + 1;
		if(next_tier > 7) {
			@town_detail_a->RenderedText("You wear the finest armor!", Color->New(255, 220, 80));
			@town_detail_b->RenderedText("", Color->New(0, 0, 0));
			@town_msg->RenderedText("Current: {$curr_name}", Color->New(200, 185, 155));
			return;
		};
		next_arm := TieredArmor->Create(next_tier);
		price := 40 + tier * 25;
		next_name := next_arm->ToString();
		@town_detail_a->RenderedText("Current: {$curr_name}", Color->New(180, 165, 135));
		@town_detail_b->RenderedText("Upgrade: {$next_name}  —  {$price} gold", Color->New(255, 220, 80));
		if(@player->GetGold() >= price) {
			@player->AddGold(-price);
			@player->SetArmor(next_arm);
			@town_msg->RenderedText("Equipped! You now wear the {$next_name}.", Color->New(100, 220, 100));
			RefreshTownOpts();
		}
		else {
			@town_msg->RenderedText("Not enough gold. Need {$price}g.", Color->New(255, 100, 80));
		};
	}

	method : TownHeal() ~ Nil {
		@town_state := 3;
		heal_cost := @player->GetMaxHp() - @player->GetHp();
		if(heal_cost < 0) { heal_cost := 0; };
		heal_cost := heal_cost * 2;
		if(heal_cost < 10) { heal_cost := 10; };
		healer_msg := DungeonAI->GetTownMsg("healer_greet");
		if(healer_msg <> Nil) {
			@town_desc->RenderedText(healer_msg, Color->New(180, 220, 160));
		};
		if(@player->GetHp() = @player->GetMaxHp() & @player->GetMp() = @player->GetMaxMp()) {
			@town_detail_a->RenderedText("You are already fully healed.", Color->New(100, 220, 100));
			@town_detail_b->RenderedText("", Color->New(0, 0, 0));
			@town_msg->RenderedText("The healer smiles and waves you on.", Color->New(180, 165, 135));
			return;
		};
		@town_detail_a->RenderedText("Restore HP and MP to full?", Color->New(200, 185, 155));
		@town_detail_b->RenderedText("Cost: {$heal_cost} gold", Color->New(255, 220, 80));
		if(@player->GetGold() >= heal_cost) {
			@player->AddGold(-heal_cost);
			@player->SetHpDirect(@player->GetMaxHp(), @player->GetMaxHp());
			@player->SetMpDirect(@player->GetMaxMp(), @player->GetMaxMp());
			@player->SetStatusDirect(0, 0, 0, 0, 0, false, false);
			@town_msg->RenderedText("Healed! You feel restored.", Color->New(100, 220, 100));
			RefreshTownOpts();
		}
		else {
			@town_msg->RenderedText("Not enough gold. Need {$heal_cost}g.", Color->New(255, 100, 80));
		};
	}

	method : TownInn() ~ Nil {
		@town_state := 4;
		inn_cost := 30;
		@town_detail_a->RenderedText("Rest at the inn? Restores everything.", Color->New(200, 185, 155));
		@town_detail_b->RenderedText("Cost: {$inn_cost} gold", Color->New(255, 220, 80));
		if(@player->GetGold() >= inn_cost) {
			@player->AddGold(-inn_cost);
			@player->SetHpDirect(@player->GetMaxHp(), @player->GetMaxHp());
			@player->SetMpDirect(@player->GetMaxMp(), @player->GetMaxMp());
			@player->SetStatusDirect(0, 0, 0, 0, 0, false, false);
			inn_msg := DungeonAI->GetTownMsg("inn_rest");
			if(inn_msg <> Nil) {
				@town_msg->RenderedText(inn_msg, Color->New(200, 190, 140));
			}
			else {
				@town_msg->RenderedText("You sleep soundly and wake refreshed.", Color->New(200, 190, 140));
			};
			RefreshTownOpts();
		}
		else {
			@town_msg->RenderedText("Not enough gold. Need {$inn_cost}g.", Color->New(255, 100, 80));
		};
	}

	method : TownPotions() ~ Nil {
		@town_state := 5;
		potion_cost := 10;
		@town_detail_a->RenderedText("Buy a health potion?  10 gold each.", Color->New(200, 185, 155));
		@town_detail_b->RenderedText("", Color->New(0, 0, 0));
		if(@player->GetGold() >= potion_cost) {
			@player->AddGold(-potion_cost);
			@player->AddPotion(Potion->Type->WEAK_HEALTH, 1);
			@town_msg->RenderedText("Purchased a health potion!", Color->New(100, 220, 100));
			RefreshTownOpts();
		}
		else {
			@town_msg->RenderedText("Not enough gold. Need 10g.", Color->New(255, 100, 80));
		};
	}

	method : TownBuyBoat() ~ Nil {
		@town_state := 6;
		if(@has_boat) {
			@town_detail_a->RenderedText("You already own a boat.", Color->New(100, 180, 255));
			@town_detail_b->RenderedText("Sail the shallow seas freely.", Color->New(160, 145, 120));
			@town_msg->RenderedText("", Color->New(0, 0, 0));
			return;
		};
		boat_cost := 200;
		@town_detail_a->RenderedText("Buy a sailing boat?  200 gold.", Color->New(200, 185, 155));
		@town_detail_b->RenderedText("Allows travel on shallow seas.", Color->New(160, 145, 120));
		if(@player->GetGold() >= boat_cost) {
			@player->AddGold(-boat_cost);
			@has_boat := true;
			@town_msg->RenderedText("Purchased! A sturdy boat is yours.", Color->New(100, 220, 255));
			RefreshTownOpts();
		}
		else {
			@town_msg->RenderedText("Not enough gold. Need 200g.", Color->New(255, 100, 80));
		};
	}

	method : RenderTown(frame : Int) ~ Nil {
		renderer := @framework->GetRenderer();
		@framework->SetClearColor(Color->New(12, 8, 4));
		@framework->Clear();

		# Background — warm tavern atmosphere
		renderer->BoxColor(0, 0, 768, 512, Color->New(18, 12, 6));
		# Wooden beam texture hints
		for(bx := 0; bx < 768; bx += 80;) {
			renderer->VlineColor(bx, 0, 512, Color->New(28, 18, 8));
		};

		# Left panel: town name + menu
		renderer->BoxColor(10, 10, 360, 502, Color->New(25, 18, 10, 200));
		renderer->RectangleColor(10, 10, 360, 502, Color->New(100, 70, 30));
		renderer->RectangleColor(13, 13, 357, 499, Color->New(60, 40, 18));

		# Town name
		tw := @town_title->GetWidth();
		@town_title->Render(185 - tw / 2, 24);
		renderer->HLineColor(20, 350, 48, Color->New(80, 55, 22));

		# Atmospheric description
		dw := @town_desc->GetWidth();
		@town_desc->Render(185 - dw / 2, 56);
		renderer->HLineColor(20, 350, 76, Color->New(60, 40, 15));

		# Menu options
		for(i := 0; i < 7; i += 1;) {
			oy := 90 + i * 48;
			if(i = @town_cursor & @town_state = 0) {
				renderer->BoxColor(18, oy - 4, 352, oy + 34, Color->New(55, 35, 12, 180));
				renderer->RectangleColor(18, oy - 4, 352, oy + 34, Color->New(140, 100, 40));
			};
			@town_opts[i]->Render(30, oy + 4);
		};

		# Right panel: detail / shop info
		renderer->BoxColor(375, 10, 758, 430, Color->New(20, 15, 8, 200));
		renderer->RectangleColor(375, 10, 758, 430, Color->New(90, 60, 25));
		renderer->RectangleColor(378, 13, 755, 427, Color->New(55, 38, 15));

		# Shop detail
		if(@town_state > 0) {
			renderer->HLineColor(385, 748, 45, Color->New(70, 48, 18));
			@town_detail_a->Render(390, 18);
			@town_detail_b->Render(390, 55);
			# AI message
			mw := @town_msg->GetWidth();
			if(mw > 0) {
				renderer->HLineColor(385, 748, 200, Color->New(70, 48, 18));
				@town_msg->Render(390, 215);
			};
		}
		else {
			# tavern rumor when on main menu
			rum := DungeonAI->GetTownMsg("tavern_rumor");
			if(rum <> Nil) {
				@town_desc->RenderedText(rum, Color->New(160, 140, 100));
			};
		};

		# Bottom strip
		renderer->BoxColor(0, 440, 768, 512, Color->New(15, 10, 5));
		renderer->HLineColor(0, 768, 440, Color->New(80, 55, 22));
		@town_status->Render(10, 450);
		hint_str := "ESC=leave  UP/DOWN=navigate  SPACE=select  1-7=shortcut";
		@town_msg->RenderedText(hint_str, Color->New(100, 85, 60));

		# Torch flicker
		flk := (Float->Sin(frame->As(Float) * 0.15) * 8.0)->As(Int);
		fa := 18 + flk;
		renderer->FilledCircleColor(35, 35, 22, Color->New(255, 160, 50, fa));
		renderer->FilledCircleColor(335, 35, 22, Color->New(255, 160, 50, fa));

		@framework->Show();
	}

	# ================================================================
	# CASTLE (game_state = 5)
	# ================================================================

	method : EnterCastle() ~ Nil {
		if(@player = Nil) { return; };
		@game_state    := 5;
		@castle_state  := 0;
		@castle_cursor := 0;
		wn := DungeonAI->IsWorldReady() ? DungeonAI->GetWorldName() : "Castle Ironhold";
		@castle_title->RenderedText("— Castle of {$wn} —", Color->New(200, 185, 100));
		if(DungeonAI->IsReady()) {
			threat := DungeonAI->GetWorldThreat();
			DungeonAI->PostCastleMessages(GetPlayerClassName(), threat);
		};
		RefreshCastleOpts();
	}

	method : RefreshCastleOpts() ~ Nil {
		opts := String->New[3];
		opts[0] := "1. Speak with the Lord";
		opts[1] := @has_boat ? "2. Boat (owned)" : "2. Gift a Boat  (quest reward)";
		opts[2] := "3. Leave castle";
		for(i := 0; i < 3; i += 1;) {
			if(i = @castle_cursor) { @castle_opts[i]->RenderedText(opts[i], Color->New(255, 220, 80)); }
			else                   { @castle_opts[i]->RenderedText(opts[i], Color->New(200, 185, 155)); };
		};
	}

	method : HandleCastleInput(code : Int) ~ Nil {
		if(code = Scancode->SDL_SCANCODE_UP | code = Scancode->SDL_SCANCODE_W) {
			@castle_cursor -= 1;
			if(@castle_cursor < 0) { @castle_cursor := 2; };
			RefreshCastleOpts();
		}
		else if(code = Scancode->SDL_SCANCODE_DOWN | code = Scancode->SDL_SCANCODE_S) {
			@castle_cursor += 1;
			if(@castle_cursor > 2) { @castle_cursor := 0; };
			RefreshCastleOpts();
		}
		else if(code = Scancode->SDL_SCANCODE_SPACE | code = Scancode->SDL_SCANCODE_RETURN |
		        code = Scancode->SDL_SCANCODE_1 | code = Scancode->SDL_SCANCODE_2 | code = Scancode->SDL_SCANCODE_3) {
			sel := @castle_cursor;
			if(code = Scancode->SDL_SCANCODE_1) { sel := 0; }
			else if(code = Scancode->SDL_SCANCODE_2) { sel := 1; }
			else if(code = Scancode->SDL_SCANCODE_3) { sel := 2; };
			CastleSelect(sel);
		}
		else if(code = Scancode->SDL_SCANCODE_ESCAPE) {
			@game_state := 3;
		};
	}

	method : CastleSelect(sel : Int) ~ Nil {
		select(sel) {
			label 0 { CastleSpeakLord(); }
			label 1 { CastleGiftBoat(); }
			label 2 { @game_state := 3; }
		};
	}

	method : SetSpeechWrapped(text : String, color : Color) ~ Nil {
		if(text = Nil | text->IsEmpty()) { return; };
		max_len := 52;
		sz := text->Size();
		if(sz <= max_len) {
			@castle_speech->RenderedText(text, color);
			@castle_speech2->RenderedText("", Color->New(0, 0, 0));
			return;
		};
		# Find last space at or before max_len
		bp := max_len;
		found := false;
		i := max_len < sz ? max_len : sz - 1;
		while(i > 10 & <>found) {
			ch := text->SubString(i, 1);
			if(ch <> Nil & ch->Equals(" ")) { bp := i; found := true; };
			i -= 1;
		};
		line1 := text->SubString(0, bp);
		rest_start := bp + 1;
		rest_len := sz - rest_start;
		if(line1 <> Nil) { @castle_speech->RenderedText(line1->Trim(), color); };
		if(rest_len > 0) {
			line2 := text->SubString(rest_start, rest_len);
			if(line2 <> Nil) { @castle_speech2->RenderedText(line2->Trim(), color); };
		}
		else {
			@castle_speech2->RenderedText("", Color->New(0, 0, 0));
		};
	}

	method : CastleSpeakLord() ~ Nil {
		@castle_state := 1;
		# Check if boss defeated — different speech
		if(@monsters_killed > 40) {
			# Player has likely cleared the dungeon — offer reward speech
			reward := DungeonAI->GetTownMsg("lord_reward");
			if(reward <> Nil) {
				SetSpeechWrapped(reward, Color->New(255, 220, 100));
			}
			else {
				SetSpeechWrapped("You have saved the realm! Malachar is defeated!", Color->New(255, 220, 100));
			};
			@castle_speech2->RenderedText("The kingdom is in your debt.", Color->New(200, 185, 140));
			# Gift boat if player doesn't have one
			if(<>@has_boat) {
				@has_boat := true;
				@castle_speech2->RenderedText("Accept our finest vessel as reward.", Color->New(100, 220, 255));
			};
		}
		else {
			speech := DungeonAI->GetTownMsg("lord_speech");
			if(speech <> Nil) {
				SetSpeechWrapped(speech, Color->New(220, 200, 140));
			}
			else {
				SetSpeechWrapped("Brave adventurer — only you can stop Malachar!", Color->New(220, 200, 140));
			};
			threat := DungeonAI->GetWorldThreat();
			if(threat <> Nil) {
				@castle_speech2->RenderedText(threat, Color->New(180, 160, 120));
			};
		};
	}

	method : CastleGiftBoat() ~ Nil {
		if(@has_boat) {
			@castle_speech->RenderedText("You already command a vessel, brave soul.", Color->New(200, 185, 155));
			@castle_speech2->RenderedText("", Color->New(0, 0, 0));
		}
		else {
			SetSpeechWrapped("Prove yourself by defeating Malachar first.", Color->New(255, 160, 80));
			@castle_speech2->RenderedText("Return victorious and a boat shall be yours.", Color->New(180, 155, 115));
		};
		@castle_state := 1;
	}

	method : RenderCastle(frame : Int) ~ Nil {
		renderer := @framework->GetRenderer();
		@framework->SetClearColor(Color->New(6, 6, 10));
		@framework->Clear();

		# Stone background
		for(bx := 0; bx < 768; bx += 48;) {
			for(by := 0; by < 512; by += 48;) {
				renderer->RectangleColor(bx, by, bx + 47, by + 47, Color->New(22, 20, 28));
			};
		};

		# Left panel: castle + options
		renderer->BoxColor(10, 10, 340, 502, Color->New(18, 16, 24, 210));
		renderer->RectangleColor(10, 10, 340, 502, Color->New(80, 70, 110));
		renderer->RectangleColor(13, 13, 337, 499, Color->New(45, 40, 65));

		# Castle title
		tw := @castle_title->GetWidth();
		@castle_title->Render(175 - tw / 2, 24);
		renderer->HLineColor(20, 330, 48, Color->New(70, 60, 90));

		# Lord silhouette (SDL primitives)
		renderer->BoxColor(145, 65, 205, 180, Color->New(35, 30, 50));
		renderer->FilledCircleColor(175, 75, 18, Color->New(45, 38, 60));
		renderer->BoxColor(130, 100, 220, 175, Color->New(50, 42, 68));
		# Crown hint
		for(cx := 158; cx <= 192; cx += 8;) {
			renderer->VlineColor(cx, 56, 68, Color->New(180, 150, 50));
		};
		renderer->HLineColor(158, 192, 68, Color->New(180, 150, 50));

		renderer->HLineColor(20, 330, 192, Color->New(60, 52, 80));

		# Menu options
		for(i := 0; i < 3; i += 1;) {
			oy := 208 + i * 56;
			if(i = @castle_cursor) {
				renderer->BoxColor(18, oy - 4, 332, oy + 38, Color->New(45, 38, 65, 180));
				renderer->RectangleColor(18, oy - 4, 332, oy + 38, Color->New(100, 85, 140));
			};
			@castle_opts[i]->Render(30, oy + 6);
		};

		# Right panel: speech / info
		renderer->BoxColor(355, 10, 758, 440, Color->New(14, 12, 20, 210));
		renderer->RectangleColor(355, 10, 758, 440, Color->New(75, 65, 100));
		renderer->RectangleColor(358, 13, 755, 437, Color->New(42, 36, 60));

		if(@castle_state = 1) {
			renderer->HLineColor(365, 748, 45, Color->New(60, 52, 80));
			@castle_speech->Render(370, 18);
			sw2 := @castle_speech2->GetWidth();
			if(sw2 > 0) {
				renderer->HLineColor(365, 748, 100, Color->New(50, 44, 68));
				@castle_speech2->Render(370, 112);
			};
		}
		else {
			hint := "Speak with the Lord to learn the threat.";
			@castle_speech->RenderedText(hint, Color->New(130, 120, 160));
			@castle_speech->Render(370, 18);
		};

		# Bottom strip
		renderer->BoxColor(0, 452, 768, 512, Color->New(10, 8, 14));
		renderer->HLineColor(0, 768, 452, Color->New(70, 60, 95));
		wn := DungeonAI->IsWorldReady() ? DungeonAI->GetWorldName() : "the realm";
		wn_txt := "ESC=leave the castle   |   {$wn}";
		@castle_speech2->RenderedText(wn_txt, Color->New(100, 90, 130));
		@castle_speech2->Render(10, 464);

		# Torch flicker (blue-white castle torches)
		flk := (Float->Sin(frame->As(Float) * 0.1) * 6.0)->As(Int);
		fa := 14 + flk;
		renderer->FilledCircleColor(30, 30, 18, Color->New(200, 210, 255, fa));
		renderer->FilledCircleColor(320, 30, 18, Color->New(200, 210, 255, fa));

		@framework->Show();
	}

	method : SaveGame() ~ Nil {
		if(@player = Nil) { return; };

		builder := JsonBuilder->New();
		builder->PushObject();
		builder->Insert("version", 1);
		builder->Insert("floor", @current_floor);
		builder->Insert("loc_row", @player_location[0]);
		builder->Insert("loc_col", @player_location[1]);
		builder->Insert("dir", @player_direction->As(Int));
		builder->Insert("kills", @monsters_killed);

		builder->PushObject("player");
		builder->Insert("class_id", @player->GetClassId());
		builder->Insert("hp", @player->GetHp());
		builder->Insert("max_hp", @player->GetMaxHp());
		builder->Insert("mp", @player->GetMp());
		builder->Insert("max_mp", @player->GetMaxMp());
		builder->Insert("level", @player->GetLevel());
		builder->Insert("xp", @player->GetXP());
		builder->Insert("gold", @player->GetGold());
		builder->Insert("tents", @player->GetTents());
		builder->Insert("str", @player->GetStrength());
		builder->Insert("agi", @player->GetAgility());
		builder->Insert("sta", @player->GetStamina());
		builder->Insert("crit", @player->GetCritChance());
		wpn := @player->GetWeapon();
		builder->Insert("weapon_tier", wpn = Nil ? 0 : wpn->GetTier());
		arm := @player->GetArmor();
		builder->Insert("armor_tier", arm = Nil ? 0 : arm->GetTier());
		p1 := @player->GetPotion1();
		builder->Insert("p1_type", p1 = Nil ? 0 : p1->GetType()->As(Int));
		builder->Insert("p1_count", p1 = Nil ? 0 : p1->GetCount());
		p2 := @player->GetPotion2();
		builder->Insert("p2_type", p2 = Nil ? 0 : p2->GetType()->As(Int));
		builder->Insert("p2_count", p2 = Nil ? 0 : p2->GetCount());
		p3 := @player->GetPotion3();
		builder->Insert("p3_type", p3 = Nil ? 0 : p3->GetType()->As(Int));
		builder->Insert("p3_count", p3 = Nil ? 0 : p3->GetCount());
		builder->Insert("poison", @player->GetPoisonTurns());
		builder->Insert("blind", @player->GetBlindTurns());
		builder->Insert("confuse", @player->GetConfuseTurns());
		builder->Insert("slow", @player->GetSlowTurns());
		builder->Insert("defense", @player->GetDefenseBonus());
		builder->Insert("cursed_wpn", @player->HasCursedWeapon());
		builder->Insert("cursed_arm", @player->HasCursedArmor());
		builder->Pop();

		root := builder->PopAll();
		FileWriter->WriteFile("save.json", root->ToString());
		@title_has_save := true;
	}

	method : LoadGame() ~ Bool {
		json_text := FileReader->ReadFile("save.json");
		if(json_text = Nil) { return false; };

		root := JsonParser->TextToElement(json_text);
		if(root = Nil) { return false; };

		floor_elem := root->Get("floor");
		row_elem   := root->Get("loc_row");
		col_elem   := root->Get("loc_col");
		dir_elem   := root->Get("dir");
		kills_elem := root->Get("kills");
		p_root     := root->Get("player");
		if(floor_elem = Nil | row_elem = Nil | col_elem = Nil | dir_elem = Nil | p_root = Nil) { return false; };

		class_elem := p_root->Get("class_id");
		if(class_elem = Nil) { return false; };

		@current_floor  := floor_elem->GetInt();
		@player_location[0] := row_elem->GetInt();
		@player_location[1] := col_elem->GetInt();
		@monsters_killed := kills_elem = Nil ? 0 : kills_elem->GetInt();

		# restore player
		class_id := class_elem->GetInt();
		@player := Player->New("Warden", class_id);

		lvl_elem := p_root->Get("level");
		saved_level := lvl_elem = Nil ? 1 : lvl_elem->GetInt();

		hp_e     := p_root->Get("hp");
		maxhp_e  := p_root->Get("max_hp");
		mp_e     := p_root->Get("mp");
		maxmp_e  := p_root->Get("max_mp");
		xp_e     := p_root->Get("xp");
		gold_e   := p_root->Get("gold");
		tents_e  := p_root->Get("tents");
		str_e    := p_root->Get("str");
		agi_e    := p_root->Get("agi");
		sta_e    := p_root->Get("sta");
		crit_e   := p_root->Get("crit");
		wpn_e    := p_root->Get("weapon_tier");
		arm_e    := p_root->Get("armor_tier");

		if(hp_e <> Nil & maxhp_e <> Nil) { @player->SetHpDirect(hp_e->GetInt(), maxhp_e->GetInt()); };
		if(mp_e <> Nil & maxmp_e <> Nil) { @player->SetMpDirect(mp_e->GetInt(), maxmp_e->GetInt()); };
		if(xp_e <> Nil) { @player->SetXpDirect(xp_e->GetInt()); };
		if(gold_e <> Nil) { @player->SetGoldDirect(gold_e->GetInt()); };
		if(tents_e <> Nil) { @player->SetTentsDirect(tents_e->GetInt()); };
		if(str_e <> Nil & agi_e <> Nil & sta_e <> Nil) { @player->SetStatsDirect(str_e->GetFloat(), agi_e->GetFloat(), sta_e->GetFloat()); };
		if(crit_e <> Nil) { @player->SetCritChanceDirect(crit_e->GetInt()); };
		@player->SetLevelDirect(saved_level);
		@player->SetWeapon(TieredWeapon->Create(wpn_e = Nil ? 2 : wpn_e->GetInt()));
		@player->SetArmor(TieredArmor->Create(arm_e = Nil ? 1 : arm_e->GetInt()));
		@player->RestoreSpells(saved_level);

		# potions
		p1t := p_root->Get("p1_type"); p1c := p_root->Get("p1_count");
		p2t := p_root->Get("p2_type"); p2c := p_root->Get("p2_count");
		p3t := p_root->Get("p3_type"); p3c := p_root->Get("p3_count");
		if(p1t <> Nil & p1c <> Nil) { @player->SetPotionDirect(0, p1t->GetInt()->As(Potion->Type), p1c->GetInt()); };
		if(p2t <> Nil & p2c <> Nil) { @player->SetPotionDirect(1, p2t->GetInt()->As(Potion->Type), p2c->GetInt()); };
		if(p3t <> Nil & p3c <> Nil) { @player->SetPotionDirect(2, p3t->GetInt()->As(Potion->Type), p3c->GetInt()); };

		# status effects
		pe := p_root->Get("poison"); be := p_root->Get("blind"); ce := p_root->Get("confuse");
		se := p_root->Get("slow");  de := p_root->Get("defense");
		cwe := p_root->Get("cursed_wpn"); cae := p_root->Get("cursed_arm");
		@player->SetStatusDirect(
			pe = Nil ? 0 : pe->GetInt(),
			be = Nil ? 0 : be->GetInt(),
			ce = Nil ? 0 : ce->GetInt(),
			se = Nil ? 0 : se->GetInt(),
			de = Nil ? 0 : de->GetInt(),
			cwe = Nil ? false : cwe->GetBool(),
			cae = Nil ? false : cae->GetBool()
		);

		# restore direction
		dir_int := dir_elem->GetInt();
		select(dir_int) {
			label 1 { @player_direction := MapManager->Direction->SOUTH; }
			label 2 { @player_direction := MapManager->Direction->EAST; }
			label 3 { @player_direction := MapManager->Direction->WEST; }
			other   { @player_direction := MapManager->Direction->NORTH; }
		};

		# restore map state
		@map_manager->SetFloor(@current_floor);
		@player_nav_map := Int->New[MapManager->Type->MAP_SIZE, MapManager->Type->MAP_SIZE];
		@player_nav_map[@player_location[0], @player_location[1]] := 1;
		@can_show_item := false;
		@has_dungeon_key := false;
		@puzzle_active := false;
		@puzzle_timer := 0;
		@monster := Nil;
		@boss_fight := false;
		@mini_boss_fight := false;
		UpdateFloorText();
		UpdateQuestText();
		UpdateCompass();
		UpdateView();
		RefreshStats();
		RefreshItems();

		return true;
	}

	method : GetPlayerClassName() ~ String {
		if(@player = Nil) { return "Adventurer"; };
		select(@player->GetClassId()) {
			label PlayerClass->KNIGHT { return "Knight"; }
			label PlayerClass->CLERIC { return "Cleric"; }
			label PlayerClass->MAGE { return "Mage"; }
			label PlayerClass->NINJA { return "Ninja"; }
		};
		return "Adventurer";
	}

	method : StartLevel(inc_level : Int) ~ Nil {
		@player_direction := MapManager->Direction->NORTH;
		start_location := @map_manager->GetStart(inc_level);
		@player_location[0] := start_location[0];
		@player_location[1] := start_location[1];

		@player_nav_map := Int->New[MapManager->Type->MAP_SIZE, MapManager->Type->MAP_SIZE];
		@player_nav_map[@player_location[0], @player_location[1]] := 1;

		@can_show_item := false;
		@has_dungeon_key := false;
		@puzzle_active := false;
		@puzzle_timer := 0;

		if(inc_level > 0) {
			@current_floor += 1;
			@map_manager->SetType(@player_location, MapManager->Type->LATTER_DOWN);
		}
		else if(inc_level < 0) {
			@current_floor -= 1;
			@map_manager->SetType(@player_location, MapManager->Type->LATTER_UP);
		};

		UpdateFloorText();
		UpdateQuestText();
		UpdateCompass();

		# floor entry overlay
		if(inc_level <> 0) {
			floor_name : String;
			floor_lore : String;
			select(@current_floor) {
				label 1 {
					floor_name := "FLOOR I — THE CATACOMBS";
					floor_lore := "The dead lie uneasy beneath ancient stone.";
				}
				label 2 {
					floor_name := "FLOOR II — THE FORGOTTEN CRYPTS";
					floor_lore := "Spectral light weeps from the walls.";
				}
				label 3 {
					floor_name := "FLOOR III — THE DEEP HALLS";
					floor_lore := "Runes of binding crack and fail.";
				}
				label 4 {
					floor_name := "FLOOR IV — THE ABYSS";
					floor_lore := "The air itself burns. Malachar awaits.";
				}
			};
			if(floor_name <> Nil) {
				@floor_entry_name->RenderedText(floor_name, Color->New(220, 180, 60));
				@floor_entry_lore->RenderedText(floor_lore, Color->New(160, 140, 100));
				@floor_entry_timer := 150;
			};
		};

		# show AI theme lore placard on first dungeon entry
		if(@current_floor = 1 & DungeonAI->IsThemeReady() & @ai_timer = 0) {
			lore := DungeonAI->GetThemeLore();
			if(lore <> Nil) {
				@ai_text->RenderedText(lore, Color->New(200, 175, 90));
				@ai_timer := 260;
			};
		};

		MoveForward();
		UpdateView();
		if(inc_level <> 0) { SaveGame(); };
		if(@player <> Nil & DungeonAI->IsReady()) { DungeonAI->PostFloorBattleCries(@current_floor, GetPlayerClassName()); };
	}

	method : GetInput(e : Event) ~ Nil {
		# title screen
		if(@game_state = -1) {
			code := e->GetKey()->GetKeysym()->GetScancode();
			if(code = Scancode->SDL_SCANCODE_SPACE | code = Scancode->SDL_SCANCODE_RETURN) {
				@game_state := -2;
			}
			else if(code = Scancode->SDL_SCANCODE_C & @title_has_save) {
				if(LoadGame()) {
					@game_state := 0;
				};
			}
			else if(code = Scancode->SDL_SCANCODE_ESCAPE) {
				@quit := true;
			};
			return;
		};

		# class selection
		if(@game_state = -2) {
			code := e->GetKey()->GetKeysym()->GetScancode();
			if(code = Scancode->SDL_SCANCODE_UP | code = Scancode->SDL_SCANCODE_W) {
				@class_cursor -= 1;
				if(@class_cursor < 0) { @class_cursor := 3; };
			}
			else if(code = Scancode->SDL_SCANCODE_DOWN | code = Scancode->SDL_SCANCODE_S) {
				@class_cursor += 1;
				if(@class_cursor > 3) { @class_cursor := 0; };
			}
			else if(code = Scancode->SDL_SCANCODE_SPACE | code = Scancode->SDL_SCANCODE_RETURN) {
				# create player with selected class → enter overworld
				@player := Player->New("Warden", @class_cursor);
				@player->SetWeapon(TieredWeapon->Create(2));
				@player->SetArmor(TieredArmor->Create(1));
				@player->AddTent();
				@game_state := 3;
				DungeonAI->StartThemeAsync();
			}
			else if(code = Scancode->SDL_SCANCODE_ESCAPE) {
				@game_state := -1;
				@title_timer := 400;
			};
			return;
		};

		# town screen
		if(@game_state = 4) {
			HandleTownInput(e->GetKey()->GetKeysym()->GetScancode());
			return;
		};

		# castle screen
		if(@game_state = 5) {
			HandleCastleInput(e->GetKey()->GetKeysym()->GetScancode());
			return;
		};

		# terminal screens: only ESC
		if(@game_state = 1 | @game_state = 2) {
			if(e->GetKey()->GetKeysym()->GetScancode() = Scancode->SDL_SCANCODE_ESCAPE) {
				@quit := true;
			};
			return;
		};

		# --- Overworld input ---
		if(@game_state = 3) {
			if(@ow_move_cooldown > 0) { return; };
			code := e->GetKey()->GetKeysym()->GetScancode();
			dr := 0; dc := 0;
			if(code = Scancode->SDL_SCANCODE_UP    | code = Scancode->SDL_SCANCODE_W) { dr := -1; }
			else if(code = Scancode->SDL_SCANCODE_DOWN  | code = Scancode->SDL_SCANCODE_S) { dr :=  1; }
			else if(code = Scancode->SDL_SCANCODE_LEFT  | code = Scancode->SDL_SCANCODE_A) { dc := -1; }
			else if(code = Scancode->SDL_SCANCODE_RIGHT | code = Scancode->SDL_SCANCODE_D) { dc :=  1; };
			if(dr <> 0 | dc <> 0) {
				nr := @ow_player_r + dr; nc := @ow_player_c + dc;
				sea := @overworld_manager->GetTile(nr, nc);
				boat_ok := @has_boat & (sea = OverworldTile->SHALLOW_SEA | sea = OverworldTile->DEEP_SEA);
				if(@overworld_manager->IsPassable(nr, nc) | boat_ok) {
					@ow_player_r := nr; @ow_player_c := nc;
					@ow_last_dr := dr; @ow_last_dc := dc;
					@ow_step_count += 1;
					@ow_move_cooldown := 6;
					OverworldCheckEvent();
				};
			};
			return;
		};

		# block input during animation
		if(@anim_counter > 0) {
			return;
		};

		# --- Spell menu input ---
		if(@spell_menu_active) {
			code := e->GetKey()->GetKeysym()->GetScancode();
			if(code = Scancode->SDL_SCANCODE_UP | code = Scancode->SDL_SCANCODE_W) {
				@spell_menu_cursor -= 1;
				if(@spell_menu_cursor < 0) { @spell_menu_cursor := @player->GetNumSpells() - 1; };
				RefreshSpellMenu();
			}
			else if(code = Scancode->SDL_SCANCODE_DOWN | code = Scancode->SDL_SCANCODE_S) {
				@spell_menu_cursor += 1;
				if(@spell_menu_cursor >= @player->GetNumSpells()) { @spell_menu_cursor := 0; };
				RefreshSpellMenu();
			}
			else if(code = Scancode->SDL_SCANCODE_SPACE | code = Scancode->SDL_SCANCODE_RETURN) {
				@spell_menu_active := false;
				ExecuteSpellCast(@spell_menu_cursor);
			}
			else if(code = Scancode->SDL_SCANCODE_ESCAPE) {
				@spell_menu_active := false;
			};
			return;
		};

		# --- Puzzle input mode ---
		if(@puzzle_active & @puzzle_type = 0) {
			# rune door: match arrow sequence
			code := e->GetKey()->GetKeysym()->GetScancode();
			input_dir := -1;
			if(code = Scancode->SDL_SCANCODE_UP | code = Scancode->SDL_SCANCODE_W) { input_dir := 0; }
			else if(code = Scancode->SDL_SCANCODE_DOWN | code = Scancode->SDL_SCANCODE_S) { input_dir := 1; }
			else if(code = Scancode->SDL_SCANCODE_RIGHT | code = Scancode->SDL_SCANCODE_D) { input_dir := 2; }
			else if(code = Scancode->SDL_SCANCODE_LEFT | code = Scancode->SDL_SCANCODE_A) { input_dir := 3; }
			else if(code = Scancode->SDL_SCANCODE_ESCAPE) {
				# cancel puzzle
				@puzzle_active := false;
				@puzzle_timer := 0;
				return;
			};

			if(input_dir >= 0) {
				if(input_dir = @puzzle_sequence[@puzzle_input_pos]) {
					@puzzle_input_pos += 1;
					if(@puzzle_input_pos >= @puzzle_seq_len) {
						# puzzle solved!
						@puzzle_active := false;
						@puzzle_timer := 0;
						@map_manager->SetType(GetForwardPos(), MapManager->Type->OPEN);
						@view_type := MapManager->Type->OPEN;
						@can_show_item := false;
						gold_amount := 25 + @current_floor * 15 + Int->Random(0, 30);
						@player->AddGold(gold_amount);
						@reward_text->RenderedText("Rune door opens! +{$gold_amount} gold!", Color->New(100, 200, 255));
						@reward_timer := 60;
						RefreshStats();
						RefreshItems();
					}
					else {
						# show progress
						progress := @puzzle_input_pos;
						@puzzle_text->RenderedText("{$progress}/{$@puzzle_seq_len} correct...", Color->New(100, 220, 100));
						@puzzle_timer := 60;
					};
				}
				else {
					# wrong input - take damage and reset
					dmg := 3 + @current_floor * 2;
					@player->UpdateHp(dmg);
					@damage_text->RenderedText("-{$dmg} Wrong sequence!", Color->New(255, 80, 40));
					@damage_timer := 30;
					@damage_is_player := true;
					@puzzle_active := false;
					@puzzle_timer := 0;
					RefreshStats();
					if(<>@player->IsAlive()) { @game_state := 1; ShowTerminalScreen(); };
				};
			};
			return;
		};

		select(e->GetKey()->GetKeysym()->GetScancode()) {
        	label Scancode->SDL_SCANCODE_UP
        	label Scancode->SDL_SCANCODE_W {
        		if(@monster = Nil & <>@puzzle_active) {
        			# slow effect: skip every other move
        			if(@player <> Nil & @player->IsSlowed()) {
        				@damage_text->RenderedText("Slowed...", Color->New(150, 150, 200));
        				@damage_timer := 10;
        				@damage_is_player := true;
        				@player->SetSlow(@player->IsSlowed() ? 0 : 0);
        			};
        			# confusion effect: random direction change before moving
        			if(@player <> Nil & @player->IsConfused() & Int->Random(99) < 40) {
        				confuse_dir := Int->Random(2);
        				if(confuse_dir = 0) { MoveLeft(); }
        				else if(confuse_dir = 1) { MoveRight(); };
        				@damage_text->RenderedText("Confused!", Color->New(200, 150, 255));
        				@damage_timer := 15;
        				@damage_is_player := true;
        			};
   					@sound_manager->Step();
	        		MoveForward();
	        		UpdateView();
   		       		CheckBattle();

					# start forward animation
					@anim_type := 1;
					@anim_max_frames := 12;
					@anim_counter := 12;
	        	};
        	}

        	label Scancode->SDL_SCANCODE_LEFT
        	label Scancode->SDL_SCANCODE_A {
        		if(@monster = Nil) {
	        		MoveLeft();
	        		UpdateView();
					UpdateCompass();

					# start turn left animation
					@anim_type := 2;
					@anim_max_frames := 14;
					@anim_counter := 14;
	        	};
        	}

        	label Scancode->SDL_SCANCODE_RIGHT
        	label Scancode->SDL_SCANCODE_D {
        		if(@monster = Nil) {
	        		MoveRight();
	        		UpdateView();
					UpdateCompass();

					# start turn right animation
					@anim_type := 3;
					@anim_max_frames := 14;
					@anim_counter := 14;
	        	};
        	}

        	label Scancode->SDL_SCANCODE_SPACE {
        		DoConfirmAction();
        	}

        	# Read wall plaque (F2/E)
        	label Scancode->SDL_SCANCODE_F2
        	label Scancode->SDL_SCANCODE_E {
        		DoReadPlaque();
        	}

        	# Potion 1 (also P)
        	label Scancode->SDL_SCANCODE_F5
        	label Scancode->SDL_SCANCODE_P {
        		DoPotion();
        	}

        	# Cast spell (also Z)
        	label Scancode->SDL_SCANCODE_F6
        	label Scancode->SDL_SCANCODE_Z {
        		DoSpell();
        	}

        	# Flee (also Q)
        	label Scancode->SDL_SCANCODE_F7
        	label Scancode->SDL_SCANCODE_Q {
        		DoFlee();
        	}

        	# Use tent (F8/T) — only outside combat
        	label Scancode->SDL_SCANCODE_F8
        	label Scancode->SDL_SCANCODE_T {
        		DoTent();
        	}

			# Search wall / bash (F1) - find secret walls
			label Scancode->SDL_SCANCODE_F1 {
				if(@monster = Nil) {
					# check the tile directly ahead
					fwd_type := @view_forward_type;
					if(fwd_type = MapManager->Type->SECRET_WALL) {
						# found a secret passage!
						secret_pos := Int->New[2];
						secret_pos[0] := @player_location[0];
						secret_pos[1] := @player_location[1];
						select(@player_direction) {
							label MapManager->Direction->NORTH { secret_pos[0] -= 1; }
							label MapManager->Direction->SOUTH { secret_pos[0] += 1; }
							label MapManager->Direction->EAST { secret_pos[1] += 1; }
							label MapManager->Direction->WEST { secret_pos[1] -= 1; }
						};
						@map_manager->SetType(secret_pos, MapManager->Type->LOOT);
						UpdateView();
						@reward_text->RenderedText("Secret passage found!", Color->New(255, 220, 100));
						@reward_timer := 60;
						@sound_manager->TakeLoot();
					}
					else if(fwd_type = MapManager->Type->BLOCKED) {
						@damage_text->RenderedText("Nothing here...", Color->New(140, 130, 110));
						@damage_timer := 15;
						@damage_is_player := false;
					}
					else {
						@damage_text->RenderedText("Search the walls ahead.", Color->New(140, 130, 110));
						@damage_timer := 15;
						@damage_is_player := false;
					};
				};
			}

			label Scancode->SDL_SCANCODE_ESCAPE {
				if(@ai_timer > 0) {
					@ai_timer := 0;
				}
				else {
					@quit := true;
				};
			}
        };

	}

	method : ApplyMonsterAbility() ~ Nil {
		if(@monster = Nil | @player = Nil) { return; };

		gm := @monster->As(GenericMonster);
		if(gm = Nil) { return; };

		ability := gm->TryAbility();
		if(ability = MonsterAbility->NONE) { return; };

		select(ability) {
			label MonsterAbility->POISON_BITE {
				if(<>@player->IsPoisoned()) {
					@player->SetPoison(6 + @current_floor * 2);
					@reward_text->RenderedText("Poisoned!", Color->New(120, 255, 60));
					@reward_timer := 40;
				};
			}

			label MonsterAbility->LIFE_DRAIN {
				drain := 3 + @current_floor;
				@player->UpdateHp(drain);
				@monster->UpdateHp(-drain);
				@reward_text->RenderedText("Life drained! -{$drain} HP", Color->New(180, 40, 180));
				@reward_timer := 40;
			}

			label MonsterAbility->STUN {
				@player->SetSlow(4 + @current_floor);
				@reward_text->RenderedText("Stunned! Slowed...", Color->New(150, 150, 220));
				@reward_timer := 40;
			}

			label MonsterAbility->BLIND {
				@player->SetBlind(5 + @current_floor * 2);
				@reward_text->RenderedText("Blinded! Can't see the map!", Color->New(80, 80, 80));
				@reward_timer := 40;
			}

			label MonsterAbility->CONFUSE {
				@player->SetConfuse(6 + @current_floor);
				@reward_text->RenderedText("Confused! Directions scrambled!", Color->New(200, 150, 255));
				@reward_timer := 40;
			}

			label MonsterAbility->FIRE_BREATH {
				burn := 5 + @current_floor * 2 + Int->Random(0, 4);
				@player->UpdateHp(burn);
				@reward_text->RenderedText("Fire breath! -{$burn} HP!", Color->New(255, 120, 30));
				@reward_timer := 40;
			}
		};

		RefreshStats();
	}

	method : DoConfirmAction() ~ Nil {

        		if(@monster <> Nil) {
        			# Q-learning: pick monster action (skip for boss fights)
        			q_action := QPickAction();

        			if(q_action = DungeonAI->QAction->DEFEND) {
        				# monster recovers instead of attacking
        				@monster->UpdateHp(-3);
        				@player_hit := 0;
        				@damage_text->RenderedText("Defends!", Color->New(150, 200, 255));
        				@damage_timer := 20;
        				@damage_is_player := false;
        				@monster_defending := true;
        			}
        			else if(q_action = DungeonAI->QAction->ABILITY) {
        				# monster uses special ability instead of attacking
        				@player_hit := 0;
        				ApplyMonsterAbilityForced();
        			}
        			else {
        				@player_hit := @monster->Attack(@player) ? 10 : 0;
        				if(@player_hit > 0) {
							@sound_manager->Strike();

							# show player damage
							@damage_text->RenderedText("-{$@player_hit}", Color->New(255, 60, 60));
							@damage_timer := 20;
							@damage_is_player := true;

							# check monster special ability
							ApplyMonsterAbility();
        				};
        			};

        			if(<>@player->IsAlive()) {
						# game over — fight ends
						DungeonAI->EndFight();
						@monster_defending := false;
						@game_state := 1;
						ShowTerminalScreen();
        			}
        			else {
	        			@monster_hit := @player->Attack(@monster) ? 15 : 0;
	        			if(@monster_hit > 0) {
							@sound_manager->Strike();

							# show monster damage
							@damage_text->RenderedText("-{$@monster_hit}", Color->New(60, 255, 60));
							@damage_timer := 20;
							@damage_is_player := false;

							# trigger class-based attack animation
							select(@player->GetClassId()) {
								label PlayerClass->KNIGHT { @attack_anim_type := 1; }
								label PlayerClass->CLERIC { @attack_anim_type := 2; }
								label PlayerClass->MAGE { @attack_anim_type := 3; }
								label PlayerClass->NINJA { @attack_anim_type := 4; }
							};
							@attack_anim_timer := 20;
							@attack_anim_frame := 20;
						};

					# Q-learning update
					QUpdateRound(@player_hit, @monster_hit);
					@monster_defending := false;

					# boss taunt every 4 combat rounds
					if(@boss_fight & @monster <> Nil & @monster->IsAlive() & DungeonAI->IsReady() & @ai_timer = 0) {
						@boss_combat_round += 1;
						if(@boss_combat_round % 4 = 0) {
							boss_max_hp := 55;
							boss_hp_perc := @monster->GetHp() * 100 / boss_max_hp;
							taunt := DungeonAI->BossTaunt(GetPlayerClassName(), boss_hp_perc);
							if(taunt <> Nil) {
								@ai_text->RenderedText(taunt, Color->New(255, 120, 120));
								@ai_timer := 160;
							};
						};
					};

	        			if(<>@monster->IsAlive()) {
							# monster defeated
							xp_reward := @monster->GetWinExp();
							gold_reward := Int->Random(0, 2) * 10 + @current_floor * 5;
							was_boss := @monster->IsBoss();
							@monsters_killed += 1;

							# add rewards
							leveled_up := @player->AddXP(xp_reward);
							@player->AddGold(gold_reward);

							if(Int->Random(0, 2) = 0) {
								AddPotion(Potion->Type->WEAK_HEALTH);
							};

							# show reward text
							@reward_text->RenderedText("+{$xp_reward} XP  +{$gold_reward} Gold", Color->New(60, 255, 60));
							@reward_timer := 60;

							# check level up
							if(leveled_up) {
								new_level := @player->GetLevel();
								@levelup_text->RenderedText("LEVEL UP! Level {$new_level}!", Color->New(255, 255, 60));
								@levelup_timer := 90;
								if(DungeonAI->IsReady()) {
									quip := DungeonAI->LevelUpQuip(GetPlayerClassName(), new_level);
									if(quip <> Nil & @ai_timer = 0) {
										@ai_text->RenderedText(quip, Color->New(220, 220, 80));
										@ai_timer := 130;
									}
									else {
										# quip posted to worker; poll will display when ready
										@quip_pending := true;
										@last_quip_level := new_level;
									};
								};
							};

							# check boss victory
							if(was_boss & <>@mini_boss_fight) {
								@game_state := 2;
								ShowTerminalScreen();
							};

							# mini-boss guaranteed loot drop
							if(@mini_boss_fight) {
								tier := @current_floor + 1;
								if(tier > 7) { tier := 7; };
								if(Int->Random(1) = 0) {
									new_weapon := TieredWeapon->Create(tier);
									if(new_weapon->GetHit() > @player->GetWeapon()->GetHit()) {
										@player->SetWeapon(new_weapon);
									};
									weapon_name := new_weapon->ToString();
									@levelup_text->RenderedText("Champion's drop: {$weapon_name}!", Color->New(255, 200, 60));
								}
								else {
									new_armor := TieredArmor->Create(tier);
									if(new_armor->GetBlock() > @player->GetArmor()->GetBlock()) {
										@player->SetArmor(new_armor);
									};
									armor_name := new_armor->ToString();
									@levelup_text->RenderedText("Champion's drop: {$armor_name}!", Color->New(255, 200, 60));
								};
								@levelup_timer := 90;
								@mini_boss_fight := false;
								@boss_fight := false;
							};

	        				DungeonAI->EndFight();
	        				@monster := Nil;
	        				@player_hit := @monster_hit := 0;
	        				@monster_defending := false;
	        				SaveGame();
	        				if(@came_from_overworld & @game_state = 0) {
	        					@came_from_overworld := false;
	        					@game_state := 3;
	        				};
	        			};
	        		};

	        		RefreshStats();
	        	}
	        	else if(OnItem()) {
	        		if(@view_type = MapManager->Type->POTION) {
   						@sound_manager->TakePotion();
       					AddPotion(Potion->Type->WEAK_HEALTH);
	        		}
	        		else if(@view_type = MapManager->Type->LOOT) {
	        			# mimic chance: 15% on floor 2+, the chest fights back!
	        			if(@current_floor >= 2 & Int->Random(99) < 15 & @monster = Nil) {
	        				fl := @current_floor;
	        				@monster := Monster->CreateByFloor("Mimic", fl, 16 + fl * 4, 14, 10, 10, 36.0 + fl->As(Float) * 4.0, 16.0 + fl->As(Float) * 3.0, 25 + fl * 5, false);
	        				@monster_sprint_index := MonsterID->MIMIC;
	        				@monster_name_text->RenderedText("It's a Mimic!", Color->New(255, 200, 60));
	        				@map_manager->SetType(GetForwardPos(), MapManager->Type->OPEN);
	        				@can_show_item := false;
	        				RefreshStats();
	        			}
	        			else {
   						@sound_manager->TakeLoot();
	        			gold_amount := 20 + @current_floor * 15 + Int->Random(0, 30);
	        			if(DungeonAI->IsThemeReady() & DungeonAI->GetTreasure() = DungeonAI->Treasure->GOLD) {
	        				gold_amount += gold_amount / 2;
	        			};
	        			AddGold(gold_amount);

	        			weapon_chance := 35;
	        			armor_chance := 35;
	        			if(DungeonAI->IsThemeReady()) {
	        				if(DungeonAI->GetTreasure() = DungeonAI->Treasure->WEAPON) { weapon_chance := 55; }
	        				else if(DungeonAI->GetTreasure() = DungeonAI->Treasure->MAGIC) { armor_chance := 55; };
	        			};

	        			# chance for weapon upgrade
	        			if(Int->Random(99) < weapon_chance) {
	        				tier := @current_floor + Int->Random(0, 1);
	        				is_cursed := @current_floor >= 3 & Int->Random(99) < 20;
	        				if(is_cursed) { tier += 1; };
	        				if(tier > 7) { tier := 7; };
	        				new_weapon := TieredWeapon->Create(tier);
	        				if(new_weapon->GetHit() > @player->GetWeapon()->GetHit() | is_cursed) {
	        					if(<>@player->HasCursedWeapon() | <>is_cursed) {
	        						@player->SetWeapon(new_weapon);
	        						weapon_name := new_weapon->ToString();
	        						if(is_cursed) {
	        							@player->SetCursedWeapon(true);
	        							@reward_text->RenderedText("Cursed: {$weapon_name}!", Color->New(180, 60, 180));
	        						}
	        						else {
	        							@reward_text->RenderedText("Found: {$weapon_name}!", Color->New(255, 220, 60));
	        						};
	        						@reward_timer := 60;
	        					};
	        				};
	        			}
	        			# chance for armor upgrade
	        			else if(Int->Random(99) < armor_chance) {
	        				tier := @current_floor + Int->Random(0, 1);
	        				is_cursed := @current_floor >= 3 & Int->Random(99) < 20;
	        				if(is_cursed) { tier += 1; };
	        				if(tier > 7) { tier := 7; };
	        				new_armor := TieredArmor->Create(tier);
	        				if(new_armor->GetBlock() > @player->GetArmor()->GetBlock() | is_cursed) {
	        					if(<>@player->HasCursedArmor() | <>is_cursed) {
	        						@player->SetArmor(new_armor);
	        						armor_name := new_armor->ToString();
	        						if(is_cursed) {
	        							@player->SetCursedArmor(true);
	        							@reward_text->RenderedText("Cursed: {$armor_name}!", Color->New(180, 60, 180));
	        						}
	        						else {
	        							@reward_text->RenderedText("Found: {$armor_name}!", Color->New(255, 220, 60));
	        						};
	        						@reward_timer := 60;
	        					};
	        				};
	        			}
	        			# chance for tent
	        			else if(Int->Random(99) < 20) {
	        				@player->AddTent();
	        				@reward_text->RenderedText("Found a Tent!", Color->New(200, 200, 150));
	        				@reward_timer := 40;
	        			};

	        			RefreshStats();
	        		    };
	        		}
	        		else if(@view_type = MapManager->Type->LATTER_UP) {
	        			StartLevel(1);
	        		}
	        		else if(@view_type = MapManager->Type->LATTER_DOWN) {
	        			StartLevel(-1);
	        		}
					else if(@view_type = MapManager->Type->END) {
						if(@current_floor >= @max_floors & @monster = Nil) {
							SpawnBoss();
						};
					}
					# --- Dungeon Key pickup ---
					else if(@view_type = MapManager->Type->DUNGEON_KEY) {
						@has_dungeon_key := true;
						@map_manager->SetType(GetForwardPos(), MapManager->Type->OPEN);
						@view_type := MapManager->Type->OPEN;
						@can_show_item := false;
						@reward_text->RenderedText("Found a Dungeon Key!", Color->New(220, 200, 60));
						@reward_timer := 60;
					}
					# --- Rune Door: start arrow sequence puzzle ---
					else if(@view_type = MapManager->Type->RUNE_DOOR) {
						if(<>@puzzle_active) {
							@puzzle_active := true;
							@puzzle_type := 0;
							@puzzle_seq_len := 3 + @current_floor / 3;
							if(@puzzle_seq_len > 4) { @puzzle_seq_len := 4; };
							# generate random sequence based on position
							each(i : @puzzle_sequence) {
								@puzzle_sequence[i] := Int->Random(3);
							};
							@puzzle_input_pos := 0;
							# build display string
							seq_str := "Repeat: ";
							for(i := 0; i < @puzzle_seq_len; i += 1;) {
								select(@puzzle_sequence[i]) {
									label 0 { seq_str->Append("UP "); }
									label 1 { seq_str->Append("DOWN "); }
									label 2 { seq_str->Append("RIGHT "); }
									label 3 { seq_str->Append("LEFT "); }
								};
							};
							@puzzle_text->RenderedText(seq_str, Color->New(100, 180, 255));
							if(DungeonAI->IsReady() & @ai_timer = 0) {
								riddle := DungeonAI->RuneRiddle(seq_str);
								if(riddle <> Nil) {
									@ai_text->RenderedText(riddle, Color->New(200, 190, 150));
									@ai_timer := 180;
								};
							};
							@puzzle_timer := 90;
						};
					}
					# --- Spell Door: cast matching element ---
					else if(@view_type = MapManager->Type->SPELL_DOOR) {
						if(<>@puzzle_active) {
							@puzzle_active := true;
							@puzzle_type := 1;
							@puzzle_spell_element := Int->Random(2);
							element_name : String;
							select(@puzzle_spell_element) {
								label 0 { element_name := "Cast FLAME to open"; }
								label 1 { element_name := "Cast FROST to open"; }
								label 2 { element_name := "Cast LIGHTNING to open"; }
							};
							@puzzle_text->RenderedText(element_name, Color->New(255, 140, 50));
							if(DungeonAI->IsReady() & @ai_timer = 0) {
								spell_hint := DungeonAI->SpellHint(element_name);
								if(spell_hint <> Nil) {
									@ai_text->RenderedText(spell_hint, Color->New(200, 190, 150));
									@ai_timer := 180;
								};
							};
							@puzzle_timer := 120;
						};
					}
					# --- Key Door: check for key ---
					else if(@view_type = MapManager->Type->KEY_DOOR) {
						if(@has_dungeon_key) {
							@has_dungeon_key := false;
							@map_manager->SetType(GetForwardPos(), MapManager->Type->OPEN);
							@view_type := MapManager->Type->OPEN;
							@can_show_item := false;
							# reward: guaranteed loot
							gold_amount := 30 + @current_floor * 20 + Int->Random(0, 40);
							@player->AddGold(gold_amount);
							@reward_text->RenderedText("Door unlocked! +{$gold_amount} gold!", Color->New(255, 220, 60));
							@reward_timer := 60;
							RefreshStats();
							RefreshItems();
						}
						else {
							@damage_text->RenderedText("Locked! Find the dungeon key.", Color->New(200, 160, 60));
							@damage_timer := 40;
							@damage_is_player := false;
						};
					}
					# --- Mini-Boss encounter ---
					else if(@view_type = MapManager->Type->MINI_BOSS & @monster = Nil) {
						fl := @current_floor;
						if(fl <= 1) {
							@monster := Monster->CreateByFloor("Skeletal Champion", fl, 20, 15, 10, 12, 38.0, 18.0, 35, false);
							@monster_sprint_index := MonsterID->SKELETON;
						}
						else if(fl = 2) {
							@monster := Monster->CreateByFloor("Vampire Lord", fl, 24, 16, 12, 11, 42.0, 18.0, 40, false);
							@monster_sprint_index := MonsterID->VAMPIRE;
						}
						else if(fl = 3) {
							@monster := Monster->CreateByFloor("Iron Golem", fl, 35, 18, 5, 20, 44.0, 30.0, 50, false);
							@monster_sprint_index := MonsterID->GOLEM;
						}
						else {
							@monster := Monster->CreateByFloor("Eye of Chaos", fl, 30, 16, 14, 14, 50.0, 22.0, 55, false);
							@monster_sprint_index := MonsterID->EYE_TYRANT;
						};
						@boss_fight := true;
						@mini_boss_fight := true;
						monster_name := @monster->GetName();
						@monster_name_text->RenderedText("** {$monster_name} **", Color->New(255, 180, 60));
						@map_manager->SetType(GetForwardPos(), MapManager->Type->OPEN);
						@can_show_item := false;
					}
					# --- Merchant interaction ---
					else if(@view_type = MapManager->Type->MERCHANT) {
						HandleMerchant();
					}
					# --- Slopes: just flavor text ---
					else if(@view_type = MapManager->Type->SLOPE_UP) {
						@damage_text->RenderedText("The passage slopes upward...", Color->New(160, 150, 120));
						@damage_timer := 25;
						@damage_is_player := false;
					}
					else if(@view_type = MapManager->Type->SLOPE_DOWN) {
						@damage_text->RenderedText("The passage slopes downward...", Color->New(160, 150, 120));
						@damage_timer := 25;
						@damage_is_player := false;
					}
					# --- Safe room: rest and partial restore ---
					else if(@view_type = MapManager->Type->SAFE_ROOM) {
						# restore 40% HP and 30% MP, clear status effects
						restore_hp := @player->GetMaxHp() * 2 / 5;
						hp_before := @player->GetHp();
						@player->UpdateHp(-restore_hp);
						if(@player->GetHp() > @player->GetMaxHp()) {
							@player->UpdateHp(@player->GetHp() - @player->GetMaxHp());
						};
						hp_gained := @player->GetHp() - hp_before;
						# clear negative status
						@player->SetPoison(0);
						@player->SetBlind(0);
						@player->SetConfuse(0);
						@player->SetSlow(0);
						@reward_text->RenderedText("Safe haven! +{$hp_gained} HP restored", Color->New(255, 220, 100));
						@reward_timer := 60;
						RefreshStats();
					};
	        	};
        	
	}

	method : DoReadPlaque() ~ Nil {

        		if(@monster = Nil) {
        			# check if the wall ahead is a plaque
        			if(@view_forward_type = MapManager->Type->PLAQUE) {
        				plaque_str : String;
        				if(DungeonAI->IsReady()) {
        					plaque_str := DungeonAI->PlaqueText(@current_floor, GetPlayerClassName());
        				};
        				if(plaque_str = Nil) {
        					idx := Int->Random(@plaque_texts->Size() - 1);
        					plaque_str := @plaque_texts[idx];
        				};
        				@plaque_text_sprite->RenderedText(plaque_str, Color->New(245, 235, 200));
        				@plaque_timer := 120;
        			}
        			else {
        				@damage_text->RenderedText("No inscription here.", Color->New(140, 130, 110));
        				@damage_timer := 15;
        				@damage_is_player := false;
        			};
        		};
        	
	}

	method : DoPotion() ~ Nil {

        		if(@player->UsePotion(0)) {
        			RefreshStats();
        			RefreshItems();
        		};

        		if(@monster <> Nil) {
        			@player_hit := @monster->Attack(@player) ? 5 : 0;

        			if(<>@player->IsAlive()) {
						@game_state := 1;
						ShowTerminalScreen();
        			};
        		};
        	
	}

	method : DoSpell() ~ Nil {

        		# spell door puzzle: cast matching element to open
        		if(@puzzle_active & @puzzle_type = 1 & @player <> Nil) {
        			required_spell : String;
        			select(@puzzle_spell_element) {
        				label 0 { required_spell := "Flame"; }
        				label 1 { required_spell := "Frost"; }
        				label 2 { required_spell := "Lightning"; }
        			};
        			# find and try to cast the matching spell
        			cast_ok := false;
        			for(i := 0; i < @player->GetNumSpells(); i += 1;) {
        				sp := @player->GetSpell(i);
        				if(sp <> Nil & sp->GetName()->Equals(required_spell) & @player->GetMp() >= sp->GetMpCost()) {
        					power := @player->CastSpell(i);
        					if(power > 0) {
        						# spell door opens!
        						@puzzle_active := false;
        						@puzzle_timer := 0;
        						@map_manager->SetType(GetForwardPos(), MapManager->Type->OPEN);
        						@view_type := MapManager->Type->OPEN;
        						@can_show_item := false;
        						gold_amount := 30 + @current_floor * 20 + Int->Random(0, 35);
        						@player->AddGold(gold_amount);
        						@reward_text->RenderedText("Seal broken! +{$gold_amount} gold!", Color->New(255, 180, 60));
        						@reward_timer := 60;
        						cast_ok := true;
        					};
        				};
        			};
        			if(<>cast_ok) {
        				@damage_text->RenderedText("Wrong element or not enough MP!", Color->New(255, 100, 60));
        				@damage_timer := 30;
        				@damage_is_player := false;
        			};
        			RefreshStats();
        			RefreshItems();
        		}
        		else if(@monster <> Nil & @player <> Nil) {
        			if(@player->GetNumSpells() = 0) {
        				@damage_text->RenderedText("No spells learned yet.", Color->New(140, 130, 110));
        				@damage_timer := 25;
        				@damage_is_player := false;
        			}
        			else {
        				OpenSpellMenu();
        			};
        		};
        	
	}

	method : OpenSpellMenu() ~ Nil {
		@spell_menu_active := true;
		@spell_menu_cursor := 0;
		RefreshSpellMenu();
	}

	method : RefreshSpellMenu() ~ Nil {
		if(@player = Nil) { return; };
		num := @player->GetNumSpells();
		for(i := 0; i < num; i += 1;) {
			sp := @player->GetSpell(i);
			if(sp <> Nil) {
				mp_cost := sp->GetMpCost();
				power := sp->GetPower();
				num_str := i + 1;
				sp_name := sp->GetName();
				effect_str : String;
				if(sp->IsHeal()) { effect_str := "+{$power}HP"; }
				else { effect_str := "{$power}dmg"; };
				entry := "{$num_str}. {$sp_name}  {$effect_str}  {$mp_cost}MP";
				if(@player->GetMp() < mp_cost) {
					@spell_menu_sprites[i]->RenderedText(entry, Color->New(85, 78, 65));
				}
				else if(i = @spell_menu_cursor) {
					@spell_menu_sprites[i]->RenderedText(entry, Color->New(255, 220, 80));
				}
				else {
					@spell_menu_sprites[i]->RenderedText(entry, Color->New(210, 200, 175));
				};
			};
		};
	}

	method : ExecuteSpellCast(idx : Int) ~ Nil {
		if(@player = Nil | @monster = Nil) { return; };
		sp := @player->GetSpell(idx);
		if(sp = Nil) { return; };
		if(@player->GetMp() < sp->GetMpCost()) {
			@damage_text->RenderedText("Not enough MP!", Color->New(200, 100, 100));
			@damage_timer := 25;
			@damage_is_player := false;
			return;
		};
		power := @player->CastSpell(idx);
		if(power > 0) {
			spell_name := sp->GetName();
			if(sp->IsHeal()) {
				@damage_text->RenderedText("+{$power} HP ({$spell_name})", Color->New(100, 255, 100));
				@damage_timer := 25;
				@damage_is_player := false;
			}
			else {
				@monster->UpdateHp(power);
				@sound_manager->Strike();
				@damage_text->RenderedText("-{$power} ({$spell_name})", Color->New(100, 200, 255));
				@damage_timer := 25;
				@damage_is_player := false;
				@attack_anim_type := 3;
				@attack_anim_timer := 20;
				@attack_anim_frame := 20;

				if(<>@monster->IsAlive()) {
					xp_reward := @monster->GetWinExp();
					gold_reward := Int->Random(0, 2) * 10 + @current_floor * 5;
					was_boss := @monster->IsBoss();
					@monsters_killed += 1;
					leveled_up := @player->AddXP(xp_reward);
					@player->AddGold(gold_reward);
					@reward_text->RenderedText("+{$xp_reward} XP  +{$gold_reward} Gold", Color->New(60, 255, 60));
					@reward_timer := 60;
					if(leveled_up) {
						new_level := @player->GetLevel();
						@levelup_text->RenderedText("LEVEL UP! Level {$new_level}!", Color->New(255, 255, 60));
						@levelup_timer := 90;
						if(DungeonAI->IsReady()) {
							quip := DungeonAI->LevelUpQuip(GetPlayerClassName(), new_level);
							if(quip <> Nil & @ai_timer = 0) {
								@ai_text->RenderedText(quip, Color->New(220, 220, 80));
								@ai_timer := 130;
							}
							else {
								@quip_pending := true;
								@last_quip_level := new_level;
							};
						};
					};
					if(was_boss) { @game_state := 2; ShowTerminalScreen(); };
					DungeonAI->EndFight();
					@monster := Nil;
					@player_hit := @monster_hit := 0;
					SaveGame();
				};
			};
		};
		# monster retaliates if still alive
		if(@monster <> Nil) {
			@player_hit := @monster->Attack(@player) ? 8 : 0;
			if(@player_hit > 0) { @sound_manager->Strike(); };
			if(<>@player->IsAlive()) { @game_state := 1; ShowTerminalScreen(); };
		};
		RefreshStats();
	}

	method : DrawSpellMenu() ~ Nil {
		if(<>@spell_menu_active | @player = Nil) { return; };
		renderer := @framework->GetRenderer();

		px0 := 184; py0 := 128;
		px1 := 584; py1 := 395;

		# panel background + border
		renderer->BoxColor(px0, py0, px1, py1, Color->New(8, 4, 20, 235));
		renderer->RectangleColor(px0, py0, px1, py1, Color->New(90, 65, 150));
		renderer->RectangleColor(px0 + 3, py0 + 3, px1 - 3, py1 - 3, Color->New(50, 36, 90));
		# corner accents
		renderer->BoxColor(px0 + 1, py0 + 1, px0 + 7, py0 + 7, Color->New(90, 65, 150));
		renderer->BoxColor(px1 - 7, py0 + 1, px1 - 1, py0 + 7, Color->New(90, 65, 150));
		renderer->BoxColor(px0 + 1, py1 - 7, px0 + 7, py1 - 1, Color->New(90, 65, 150));
		renderer->BoxColor(px1 - 7, py1 - 7, px1 - 1, py1 - 1, Color->New(90, 65, 150));

		# title
		tw := @spell_menu_title->GetWidth();
		cx := (px0 + px1) / 2;
		@spell_menu_title->Render(cx - tw / 2, py0 + 10);
		renderer->HLineColor(px0 + 10, px1 - 10, py0 + 32, Color->New(65, 48, 110));

		# spell rows
		num := @player->GetNumSpells();
		row_y := py0 + 40;
		for(i := 0; i < num; i += 1;) {
			sp := @player->GetSpell(i);
			if(sp <> Nil) {
				# highlight selected row
				if(i = @spell_menu_cursor & @player->GetMp() >= sp->GetMpCost()) {
					renderer->BoxColor(px0 + 6, row_y - 2, px1 - 6, row_y + 24, Color->New(55, 40, 100, 180));
					renderer->RectangleColor(px0 + 6, row_y - 2, px1 - 6, row_y + 24, Color->New(100, 75, 160));
				};
				@spell_menu_sprites[i]->Render(px0 + 18, row_y + 2);
			};
			row_y += 32;
		};

		# cancel hint
		cw := @spell_menu_cancel->GetWidth();
		@spell_menu_cancel->Render(cx - cw / 2, py1 - 22);
		renderer->HLineColor(px0 + 10, px1 - 10, py1 - 26, Color->New(65, 48, 110));
	}

	method : DoTent() ~ Nil {
		if(@player = Nil) { return; };
		if(@monster <> Nil) {
			@damage_text->RenderedText("Can't rest during combat!", Color->New(255, 100, 60));
			@damage_timer := 20;
			@damage_is_player := false;
			return;
		};
		if(@player->GetTents() = 0) {
			@damage_text->RenderedText("No tents remaining.", Color->New(140, 130, 110));
			@damage_timer := 20;
			@damage_is_player := false;
			return;
		};
		if(@player->UseTent()) {
			@damage_text->RenderedText("You camp and rest fully. HP & MP restored.", Color->New(100, 220, 100));
			@damage_timer := 50;
			@damage_is_player := false;
			RefreshStats();
			RefreshItems();
			@sound_manager->TakeLoot();
		};
	}

	method : DoFlee() ~ Nil {

        		if(@monster <> Nil & @player <> Nil & <>@boss_fight) {
        			# flee chance based on agility
        			flee_chance := 35 + @player->GetAttack() / 2;
        			if(@player->GetClassId() = PlayerClass->NINJA) {
        				flee_chance += 20;
        			};
        			if(Int->Random(99) < flee_chance) {
        				@monster := Nil;
        				@player_hit := @monster_hit := 0;
        				@spell_menu_active := false;
        				@damage_text->RenderedText("Escaped!", Color->New(200, 200, 100));
        				@damage_timer := 30;
        				@damage_is_player := false;
        				if(@came_from_overworld) { @came_from_overworld := false; @game_state := 3; };
        			}
        			else {
        				# failed flee - monster gets free attack
        				@player_hit := @monster->Attack(@player) ? 12 : 0;
        				if(@player_hit > 0) { @sound_manager->Strike(); };
        				@damage_text->RenderedText("Can't escape! -{$@player_hit}", Color->New(255, 80, 80));
        				@damage_timer := 25;
        				@damage_is_player := true;
        				if(<>@player->IsAlive()) { @game_state := 1; ShowTerminalScreen(); };
        			};
        			RefreshStats();
        		}
        		else if(@boss_fight & @monster <> Nil) {
        			@damage_text->RenderedText("Cannot flee the Demon Lord!", Color->New(255, 60, 60));
        			@damage_timer := 25;
        			@damage_is_player := false;
        		};
        	
	}

	method : GetControllerInput(e : Event) ~ Nil {
		if(<>@controller_open) { return; };
		btn := e->GetJButton()->GetButton();

		# title screen
		if(@game_state = -1) {
			if(btn = GameControllerButton->SDL_CONTROLLER_BUTTON_A |
				btn = GameControllerButton->SDL_CONTROLLER_BUTTON_START) {
				@game_state := -2;
			}
			else if(btn = GameControllerButton->SDL_CONTROLLER_BUTTON_BACK) {
				@quit := true;
			};
			return;
		};

		# class selection
		if(@game_state = -2) {
			if(btn = GameControllerButton->SDL_CONTROLLER_BUTTON_DPAD_UP) {
				@class_cursor -= 1;
				if(@class_cursor < 0) { @class_cursor := 3; };
			}
			else if(btn = GameControllerButton->SDL_CONTROLLER_BUTTON_DPAD_DOWN) {
				@class_cursor += 1;
				if(@class_cursor > 3) { @class_cursor := 0; };
			}
			else if(btn = GameControllerButton->SDL_CONTROLLER_BUTTON_A |
				btn = GameControllerButton->SDL_CONTROLLER_BUTTON_START) {
				@player := Player->New("Warden", @class_cursor);
				@player->SetWeapon(TieredWeapon->Create(2));
				@player->SetArmor(TieredArmor->Create(1));
				@player->AddTent();
				@game_state := 3;
				DungeonAI->StartThemeAsync();
			};
			return;
		};

		# overworld
		if(@game_state = 3 & @ow_move_cooldown = 0) {
			dr := 0; dc := 0;
			if(btn = GameControllerButton->SDL_CONTROLLER_BUTTON_DPAD_UP)    { dr := -1; }
			else if(btn = GameControllerButton->SDL_CONTROLLER_BUTTON_DPAD_DOWN)  { dr :=  1; }
			else if(btn = GameControllerButton->SDL_CONTROLLER_BUTTON_DPAD_LEFT)  { dc := -1; }
			else if(btn = GameControllerButton->SDL_CONTROLLER_BUTTON_DPAD_RIGHT) { dc :=  1; };
			if(dr <> 0 | dc <> 0) {
				nr := @ow_player_r + dr; nc := @ow_player_c + dc;
				sea := @overworld_manager->GetTile(nr, nc);
				boat_ok := @has_boat & (sea = OverworldTile->SHALLOW_SEA | sea = OverworldTile->DEEP_SEA);
				if(@overworld_manager->IsPassable(nr, nc) | boat_ok) {
					@ow_player_r := nr; @ow_player_c := nc;
					@ow_last_dr := dr; @ow_last_dc := dc;
					@ow_step_count += 1;
					@ow_move_cooldown := 6;
					OverworldCheckEvent();
				};
			};
			return;
		};

		# terminal / game over
		if(@game_state = 1 | @game_state = 2) {
			if(btn = GameControllerButton->SDL_CONTROLLER_BUTTON_A |
				btn = GameControllerButton->SDL_CONTROLLER_BUTTON_START) {
				@game_state := -1;
			};
			return;
		};

		# rune door puzzle (puzzle_type=0)
		if(@puzzle_active & @puzzle_type = 0) {
			input_dir := -1;
			if(btn = GameControllerButton->SDL_CONTROLLER_BUTTON_DPAD_UP)         { input_dir := 0; }
			else if(btn = GameControllerButton->SDL_CONTROLLER_BUTTON_DPAD_DOWN)  { input_dir := 1; }
			else if(btn = GameControllerButton->SDL_CONTROLLER_BUTTON_DPAD_RIGHT) { input_dir := 2; }
			else if(btn = GameControllerButton->SDL_CONTROLLER_BUTTON_DPAD_LEFT)  { input_dir := 3; }
			else if(btn = GameControllerButton->SDL_CONTROLLER_BUTTON_BACK) {
				@puzzle_active := false;
				@puzzle_timer := 0;
				return;
			};
			if(input_dir >= 0) {
				if(input_dir = @puzzle_sequence[@puzzle_input_pos]) {
					@puzzle_input_pos += 1;
					if(@puzzle_input_pos >= @puzzle_seq_len) {
						@puzzle_active := false;
						@puzzle_timer := 0;
						@map_manager->SetType(GetForwardPos(), MapManager->Type->OPEN);
						@view_type := MapManager->Type->OPEN;
						@can_show_item := false;
						gold_amount := 25 + @current_floor * 15 + Int->Random(0, 30);
						@player->AddGold(gold_amount);
						@reward_text->RenderedText("Rune door opens! +{$gold_amount} gold!", Color->New(100, 200, 255));
						@reward_timer := 60;
						RefreshStats();
						RefreshItems();
					}
					else {
						progress := @puzzle_input_pos;
						@puzzle_text->RenderedText("{$progress}/{$@puzzle_seq_len} correct...", Color->New(100, 220, 100));
						@puzzle_timer := 60;
					};
				}
				else {
					dmg := 3 + @current_floor * 2;
					@player->UpdateHp(dmg);
					@damage_text->RenderedText("-{$dmg} Wrong sequence!", Color->New(255, 80, 40));
					@damage_timer := 30;
					@damage_is_player := true;
					@puzzle_active := false;
					@puzzle_timer := 0;
					RefreshStats();
					if(<>@player->IsAlive()) { @game_state := 1; ShowTerminalScreen(); };
				};
			};
			return;
		};

		# gameplay
		if(@game_state = 0 & @anim_counter = 0) {
			if(btn = GameControllerButton->SDL_CONTROLLER_BUTTON_A)           { DoConfirmAction(); }
			else if(btn = GameControllerButton->SDL_CONTROLLER_BUTTON_B)      { DoFlee(); }
			else if(btn = GameControllerButton->SDL_CONTROLLER_BUTTON_X)      { DoSpell(); }
			else if(btn = GameControllerButton->SDL_CONTROLLER_BUTTON_Y)      { DoPotion(); }
			else if(btn = GameControllerButton->SDL_CONTROLLER_BUTTON_RIGHTSHOULDER) { DoReadPlaque(); }
			else if(btn = GameControllerButton->SDL_CONTROLLER_BUTTON_START)  {
				@quit := true;
			}
			else if(btn = GameControllerButton->SDL_CONTROLLER_BUTTON_DPAD_UP & @monster = Nil) {
				MoveForward();
				UpdateView();
			}
			else if(btn = GameControllerButton->SDL_CONTROLLER_BUTTON_DPAD_DOWN & @monster = Nil) {
				MoveLeft();
				MoveLeft();
			}
			else if(btn = GameControllerButton->SDL_CONTROLLER_BUTTON_DPAD_LEFT & @monster = Nil) {
				MoveLeft();
				UpdateView();
				UpdateCompass();
			}
			else if(btn = GameControllerButton->SDL_CONTROLLER_BUTTON_DPAD_RIGHT & @monster = Nil) {
				MoveRight();
				UpdateView();
				UpdateCompass();
			};
		};
	}

	method : PollController() ~ Nil {
		if(<>@controller_open | @controller = Nil) { return; };
		if(@game_state <> 0 | @monster <> Nil | @puzzle_active | @anim_counter <> 0) { return; };

		if(@axis_cooldown > 0) {
			@axis_cooldown -= 1;
			return;
		};

		dead_zone := 8000;
		threshold := 12000;

		ly := @controller->GetAxis(GameControllerAxis->SDL_CONTROLLER_AXIS_LEFTY);
		lx := @controller->GetAxis(GameControllerAxis->SDL_CONTROLLER_AXIS_LEFTX);

		if(ly < (dead_zone * -1) - threshold) {
			MoveForward();
			UpdateView();
			@axis_cooldown := 18;
		}
		else if(ly > dead_zone + threshold) {
			MoveLeft();
			MoveLeft();
			@axis_cooldown := 18;
		}
		else if(lx < (dead_zone * -1) - threshold) {
			MoveLeft();
			UpdateView();
			UpdateCompass();
			@axis_cooldown := 18;
		}
		else if(lx > dead_zone + threshold) {
			MoveRight();
			UpdateView();
			UpdateCompass();
			@axis_cooldown := 18;
		};
	}

	method : QPickAction() ~ Int {
		if(<>DungeonAI->IsReady() | @boss_fight | @monster = Nil | @player = Nil) {
			return DungeonAI->QAction->ATTACK;
		};
		gm := @monster->As(GenericMonster);
		if(gm = Nil) { return DungeonAI->QAction->ATTACK; };
		mon_max := @monster->GetMaxHp();
		mon_pct := mon_max > 0 ? @monster->GetHp() * 100 / mon_max : 50;
		ply_max := @player->GetMaxHp();
		ply_pct := ply_max > 0 ? @player->GetHp() * 100 / ply_max : 50;
		return DungeonAI->ChooseAction(mon_pct, ply_pct, gm->GetAbility() <> MonsterAbility->NONE);
	}

	method : QUpdateRound(player_hit : Int, monster_hit : Int) ~ Nil {
		if(<>DungeonAI->IsReady() | @boss_fight | @monster = Nil | @player = Nil) { return; };
		reward := (player_hit->As(Float) / 10.0) - (monster_hit->As(Float) / 15.0) * 0.5;
		mon_max := @monster->GetMaxHp();
		mon_pct := mon_max > 0 ? @monster->GetHp() * 100 / mon_max : 0;
		ply_max := @player->GetMaxHp();
		ply_pct := ply_max > 0 ? @player->GetHp() * 100 / ply_max : 50;
		DungeonAI->UpdateQ(reward, mon_pct, ply_pct);
	}

	# Force monster ability without chance check (Q-learning ABILITY action)
	method : ApplyMonsterAbilityForced() ~ Nil {
		if(@monster = Nil | @player = Nil) { return; };
		gm := @monster->As(GenericMonster);
		if(gm = Nil) { return; };
		ability := gm->ForceAbility();
		if(ability = MonsterAbility->NONE) { return; };

		select(ability) {
			label MonsterAbility->POISON_BITE {
				if(<>@player->IsPoisoned()) {
					@player->SetPoison(6 + @current_floor * 2);
					@reward_text->RenderedText("Poison bite! Poisoned!", Color->New(120, 255, 60));
					@reward_timer := 40;
				};
			}
			label MonsterAbility->LIFE_DRAIN {
				drain := 3 + @current_floor;
				@player->UpdateHp(drain);
				@monster->UpdateHp(-drain);
				@reward_text->RenderedText("Life drain! -{$drain} HP", Color->New(180, 40, 180));
				@reward_timer := 40;
			}
			label MonsterAbility->STUN {
				@player->SetSlow(4 + @current_floor);
				@reward_text->RenderedText("Stunned! Slowed...", Color->New(150, 150, 220));
				@reward_timer := 40;
			}
			label MonsterAbility->BLIND {
				@player->SetBlind(5 + @current_floor * 2);
				@reward_text->RenderedText("Blinded! Can't see the map!", Color->New(80, 80, 80));
				@reward_timer := 40;
			}
			label MonsterAbility->CONFUSE {
				@player->SetConfuse(6 + @current_floor);
				@reward_text->RenderedText("Confused! Directions scrambled!", Color->New(200, 150, 255));
				@reward_timer := 40;
			}
			label MonsterAbility->FIRE_BREATH {
				burn := 5 + @current_floor * 2 + Int->Random(0, 4);
				@player->UpdateHp(burn);
				@reward_text->RenderedText("Fire breath! -{$burn} HP!", Color->New(255, 120, 30));
				@reward_timer := 40;
			}
		};
		RefreshStats();
	}

	method : HandleMerchant() ~ Nil {
		if(@player = Nil) { return; };

		gold := @player->GetGold();

		# AI merchant greeting on first visit
		if(@merchant_option = 0 & DungeonAI->IsReady() & @ai_timer = 0) {
			greeting := DungeonAI->MerchantGreet(GetPlayerClassName(), gold, @current_floor);
			if(greeting <> Nil) {
				@ai_text->RenderedText(greeting, Color->New(220, 195, 120));
				@ai_timer := 150;
			};
		};

		# cycle through merchant options each press
		@merchant_option += 1;
		if(@merchant_option > 4) { @merchant_option := 1; };

		select(@merchant_option) {
			label 1 {
				# buy health potion (25 gold)
				if(gold >= 25) {
					@player->AddGold(-25);
					@player->AddPotion(Potion->Type->WEAK_HEALTH, 2);
					@reward_text->RenderedText("Bought Health Potion x2 (-25g)", Color->New(100, 255, 100));
					@reward_timer := 50;
					if(DungeonAI->IsReady() & @ai_timer = 0) {
						react := DungeonAI->MerchantReact("Health Potion", true);
						if(react <> Nil) { @ai_text->RenderedText(react, Color->New(220, 195, 120)); @ai_timer := 120; };
					};
				}
				else {
					@damage_text->RenderedText("Not enough gold! (25g: Potion)", Color->New(200, 160, 60));
					@damage_timer := 30;
					@damage_is_player := false;
					if(DungeonAI->IsReady() & @ai_timer = 0) {
						react := DungeonAI->MerchantReact("Health Potion", false);
						if(react <> Nil) { @ai_text->RenderedText(react, Color->New(220, 195, 120)); @ai_timer := 120; };
					};
				};
			}

			label 2 {
				# buy tent (40 gold)
				if(gold >= 40) {
					@player->AddGold(-40);
					@player->AddTent();
					@reward_text->RenderedText("Bought a Tent (-40g)", Color->New(200, 200, 150));
					@reward_timer := 50;
					if(DungeonAI->IsReady() & @ai_timer = 0) {
						react := DungeonAI->MerchantReact("Tent", true);
						if(react <> Nil) { @ai_text->RenderedText(react, Color->New(220, 195, 120)); @ai_timer := 120; };
					};
				}
				else {
					@damage_text->RenderedText("Not enough gold! (40g: Tent)", Color->New(200, 160, 60));
					@damage_timer := 30;
					@damage_is_player := false;
					if(DungeonAI->IsReady() & @ai_timer = 0) {
						react := DungeonAI->MerchantReact("Tent", false);
						if(react <> Nil) { @ai_text->RenderedText(react, Color->New(220, 195, 120)); @ai_timer := 120; };
					};
				};
			}

			label 3 {
				# remove curse (50 gold)
				if(@player->HasAnyCurse()) {
					if(gold >= 50) {
						@player->AddGold(-50);
						@player->SetCursedWeapon(false);
						@player->SetCursedArmor(false);
						@reward_text->RenderedText("Curse lifted! (-50g)", Color->New(255, 255, 200));
						@reward_timer := 60;
						if(DungeonAI->IsReady() & @ai_timer = 0) {
							react := DungeonAI->MerchantReact("Curse Removal", true);
							if(react <> Nil) { @ai_text->RenderedText(react, Color->New(220, 195, 120)); @ai_timer := 120; };
						};
					}
					else {
						@damage_text->RenderedText("Not enough gold! (50g: Remove Curse)", Color->New(200, 160, 60));
						@damage_timer := 30;
						@damage_is_player := false;
						if(DungeonAI->IsReady() & @ai_timer = 0) {
							react := DungeonAI->MerchantReact("Curse Removal", false);
							if(react <> Nil) { @ai_text->RenderedText(react, Color->New(220, 195, 120)); @ai_timer := 120; };
						};
					};
				}
				else {
					@damage_text->RenderedText("No curses to remove.", Color->New(140, 130, 110));
					@damage_timer := 20;
					@damage_is_player := false;
				};
			}

			label 4 {
				# buy MP potion (30 gold)
				if(gold >= 30) {
					@player->AddGold(-30);
					@player->AddPotion(Potion->Type->WEAK_MAGIC, 2);
					@reward_text->RenderedText("Bought Magic Potion x2 (-30g)", Color->New(100, 150, 255));
					@reward_timer := 50;
					if(DungeonAI->IsReady() & @ai_timer = 0) {
						react := DungeonAI->MerchantReact("Magic Potion", true);
						if(react <> Nil) { @ai_text->RenderedText(react, Color->New(220, 195, 120)); @ai_timer := 120; };
					};
				}
				else {
					@damage_text->RenderedText("Not enough gold! (30g: MP Potion)", Color->New(200, 160, 60));
					@damage_timer := 30;
					@damage_is_player := false;
					if(DungeonAI->IsReady() & @ai_timer = 0) {
						react := DungeonAI->MerchantReact("Magic Potion", false);
						if(react <> Nil) { @ai_text->RenderedText(react, Color->New(220, 195, 120)); @ai_timer := 120; };
					};
				};
			}
		};

		RefreshStats();
		RefreshItems();
	}

	method : ShowTerminalScreen() ~ Nil {
		player_floor := @current_floor;
		player_level := @player->GetLevel();
		player_gold := @player->GetGold();
		player_kills := @monsters_killed;
		player_xp := @player->GetXP();
		class_name := GetPlayerClassName();

		wpn_name := "Fists";
		arm_name := "Rags";
		wpn := @player->GetWeapon();
		arm := @player->GetArmor();
		if(wpn <> Nil) { wpn_name := wpn->ToString(); };
		if(arm <> Nil) { arm_name := arm->ToString(); };

		if(@game_state = 1) {
			@terminal_title->RenderedText("THE WARDEN HAS FALLEN", Color->New(255, 80, 80));
			@terminal_stats[0]->RenderedText("Class: {$class_name}", @text_color);
			@terminal_stats[1]->RenderedText("Reached Floor: {$player_floor}   Level: {$player_level}", @text_color);
			@terminal_stats[2]->RenderedText("Monsters Slain: {$player_kills}   Gold: {$player_gold}", @text_color);
			@terminal_stats[3]->RenderedText("{$wpn_name}  |  {$arm_name}", Color->New(160, 150, 130));
			@terminal_stats[4]->RenderedText("", @text_color);
			@terminal_stats[5]->RenderedText("", @text_color);
			@terminal_stats[6]->RenderedText("Press ESC to exit", Color->New(150, 130, 100));
			epitaph := DungeonAI->DeathEulogy(class_name, player_floor, player_kills);
			if(epitaph <> Nil) {
				@terminal_epilogue->RenderedText(epitaph, Color->New(180, 100, 80));
			}
			else {
				@terminal_epilogue->RenderedText("", @text_color);
			};
		}
		else if(@game_state = 2) {
			@terminal_title->RenderedText("GREYHOLD IS CLEARED!", Color->New(255, 220, 60));
			@terminal_stats[0]->RenderedText("The {$class_name} has vanquished Malachar!", Color->New(220, 200, 100));
			@terminal_stats[1]->RenderedText("", @text_color);
			@terminal_stats[2]->RenderedText("Level: {$player_level}   XP: {$player_xp}", @text_color);
			@terminal_stats[3]->RenderedText("Monsters Slain: {$player_kills}   Gold: {$player_gold}", @text_color);
			@terminal_stats[4]->RenderedText("{$wpn_name}  |  {$arm_name}", Color->New(160, 150, 130));
			@terminal_stats[5]->RenderedText("", @text_color);
			@terminal_stats[6]->RenderedText("Press ESC to exit", Color->New(150, 130, 100));
			epilogue := DungeonAI->VictoryEpilogue(class_name, player_kills, player_gold);
			if(epilogue <> Nil) {
				@terminal_epilogue->RenderedText(epilogue, Color->New(200, 180, 90));
			}
			else {
				@terminal_epilogue->RenderedText("", @text_color);
			};
			# clear save — the run is complete
			FileWriter->WriteFile("save.json", "");
			@title_has_save := false;
		};
	}

	method : MoveForward() ~ Nil {
		player_view := @map_manager->GetView(@player_direction, @player_location);
		view_type := player_view[MapManager->View->VIEW_1, MapManager->Side->MIDDLE];
		if(IsOpen(view_type)) {
			@view_type := view_type;

			select(@player_direction) {
				label MapManager->Direction->NORTH {
					@player_location[0] -= 1;
				}

				label MapManager->Direction->SOUTH {
					@player_location[0] += 1;
				}

				label MapManager->Direction->EAST {
					@player_location[1] += 1;
				}

				label MapManager->Direction->WEST {
					@player_location[1] -= 1;
				}
			};

			if(@player_nav_map[@player_location[0], @player_location[1]] = 0) {
				@player_nav_map[@player_location[0], @player_location[1]] := 1;
			};

			# step effects (poison damage, MP regen)
			if(@player <> Nil) {
				poison_dmg := @player->OnStep();
				if(poison_dmg > 0) {
					@damage_text->RenderedText("-{$poison_dmg} (poison)", Color->New(120, 255, 60));
					@damage_timer := 15;
					@damage_is_player := true;
					if(<>@player->IsAlive()) { @game_state := 1; ShowTerminalScreen(); };
					RefreshStats();
				};
			};

			# trap activation
			if(@view_type = MapManager->Type->TRAP) {
				trap_roll := Int->Random(3);
				if(trap_roll = 0) {
					# damage trap
					dmg := 5 + @current_floor * 3 + Int->Random(0, 5);
					@player->UpdateHp(dmg);
					@damage_text->RenderedText("-{$dmg} TRAP!", Color->New(255, 80, 40));
					@damage_timer := 30;
					@damage_is_player := true;
					@sound_manager->Strike();
				}
				else if(trap_roll = 1) {
					# poison trap
					@player->SetPoison(8 + @current_floor * 2);
					@damage_text->RenderedText("Poisoned!", Color->New(120, 255, 60));
					@damage_timer := 30;
					@damage_is_player := true;
				}
				else {
					# alarm trap - forced encounter
					@damage_text->RenderedText("ALARM! Something approaches!", Color->New(255, 200, 60));
					@damage_timer := 30;
					@damage_is_player := false;
					# force an encounter
					@encounter_perc := 100;
				};

				# trap becomes open after triggering
				@map_manager->SetType(@player_location, MapManager->Type->OPEN);
				@view_type := MapManager->Type->OPEN;

				if(@player <> Nil & <>@player->IsAlive()) { @game_state := 1; ShowTerminalScreen(); };
				RefreshStats();
			};

			# reset encounter chance if it was boosted by alarm
			if(@encounter_perc > 15) {
				@encounter_perc := 10 + @current_floor * 2;
			};
		};
	}

	method : DistantView() ~ Nil {
		select(@player_direction) {
			label MapManager->Direction->NORTH {
				@view_forward_type := @map_manager->GetType(@player_location[0] - 1, @player_location[1]);
			}

			label MapManager->Direction->SOUTH {
				@view_forward_type := @map_manager->GetType(@player_location[0] + 1, @player_location[1]);

			}

			label MapManager->Direction->EAST {
				@view_forward_type := @map_manager->GetType(@player_location[0], @player_location[1] + 1);
			}

			label MapManager->Direction->WEST {
				@view_forward_type := @map_manager->GetType(@player_location[0], @player_location[1] - 1);
			}
		};
	}

	method : SpawnBoss() ~ Nil {
		@monster := Monster->CreateByFloor("Malachar", @current_floor, 55, 18, 12, 14, 48.0, 22.0, 100, true);
		@monster_sprint_index := MonsterID->DEMON_LORD;
		@boss_fight := true;
		@boss_combat_round := 0;
		@monster_name_text->RenderedText("*** Malachar, the Undying ***", Color->New(255, 60, 60));

		if(DungeonAI->IsReady()) {
			intro := DungeonAI->BossIntro(GetPlayerClassName(), @current_floor, @monsters_killed);
			if(intro <> Nil) {
				@ai_text->RenderedText(intro, Color->New(255, 140, 140));
				@ai_timer := 240;
			};
		};
	}

	method : CheckBattle() ~ Nil {
		# boss encounter on END tile
		if(@view_type = MapManager->Type->END & @current_floor >= @max_floors & @monster = Nil) {
			SpawnBoss();
			return;
		};

		# encounter chance increases with floor depth
		enc_chance := 10 + @current_floor * 2;
		if(<>OnItem() & @monster = Nil & Int->Random(99) < enc_chance) {
			roll := Int->Random(99);
			fl := @current_floor;

			# apply archetype theme bias (~40% of encounters)
			if(DungeonAI->IsThemeReady() & Int->Random(99) < 40) {
				roll := DungeonAI->ThemeBiasedRoll(fl);
			};

			# floor-specific encounter tables with unique names and stats
			#                                     name            fl  hp  str agi sta  wpn   arm  xp  boss
			if(fl = 1) {
				if(roll < 21)      { @monster := Monster->CreateByFloor("Giant Rat",       fl, 8,  12, 10, 5,  30.0, 10.0, 13, false); @monster_sprint_index := MonsterID->RAT; }
				else if(roll < 39) { @monster := Monster->CreateByFloor("Cave Bat",        fl, 6,  9,  13, 4,  25.0, 8.0,  10, false); @monster_sprint_index := MonsterID->BAT; }
				else if(roll < 53) { @monster := Monster->CreateByFloor("Skeleton",        fl, 10, 11, 8,  7,  32.0, 14.0, 15, false); @monster_sprint_index := MonsterID->SKELETON; }
				else if(roll < 67) { @monster := Monster->CreateByFloor("Dungeon Spider",  fl, 7,  10, 12, 5,  28.0, 9.0,  12, false); @monster_sprint_index := MonsterID->SPIDER; }
				else if(roll < 80) { @monster := Monster->CreateByFloor("Zombie",          fl, 14, 13, 5,  9,  34.0, 16.0, 18, false); @monster_sprint_index := MonsterID->ZOMBIE; }
				else if(roll < 90) { @monster := Monster->CreateByFloor("Mushroom Fiend",  fl, 9,  8,  7,  6,  26.0, 12.0, 14, false); @monster_sprint_index := MonsterID->MUSHROOM; }
				else               { @monster := Monster->CreateByFloor("Kobold",          fl, 6,  8,  14, 4,  22.0, 7.0,  11, false); @monster_sprint_index := MonsterID->KOBOLD; };
			}
			else if(fl = 2) {
				if(roll < 17)      { @monster := Monster->CreateByFloor("Ghost",           fl, 11, 10, 8,  7,  35.0, 13.0, 14, false); @monster_sprint_index := MonsterID->GHOST; }
				else if(roll < 33) { @monster := Monster->CreateByFloor("Shadow",          fl, 9,  11, 11, 6,  33.0, 11.0, 13, false); @monster_sprint_index := MonsterID->SHADOW; }
				else if(roll < 48) { @monster := Monster->CreateByFloor("Ghoul",           fl, 13, 12, 7,  8,  36.0, 15.0, 16, false); @monster_sprint_index := MonsterID->GHOUL; }
				else if(roll < 63) { @monster := Monster->CreateByFloor("Wraith",          fl, 10, 11, 9,  7,  38.0, 12.0, 15, false); @monster_sprint_index := MonsterID->WRAITH; }
				else if(roll < 77) { @monster := Monster->CreateByFloor("Dark Priest",     fl, 12, 10, 7,  9,  34.0, 17.0, 18, false); @monster_sprint_index := MonsterID->DARK_PRIEST; }
				else if(roll < 89) { @monster := Monster->CreateByFloor("Vampire",         fl, 14, 13, 10, 8,  38.0, 14.0, 20, false); @monster_sprint_index := MonsterID->VAMPIRE; }
				else               { @monster := Monster->CreateByFloor("Banshee",         fl, 8,  9,  12, 5,  32.0, 10.0, 16, false); @monster_sprint_index := MonsterID->BANSHEE; };
			}
			else if(fl = 3) {
				if(roll < 17)      { @monster := Monster->CreateByFloor("Ogre",            fl, 18, 15, 6,  12, 40.0, 20.0, 22, false); @monster_sprint_index := MonsterID->OGRE; }
				else if(roll < 32) { @monster := Monster->CreateByFloor("Troll",           fl, 20, 14, 7,  13, 38.0, 22.0, 24, false); @monster_sprint_index := MonsterID->TROLL; }
				else if(roll < 47) { @monster := Monster->CreateByFloor("Dark Knight",     fl, 16, 16, 9,  14, 44.0, 24.0, 26, false); @monster_sprint_index := MonsterID->DARK_KNIGHT; }
				else if(roll < 60) { @monster := Monster->CreateByFloor("Gargoyle",        fl, 15, 13, 10, 15, 36.0, 26.0, 23, false); @monster_sprint_index := MonsterID->GARGOYLE; }
				else if(roll < 71) { @monster := Monster->CreateByFloor("Lich",            fl, 14, 12, 8,  10, 42.0, 18.0, 30, false); @monster_sprint_index := MonsterID->LICH; }
				else if(roll < 82) { @monster := Monster->CreateByFloor("Stone Golem",     fl, 25, 16, 4,  18, 38.0, 28.0, 28, false); @monster_sprint_index := MonsterID->GOLEM; }
				else if(roll < 92) { @monster := Monster->CreateByFloor("Werewolf",        fl, 17, 16, 11, 12, 42.0, 18.0, 25, false); @monster_sprint_index := MonsterID->WEREWOLF; }
				else               { @monster := Monster->CreateByFloor("Medusa",          fl, 14, 13, 10, 11, 40.0, 20.0, 27, false); @monster_sprint_index := MonsterID->MEDUSA; };
			}
			else {
				if(roll < 18)      { @monster := Monster->CreateByFloor("Demon",           fl, 22, 16, 10, 13, 46.0, 22.0, 35, false); @monster_sprint_index := MonsterID->DEMON; }
				else if(roll < 35) { @monster := Monster->CreateByFloor("Hellhound",       fl, 18, 15, 14, 10, 42.0, 18.0, 30, false); @monster_sprint_index := MonsterID->HELLHOUND; }
				else if(roll < 51) { @monster := Monster->CreateByFloor("Dark Sorcerer",   fl, 16, 12, 9,  11, 48.0, 16.0, 38, false); @monster_sprint_index := MonsterID->DARK_SORCERER; }
				else if(roll < 65) { @monster := Monster->CreateByFloor("Dragon",          fl, 30, 18, 8,  16, 50.0, 28.0, 50, false); @monster_sprint_index := MonsterID->DRAGON; }
				else if(roll < 77) { @monster := Monster->CreateByFloor("Balor",           fl, 28, 17, 10, 15, 48.0, 26.0, 45, false); @monster_sprint_index := MonsterID->BALOR; }
				else if(roll < 89) { @monster := Monster->CreateByFloor("Eye Tyrant",      fl, 24, 14, 11, 12, 50.0, 20.0, 42, false); @monster_sprint_index := MonsterID->EYE_TYRANT; }
				else               { @monster := Monster->CreateByFloor("Nightmare",       fl, 20, 15, 16, 11, 44.0, 20.0, 38, false); @monster_sprint_index := MonsterID->NIGHTMARE; };
			};

			# show monster name
			monster_name := @monster->GetName();
			@monster_name_text->RenderedText(monster_name, Color->New(255, 200, 200));

			# AI battle cry (30% chance)
			if(DungeonAI->IsReady() & @ai_timer = 0 & Int->Random(9) < 3) {
				cry := DungeonAI->MonsterBattleCry(monster_name, GetPlayerClassName());
				if(cry <> Nil) {
					@ai_text->RenderedText(cry, Color->New(255, 140, 100));
					@ai_timer := 120;
				};
			};
		};
	}

	method : GetForwardPos() ~ Int[] {
		fwd := Int->New[2];
		select(@player_direction) {
			label MapManager->Direction->NORTH { fwd[0] := @player_location[0] - 1; fwd[1] := @player_location[1]; }
			label MapManager->Direction->SOUTH { fwd[0] := @player_location[0] + 1; fwd[1] := @player_location[1]; }
			label MapManager->Direction->EAST  { fwd[0] := @player_location[0];     fwd[1] := @player_location[1] + 1; }
			label MapManager->Direction->WEST  { fwd[0] := @player_location[0];     fwd[1] := @player_location[1] - 1; }
		};
		return fwd;
	}

	method : AddPotion(type : Potion->Type) ~ Nil {
		if(@player->AddPotion(type, Int->Random(1, 3)) & @map_manager->SetType(GetForwardPos(), MapManager->Type->OPEN)) {
			RefreshItems();
			@can_show_item := false;
		};
	}

	method : AddGold(amount : Int) ~ Nil {
		if(@map_manager->SetType(GetForwardPos(), MapManager->Type->OPEN)) {
			@player->AddGold(amount);
			RefreshItems();
			@can_show_item := false;
		};
	}

	method : UpdateView() ~ Nil {
		DistantView();
		player_view := @map_manager->GetView(@player_direction, @player_location);
		fwd := player_view[MapManager->View->VIEW_1, MapManager->Side->MIDDLE];
		@view_type := fwd;
		@can_preview_item := IsOpen(fwd);
		@can_show_item := OnItem();
	}

	method : OnItem() ~ Bool {
		return @view_type = MapManager->Type->POTION | @view_type = MapManager->Type->LOOT |
			@view_type = MapManager->Type->LATTER_UP | @view_type = MapManager->Type->LATTER_DOWN |
			@view_type = MapManager->Type->END |
			@view_type = MapManager->Type->RUNE_DOOR | @view_type = MapManager->Type->SPELL_DOOR |
			@view_type = MapManager->Type->KEY_DOOR | @view_type = MapManager->Type->DUNGEON_KEY |
			@view_type = MapManager->Type->MERCHANT | @view_type = MapManager->Type->MINI_BOSS |
			@view_type = MapManager->Type->SLOPE_UP | @view_type = MapManager->Type->SLOPE_DOWN |
			@view_type = MapManager->Type->SAFE_ROOM;
	}

	method : IsEnvironment() ~ Bool {
		return @view_type = MapManager->Type->TORCH | @view_type = MapManager->Type->FOUNTAIN |
			@view_type = MapManager->Type->ALTAR | @view_type = MapManager->Type->GRAVE |
			@view_type = MapManager->Type->PILLAR;
	}

	method : IsLadderForward() ~ Bool {
		return @view_forward_type = MapManager->Type->LATTER_UP | @view_type = MapManager->Type->LATTER_DOWN;
	}

	method : IsOpen(player_view : Int) ~ Bool {
		return player_view >= MapManager->Type->OPEN & player_view <> MapManager->Type->NONE &
			player_view <> MapManager->Type->BLOCKED & player_view <> MapManager->Type->SECRET_WALL &
			player_view <> MapManager->Type->PLAQUE | player_view = MapManager->Type->BRIDGE;
	}

	method : MoveLeft() ~ Nil {
		select(@player_direction) {
			label MapManager->Direction->NORTH {
				@player_direction := MapManager->Direction->WEST;
			}

			label MapManager->Direction->SOUTH {
				@player_direction := MapManager->Direction->EAST;
			}

			label MapManager->Direction->EAST {
				@player_direction := MapManager->Direction->NORTH;
			}

			label MapManager->Direction->WEST {
				@player_direction := MapManager->Direction->SOUTH;
			}
		};
	}

	method : MoveRight() ~ Nil {
		select(@player_direction) {
			label MapManager->Direction->NORTH {
				@player_direction := MapManager->Direction->EAST;
			}

			label MapManager->Direction->SOUTH {
				@player_direction := MapManager->Direction->WEST;
			}

			label MapManager->Direction->EAST {
				@player_direction := MapManager->Direction->SOUTH;
			}

			label MapManager->Direction->WEST {
				@player_direction := MapManager->Direction->NORTH;
			}
		};
	}

	method : UpdateAnimation() ~ Nil {
		if(@anim_counter > 0) {
			max_frames := @anim_max_frames;
			progress := 1.0 - @anim_counter->As(Float) / max_frames->As(Float);
			# ease-out: fast start, smooth deceleration
			ease := 1.0 - (1.0 - progress) * (1.0 - progress);

			if(@anim_type = 1) {
				# forward: perspective zoom with subtle head bob
				zoom := (ease * 18.0)->As(Int);
				bob := (Float->Sin(progress * 3.14) * 3.0)->As(Int);
				@dungeon_renderer->SetAnimOffset(0, -zoom + bob);
			}
			else if(@anim_type = 2) {
				# turn left: dramatic wall sweep from right
				sweep := 1.0 - ease;
				ox := (sweep * 60.0)->As(Int);
				oy := (Float->Sin(ease * 3.14) * 3.0)->As(Int);
				@dungeon_renderer->SetAnimOffset(ox, -oy);
			}
			else if(@anim_type = 3) {
				# turn right: dramatic wall sweep from left
				sweep := 1.0 - ease;
				ox := (sweep * 60.0)->As(Int);
				oy := (Float->Sin(ease * 3.14) * 3.0)->As(Int);
				@dungeon_renderer->SetAnimOffset(-ox, -oy);
			};

			@anim_counter -= 1;
			if(@anim_counter = 0) {
				@dungeon_renderer->ResetAnim();
				@anim_type := 0;
			};
		};
	}

	method : UpdateFlicker() ~ Nil {
		# disabled for debugging - just use static color
	}

	method : Render(frame_count : Int) ~ Nil {
		# title screen
		if(@game_state = -1) {
			RenderTitleScreen(frame_count);
			return;
		};

		# class selection
		if(@game_state = -2) {
			RenderClassSelect(frame_count);
			return;
		};

		# overworld
		if(@game_state = 3) {
			if(@ow_move_cooldown > 0) { @ow_move_cooldown -= 1; };
			wn := DungeonAI->IsWorldReady() ? DungeonAI->GetWorldName() : @ow_world_name;
			hp  := @player <> Nil ? @player->GetHp()    : 0;
			mhp := @player <> Nil ? @player->GetMaxHp() : 1;
			@overworld_manager->Render(@ow_player_r, @ow_player_c, frame_count, wn, hp, mhp, @ow_step_count, @ow_last_dr, @ow_last_dc);
			return;
		};

		# terminal screens (game over / victory)
		# town and castle screens
		if(@game_state = 4) {
			RenderTown(frame_count);
			return;
		};
		if(@game_state = 5) {
			RenderCastle(frame_count);
			return;
		};

		# terminal screens (game over / victory)
		if(@game_state = 1 | @game_state = 2) {
			RenderTerminalScreen();
			return;
		};

		@framework->Clear();

		# update animations
		UpdateAnimation();

		# background view — wilderness when overworld encounter, dungeon otherwise
		if(@came_from_overworld & @monster <> Nil) {
			RenderWilderness(frame_count);
		}
		else {
			RenderDungeon(frame_count);
		};

		# movement transition overlay
		if(@anim_counter > 0) {
			progress := 1.0 - @anim_counter->As(Float) / @anim_max_frames->As(Float);

			# 45-degree corner view during turns (strongest at mid-turn)
			if((@anim_type = 2) | (@anim_type = 3)) {
				corner_intensity := Float->Sin(progress * 3.14);
				if(corner_intensity > 0.15) {
					fi := @current_floor - 1;
					if(fi < 0) { fi := 0; };
					if(fi > 3) { fi := 3; };
					@dungeon_renderer->RenderCornerView(@anim_type, corner_intensity, fi);
				};
			};

			@dungeon_renderer->RenderTransition(@anim_type, progress);
		};

		# monster combat
		if(@monster <> Nil) {
			RenderMonster(frame_count);

			if(@player_hit > 0) {
				@dungeon_renderer->RenderPlayerHit();
				@player_hit -= 1;
			}
			else if(@monster_hit > 0) {
				@dungeon_renderer->RenderMonsterHit();
				@monster_hit -= 1;
			};

			# class-based attack animation overlay
			if(@attack_anim_timer > 0) {
				@dungeon_renderer->RenderAttackAnim(@attack_anim_type, @attack_anim_timer, 20);
				@attack_anim_timer -= 1;
			};

			# monster name
			@monster_name_text->Render(170, 100);

		};

		# HUD hint bar at viewport bottom -- always visible
		hint_rend := @framework->GetRenderer();
		hint_rend->BoxColor(15, 312, 429, 328, Color->New(18, 10, 6));
		hint_clr := Color->New(140, 130, 100);
		if(@monster <> Nil) {
			@hud_hint_text->RenderedText("[SPC/A] Attack  [P/Y] Potion  [Z/X] Spell  [Q/B] Flee", hint_clr);
		}
		else if(@puzzle_active) {
			@hud_hint_text->RenderedText("[Arrows/D-Pad] Match sequence  [ESC] Cancel", hint_clr);
		}
		else {
			@hud_hint_text->RenderedText("[W/S] Move  [A/D] Turn  [E/RB] Read  [P/Y] Potion  [F1] Search", hint_clr);
		};
		@hud_hint_text->Render(22, 314);

		# border
		RenderBorder();

		# minimap (hidden when blinded)
		if(@player = Nil | <>@player->IsBlind()) {
			RenderMap(frame_count);
		}
		else {
			# blinded - show dark overlay where map would be
			renderer2 := @framework->GetRenderer();
			renderer2->BoxColor(445, 15, 750, 295, Color->New(10, 5, 3));
			@flavor_text->RenderedText("You can't see!", Color->New(180, 80, 80));
			@flavor_text->Render(530, 140);
		};

		# compass and floor indicator
		@compass_text->Render(448, 300);
		@floor_text->Render(490, 300);

		# FPS / render-time readout (top-right of viewport)
		@fps_text->Render(360, 12);

		# stat box
		@stat_box->Render(15, 322);
		each(i : @stat_box_texts) {
			@stat_box_texts[i]->Render(25, 330 + i * 20);
		};

		# item box
		@item_box->Render(445, 322);
		each(i : @item_box_texts) {
			@item_box_texts[i]->Render(460, 330 + i * 24);
		};

		# quest text (only outside combat; combat hints use this sprite at y=314)
		if(@monster = Nil) {
			@quest_text->Render(15, 480);
		};

		# flavor text
		if(@flavor_timer > 0) {
			@flavor_text->Render(300, 480);
			@flavor_timer -= 1;
		};
		if(frame_count = 0 & @flavor_timer = 0) {
			if(Int->Random(100) < 10) {
				idx := Int->Random(@flavor_texts->Size() - 1);
				@flavor_text->RenderedText(@flavor_texts[idx], @flavor_color);
				@flavor_timer := 120;
			};
		};

		# puzzle door UI overlay
		if(@puzzle_active & @puzzle_timer > 0) {
			renderer := @framework->GetRenderer();
			# dark overlay
			renderer->BoxColor(60, 130, 380, 190, Color->New(15, 10, 8, 200));
			renderer->RectangleColor(60, 130, 380, 190, Color->New(120, 100, 60));
			@puzzle_text->Render(75, 145);
			if(@puzzle_type = 0) {
				hint_text := "Use arrow keys to match the sequence";
				@flavor_text->RenderedText(hint_text, Color->New(140, 130, 100));
				@flavor_text->Render(75, 168);
			}
			else if(@puzzle_type = 1) {
				@flavor_text->RenderedText("Press F6 to cast", Color->New(140, 130, 100));
				@flavor_text->Render(75, 168);
			};
			@puzzle_timer -= 1;
			if(@puzzle_timer = 0) {
				@puzzle_active := false;
			};
		};

		# plaque inscription overlay
		if(@plaque_timer > 0) {
			renderer := @framework->GetRenderer();
			# tablet auto-sizes to text width with 24px side padding, 12-pixel corner insets
			plq_tw := @plaque_text_sprite->GetWidth();
			plq_th := @plaque_text_sprite->GetHeight();
			plq_w := plq_tw + 48;
			if(plq_w < 320) { plq_w := 320; };
			plq_cx := 222;  # roughly centered in the 15..429 viewport
			plq_x0 := plq_cx - plq_w / 2;
			plq_x1 := plq_cx + plq_w / 2;
			plq_y0 := 120;
			plq_y1 := plq_y0 + plq_th + 28;
			# stone tablet background
			renderer->BoxColor(plq_x0, plq_y0, plq_x1, plq_y1, Color->New(110, 105, 90, 220));
			renderer->RectangleColor(plq_x0, plq_y0, plq_x1, plq_y1, Color->New(80, 75, 60));
			renderer->RectangleColor(plq_x0 + 3, plq_y0 + 3, plq_x1 - 3, plq_y1 - 3, Color->New(130, 125, 110, 150));
			# decorative corners
			renderer->FilledCircleColor(plq_x0 + 8, plq_y0 + 8, 3, Color->New(140, 135, 120));
			renderer->FilledCircleColor(plq_x1 - 8, plq_y0 + 8, 3, Color->New(140, 135, 120));
			renderer->FilledCircleColor(plq_x0 + 8, plq_y1 - 8, 3, Color->New(140, 135, 120));
			renderer->FilledCircleColor(plq_x1 - 8, plq_y1 - 8, 3, Color->New(140, 135, 120));
			# inscription text, centered
			@plaque_text_sprite->Render(plq_cx - plq_tw / 2, plq_y0 + (plq_y1 - plq_y0 - plq_th) / 2);
			@plaque_timer -= 1;
		};

		# damage text — monster hit upper-left, player hit right side
		if(@damage_timer > 0) {
			if(@damage_is_player) {
				@damage_text->Render(340, 195);
			}
			else {
				@damage_text->Render(160, 140);
			};
			@damage_timer -= 1;
		};

		# reward text — bottom-left of viewport (clear of center clash)
		if(@reward_timer > 0) {
			@reward_text->Render(20, 268);
			@reward_timer -= 1;
		};

		# level up text — center viewport, distinct row above reward
		if(@levelup_timer > 0) {
			@levelup_text->Render(160, 238);
			@levelup_timer -= 1;
		};

		# AI dialogue placard — shown in UPPER zone (y~100-160) so it never
		# clashes with reward (y=268), levelup (y=238), or damage texts
		if(@ai_timer > 0 & @levelup_timer = 0 & @reward_timer = 0) {
			ai_tw := @ai_text->GetWidth();
			p_w := ai_tw + 80;
			if(p_w < 360) { p_w := 360; };
			if(p_w > 414) { p_w := 414; };
			p_cx := 222;   # viewport center x
			p_x1 := p_cx - p_w / 2;
			p_x2 := p_cx + p_w / 2;
			p_y1 := 104;   # upper zone — above damage/monster area
			p_y2 := p_y1 + 38;
			text_x := p_cx - ai_tw / 2;
			text_y := p_y1 + (p_y2 - p_y1 - @ai_text->GetHeight()) / 2;

			rend := @framework->GetRenderer();
			rend->BoxColor(p_x1, p_y1, p_x2, p_y2, Color->New(18, 10, 28, 230));
			rend->RectangleColor(p_x1, p_y1, p_x2, p_y2, Color->New(180, 140, 50));
			rend->RectangleColor(p_x1 + 4, p_y1 + 4, p_x2 - 4, p_y2 - 4, Color->New(100, 75, 25));
			rend->HLineColor(p_x1 + 8, p_x2 - 8, p_y1 + 12, Color->New(140, 105, 35));
			rend->HLineColor(p_x1 + 8, p_x2 - 8, p_y2 - 12, Color->New(140, 105, 35));
			rend->BoxColor(p_x1 + 1, p_y1 + 1, p_x1 + 6, p_y1 + 6, Color->New(180, 140, 50));
			rend->BoxColor(p_x2 - 6, p_y1 + 1, p_x2 - 1, p_y1 + 6, Color->New(180, 140, 50));
			rend->BoxColor(p_x1 + 1, p_y2 - 6, p_x1 + 6, p_y2 - 1, Color->New(180, 140, 50));
			rend->BoxColor(p_x2 - 6, p_y2 - 6, p_x2 - 1, p_y2 - 1, Color->New(180, 140, 50));
			@ai_text->Render(text_x, text_y + 4);
			@ai_timer -= 1;
		}
		else if(@ai_timer > 0 & (@levelup_timer > 0 | @reward_timer > 0)) {
			@ai_timer -= 1;  # still count down, just don't render during overlap
		};

		# Poll async AI results
		if(DungeonAI->IsReady() & @ai_timer = 0) {
			# Battle cry: check cache for current monster
			if(@monster <> Nil) {
				mn := @monster->GetName();
				cry_key := "cry:{$mn}";
				cry := DungeonAI->GetCached(cry_key);
				if(cry <> Nil) {
					@ai_text->RenderedText(cry, Color->New(255, 140, 100));
					@ai_timer := 120;
				};
			};
			# Level-up quip: check cache when pending
			if(@quip_pending & @player <> Nil) {
				ql := @last_quip_level;
				quip := DungeonAI->GetCached("quip:{$ql}");
				if(quip <> Nil) {
					@ai_text->RenderedText(quip, Color->New(220, 220, 80));
					@ai_timer := 130;
					@quip_pending := false;
				};
			};
		};

		DrawFloorEntry();
		DrawSpellMenu();

		@framework->Show();
	}

	method : DrawFloorEntry() ~ Nil {
		if(@floor_entry_timer <= 0) { return; };
		renderer := @framework->GetRenderer();
		cx := Game->SCREEN_WIDTH / 2;

		# fade in / fade out alpha
		alpha : Int;
		if(@floor_entry_timer > 120) {
			alpha := (150 - @floor_entry_timer) * 255 / 30;
			if(alpha < 0) { alpha := 0; };
			if(alpha > 200) { alpha := 200; };
		}
		else if(@floor_entry_timer < 30) {
			alpha := @floor_entry_timer * 200 / 30;
		}
		else {
			alpha := 200;
		};

		# dark veil overlay
		renderer->BoxColor(0, 0, Game->SCREEN_WIDTH, Game->SCREEN_HEIGHT, Color->New(0, 0, 0, alpha));

		# only show text when alpha is above threshold
		if(alpha > 60) {
			tw := @floor_entry_name->GetWidth();
			lw := @floor_entry_lore->GetWidth();
			@floor_entry_name->Render(cx - tw / 2, Game->SCREEN_HEIGHT / 2 - 28);
			renderer->HLineColor(cx - 140, cx + 140, Game->SCREEN_HEIGHT / 2, Color->New(180, 140, 50));
			@floor_entry_lore->Render(cx - lw / 2, Game->SCREEN_HEIGHT / 2 + 12);
		};

		@floor_entry_timer -= 1;
	}

	method : RenderBorder() ~ Nil {
		# top border
		@border_rects[0]->GetPosition()->GetRect()->SetW(430);
		@border_rects[0]->GetPosition()->GetRect()->SetH(8);
		@border_rects[0]->Render(7, 7);

		# bottom border
		@border_rects[1]->GetPosition()->GetRect()->SetW(430);
		@border_rects[1]->GetPosition()->GetRect()->SetH(8);
		@border_rects[1]->Render(7, 310);

		# left border
		@border_rects[2]->GetPosition()->GetRect()->SetW(8);
		@border_rects[2]->GetPosition()->GetRect()->SetH(320);
		@border_rects[2]->Render(7, 7);

		# right border
		@border_rects[3]->GetPosition()->GetRect()->SetW(8);
		@border_rects[3]->GetPosition()->GetRect()->SetH(320);
		@border_rects[3]->Render(429, 7);
	}

	method : RenderClassSelect(frame : Int) ~ Nil {
		renderer := @framework->GetRenderer();
		@framework->SetClearColor(Color->New(10, 6, 3));
		@framework->Clear();

		# border
		bc := Color->New(35, 25, 15);
		renderer->BoxColor(0, 0, Game->SCREEN_WIDTH, 10, bc);
		renderer->BoxColor(0, Game->SCREEN_HEIGHT - 10, Game->SCREEN_WIDTH, Game->SCREEN_HEIGHT, bc);
		renderer->BoxColor(0, 0, 10, Game->SCREEN_HEIGHT, bc);
		renderer->BoxColor(Game->SCREEN_WIDTH - 10, 0, Game->SCREEN_WIDTH, Game->SCREEN_HEIGHT, bc);

		# title
		@class_select_text->Render(Game->SCREEN_WIDTH / 2 - @class_select_text->GetWidth() / 2, 40);

		# decorative line
		renderer->HLineColor(100, Game->SCREEN_WIDTH - 100, 75, Color->New(100, 80, 40));

		# class options
		for(i := 0; i < 4; i += 1;) {
			y := 110 + i * 90;

			# highlight selected
			if(i = @class_cursor) {
				renderer->BoxColor(60, y - 5, Game->SCREEN_WIDTH - 60, y + 55, Color->New(50, 35, 20));
				# cursor arrow
				pulse := (Float->Sin(frame->As(Float) * 0.12) * 4.0)->As(Int);
				renderer->SetDrawColor(220, 180, 60, 255);
				renderer->FillRect(Rect->New(35 + pulse, y + 8, 15, 4));
				renderer->FillRect(Rect->New(45 + pulse, y + 4, 5, 12));
			};

			@class_texts[i]->Render(80, y);
			@class_desc[i]->Render(80, y + 28);
		};

		# instructions (blink)
		if((frame / 35) % 2 = 0) {
			@class_inst_text->Render(Game->SCREEN_WIDTH / 2 - @class_inst_text->GetWidth() / 2, Game->SCREEN_HEIGHT - 40);
		};

		@framework->Show();
	}

	method : RenderTitleScreen(frame : Int) ~ Nil {
		renderer := @framework->GetRenderer();
		@framework->SetClearColor(Color->New(8, 4, 2));
		@framework->Clear();

		@title_timer += 1;

		# atmospheric stone border
		border_c := Color->New(35, 25, 15);
		renderer->BoxColor(0, 0, Game->SCREEN_WIDTH, 12, border_c);
		renderer->BoxColor(0, Game->SCREEN_HEIGHT - 12, Game->SCREEN_WIDTH, Game->SCREEN_HEIGHT, border_c);
		renderer->BoxColor(0, 0, 12, Game->SCREEN_HEIGHT, border_c);
		renderer->BoxColor(Game->SCREEN_WIDTH - 12, 0, Game->SCREEN_WIDTH, Game->SCREEN_HEIGHT, border_c);

		# flickering torches on sides
		flicker := (Float->Sin(frame->As(Float) * 0.12) * 6.0)->As(Int);
		alpha := 22 + flicker;
		if(alpha < 8) { alpha := 8; };
		renderer->FilledCircleColor(40, 250, 70, Color->New(255, 160, 50, alpha));
		renderer->FilledCircleColor(Game->SCREEN_WIDTH - 40, 250, 70, Color->New(255, 160, 50, alpha));
		renderer->FilledCircleColor(40, 255, 35, Color->New(255, 200, 100, alpha + 8));
		renderer->FilledCircleColor(Game->SCREEN_WIDTH - 40, 255, 35, Color->New(255, 200, 100, alpha + 8));

		# title
		pulse := (Float->Sin(frame->As(Float) * 0.04) * 20.0)->As(Int);
		title_c := Color->New(200 + pulse, 160 + pulse, 40);
		@title_text->RenderedText("WARDEN OF GREYHOLD", title_c);
		tx := Game->SCREEN_WIDTH / 2 - @title_text->GetWidth() / 2;
		@title_text->Render(tx, 60);

		# subtitle
		@title_sub->Render(Game->SCREEN_WIDTH / 2 - @title_sub->GetWidth() / 2, 100);

		# decorative line
		renderer->HLineColor(120, Game->SCREEN_WIDTH - 120, 130, Color->New(100, 80, 40));
		renderer->HLineColor(150, Game->SCREEN_WIDTH - 150, 132, Color->New(60, 50, 30));

		# lore text (fade in one line at a time)
		for(i := 0; i < @title_lore->Size(); i += 1;) {
			show_at := 60 + i * 50;
			if(@title_timer > show_at) {
				fade := @title_timer - show_at;
				if(fade > 60) { fade := 60; };
				a := (fade->As(Float) / 60.0 * 255.0)->As(Int);
				if(a > 255) { a := 255; };
				lx := Game->SCREEN_WIDTH / 2 - @title_lore[i]->GetWidth() / 2;
				@title_lore[i]->Render(lx, 160 + i * 35);
			};
		};

		# prompt (blinks after all lore shown)
		if(@title_timer > 360) {
			if((frame / 30) % 2 = 0) {
				px := Game->SCREEN_WIDTH / 2 - @title_prompt->GetWidth() / 2;
				@title_prompt->Render(px, 400);
				if(@title_has_save) {
					cx := Game->SCREEN_WIDTH / 2 - @title_continue->GetWidth() / 2;
					@title_continue->Render(cx, 425);
				};
			};
		};

		# small skull emblem at bottom
		renderer->FilledCircleColor(Game->SCREEN_WIDTH / 2, 460, 10, Color->New(180, 170, 150));
		renderer->FilledCircleColor(Game->SCREEN_WIDTH / 2 - 3, 457, 2, Color->New(30, 10, 5));
		renderer->FilledCircleColor(Game->SCREEN_WIDTH / 2 + 3, 457, 2, Color->New(30, 10, 5));
		renderer->BoxColor(Game->SCREEN_WIDTH / 2 - 4, 463, Game->SCREEN_WIDTH / 2 + 4, 468, Color->New(180, 170, 150));

		@framework->Show();
	}

	method : RenderTerminalScreen() ~ Nil {
		renderer := @framework->GetRenderer();
		cx := Game->SCREEN_WIDTH / 2;

		if(@game_state = 1) {
			@framework->SetClearColor(@gameover_color);
			@framework->Clear();
			# dim red vignette
			renderer->BoxColor(0, 0, Game->SCREEN_WIDTH, 60, Color->New(80, 0, 0, 120));
			renderer->BoxColor(0, Game->SCREEN_HEIGHT - 60, Game->SCREEN_WIDTH, Game->SCREEN_HEIGHT, Color->New(80, 0, 0, 120));
			renderer->HLineColor(60, Game->SCREEN_WIDTH - 60, 78, Color->New(140, 40, 40));
		}
		else {
			@framework->SetClearColor(@victory_color);
			@framework->Clear();
			# gold vignette
			renderer->BoxColor(0, 0, Game->SCREEN_WIDTH, 60, Color->New(60, 50, 0, 120));
			renderer->BoxColor(0, Game->SCREEN_HEIGHT - 60, Game->SCREEN_WIDTH, Game->SCREEN_HEIGHT, Color->New(60, 50, 0, 120));
			renderer->HLineColor(60, Game->SCREEN_WIDTH - 60, 78, Color->New(180, 140, 40));
		};

		# centered title
		tw := @terminal_title->GetWidth();
		@terminal_title->Render(cx - tw / 2, 28);

		# decorative rule below title
		if(@game_state = 1) {
			renderer->HLineColor(80, Game->SCREEN_WIDTH - 80, 90, Color->New(120, 30, 30));
		}
		else {
			renderer->HLineColor(80, Game->SCREEN_WIDTH - 80, 90, Color->New(160, 120, 30));
		};

		# stats centered
		stat_y := 115;
		each(i : @terminal_stats) {
			sw := @terminal_stats[i]->GetWidth();
			if(sw > 0) {
				@terminal_stats[i]->Render(cx - sw / 2, stat_y);
				stat_y += 38;
			};
		};

		# AI epilogue / epitaph
		ew := @terminal_epilogue->GetWidth();
		if(ew > 0) {
			if(@game_state = 1) {
				renderer->HLineColor(cx - 160, cx + 160, stat_y + 4, Color->New(100, 30, 30));
			}
			else {
				renderer->HLineColor(cx - 160, cx + 160, stat_y + 4, Color->New(140, 100, 20));
			};
			ex := cx - ew / 2;
			if(ex < 20) { ex := 20; };
			@terminal_epilogue->Render(ex, stat_y + 12);
		};

		@framework->Show();
	}

	method : RenderMonster(frame_count : Int) ~ Nil {
		renderer := @framework->GetRenderer();

		# draw monster using procedural art
		m_cy := 220;
		mid := @monster_sprint_index;
		if(mid = MonsterID->RAT | mid = MonsterID->SPIDER | mid = MonsterID->HELLHOUND | mid = MonsterID->MUSHROOM) {
			m_cy := 245;
		}
		else if(mid = MonsterID->BAT | mid = MonsterID->EYE_TYRANT) {
			m_cy := 190;
		}
		else if(mid = MonsterID->DRAGON | mid = MonsterID->DEMON_LORD | mid = MonsterID->BALOR | mid = MonsterID->GOLEM) {
			m_cy := 195;
		}
		else if(mid = MonsterID->OGRE | mid = MonsterID->TROLL) {
			m_cy := 205;
		}
		else if(mid = MonsterID->MIMIC) {
			m_cy := 250;
		};

		MonsterArt->Draw(renderer, @monster_sprint_index, 222, m_cy, frame_count);

		# HP bar
		bar_x := 160; bar_y := 300; bar_w := 120; bar_h := 8;
		monster_perc := @monster->GetHpPerc();
		fill_w := (bar_w->As(Float) * monster_perc)->As(Int);

		# bar background
		renderer->BoxColor(bar_x, bar_y, bar_x + bar_w, bar_y + bar_h, Color->New(60, 20, 20));
		# HP fill
		if(monster_perc > 0.5) {
			renderer->BoxColor(bar_x, bar_y, bar_x + fill_w, bar_y + bar_h, Color->New(40, 180, 40));
		}
		else if(monster_perc > 0.25) {
			renderer->BoxColor(bar_x, bar_y, bar_x + fill_w, bar_y + bar_h, Color->New(200, 180, 30));
		}
		else {
			renderer->BoxColor(bar_x, bar_y, bar_x + fill_w, bar_y + bar_h, Color->New(200, 40, 40));
		};
		# border
		renderer->RectangleColor(bar_x, bar_y, bar_x + bar_w, bar_y + bar_h, Color->New(120, 100, 80));
	}

	method : RenderWilderness(frame : Int) ~ Nil {
		renderer := @framework->GetRenderer();
		is_forest := @ow_encounter_tile = OverworldTile->FOREST;
		weather := @overworld_manager->GetWeather();

		# Sky — tone shifts with weather
		rain_tint := weather = 2 ? 20 : 0;
		sky_top_c := is_forest ? Color->New(18 + rain_tint, 32, 52) : Color->New(35 + rain_tint, 75, 138);
		sky_mid_c := is_forest ? Color->New(32, 52, 38) : Color->New(82, 135, 188);
		renderer->BoxColor(15, 7, 429, 160, sky_top_c);
		renderer->BoxColor(15, 160, 429, 210, sky_mid_c);

		# Drifting clouds (3, animated)
		cloud_bases := Int->New[3]; cloud_bases[0] := 80; cloud_bases[1] := 220; cloud_bases[2] := 360;
		for(ci := 0; ci < 3; ci += 1;) {
			drift := (frame / 4 + cloud_bases[ci]) % 440;
			ccy := 30 + ci * 18;
			ca := weather = 2 ? 50 : 35;
			cr := weather = 2 ? 170 : 232;
			renderer->FilledEllipseColor(15 + drift,      ccy,     26, 10, Color->New(cr, cr, 255, ca));
			renderer->FilledEllipseColor(15 + drift + 18, ccy - 4, 18,  8, Color->New(cr, cr, 255, ca - 8));
			renderer->FilledEllipseColor(15 + drift - 14, ccy - 2, 15,  7, Color->New(cr, cr, 255, ca - 8));
		};

		# Sun (grassland + clear/windy)
		if(<>is_forest & weather < 2) {
			renderer->FilledCircleColor(380, 42, 22, Color->New(240, 220, 120, 80));
			renderer->FilledCircleColor(380, 42, 16, Color->New(255, 240, 160, 140));
		};

		# Ground
		ground_c  := is_forest ? Color->New(18, 48, 18) : Color->New(42, 95, 35);
		ground_hi := is_forest ? Color->New(25, 68, 22) : Color->New(55, 118, 44);
		renderer->BoxColor(15, 210, 429, 303, ground_c);
		renderer->HLineColor(15, 429, 210, is_forest ? Color->New(30, 70, 25) : Color->New(60, 130, 50));

		# Animated environment
		if(is_forest) {
			# Swaying trees
			tree_offsets := Int->New[9];
			tree_offsets[0]:=30;  tree_offsets[1]:=70;  tree_offsets[2]:=110;
			tree_offsets[3]:=160; tree_offsets[4]:=210; tree_offsets[5]:=260;
			tree_offsets[6]:=305; tree_offsets[7]:=350; tree_offsets[8]:=395;
			for(ti := 0; ti < tree_offsets->Size(); ti += 1;) {
				tx := 15 + tree_offsets[ti];
				th := 40 + (ti % 3) * 15;
				sway := (Float->Sin(frame->As(Float) * 0.04 + ti->As(Float) * 2.1) * (weather + 2)->As(Float))->As(Int);
				renderer->BoxColor(tx - 6, 210 - th, tx + 6, 210, Color->New(14, 35, 14));
				renderer->FilledCircleColor(tx + sway,     210 - th,     14 + (ti % 2) * 5, Color->New(20, 52, 18));
				renderer->FilledCircleColor(tx + sway - 5, 210 - th + 8, 10,                Color->New(16, 42, 14));
				renderer->FilledCircleColor(tx + sway + 5, 210 - th + 6, 12,                Color->New(22, 55, 20));
			};
			# Ground texture
			for(gy := 215; gy < 303; gy += 8;) { renderer->HLineColor(15, 429, gy, ground_hi); };
		}
		else {
			# Animated grass tufts
			for(hx := 15; hx < 429; hx += 18;) {
				sway := (Float->Sin(frame->As(Float) * 0.06 + hx->As(Float) * 0.09) * (weather + 2)->As(Float))->As(Int);
				hh := (Float->Sin(hx->As(Float) * 0.08) * 8.0)->As(Int) + 5;
				renderer->VlineColor(hx + sway,     212 - hh,      212 + hh,      Color->New(65, 138, 52));
				renderer->VlineColor(hx + sway + 3, 215 - hh / 2,  215 + hh / 2,  Color->New(52, 114, 42));
			};
			renderer->FilledEllipseColor(150, 212, 120, 12, Color->New(48, 110, 38));
			renderer->FilledEllipseColor(320, 210, 90,  10, Color->New(40,  98, 32));
		};

		# Atmospheric fog
		fog_a := is_forest ? 65 : 28;
		fog_c : Color;
		if(is_forest) { fog_c := Color->New(15, 30, 15, fog_a); }
		else           { fog_c := Color->New(200, 220, 180, fog_a); };
		renderer->BoxColor(15, 200, 429, 222, fog_c);

		# Weather particles over the encounter scene
		if(weather >= 1) {
			# Wind streaks
			wa := weather = 2 ? 90 : 55;
			for(wi := 0; wi < 25; wi += 1;) {
				wx := (frame * 2 + wi * 31) % 414 + 15;
				wy := (frame + wi * 17) % 200 + 10;
				renderer->LineColor(wx, wy, wx + 8, wy + 3, Color->New(210, 225, 240, wa));
			};
		};
		if(weather = 2) {
			# Rain streaks
			for(ri := 0; ri < 35; ri += 1;) {
				rx := (frame * 3 + ri * 23) % 414 + 15;
				ry := (frame * 9 + ri * 41) % 296 + 7;
				renderer->LineColor(rx, ry, rx + 3, ry + 10, Color->New(140, 170, 215, 155));
			};
			# Puddle ripples on ground
			for(pi := 0; pi < 4; pi += 1;) {
				px := 40 + pi * 95;
				ripple := (frame / 8 + pi * 3) % 5;
				renderer->CircleColor(px, 295, ripple * 3, Color->New(100, 140, 200, 80));
			};
		};
	}

	method : RenderDungeon(frame_count : Int) ~ Nil {
		view := @map_manager->GetView(@player_direction, @player_location);
		@dungeon_renderer->Render(view, @current_floor, @view_type, @view_forward_type,
			@can_show_item, @can_preview_item, frame_count);
	}

	method : RenderMap(frame_count : Int) ~ Nil {
		renderer := @framework->GetRenderer();
		x_offset := 445;
		for(i := 0; i < MapManager->Type->MAP_SIZE; i += 1;) {
			y_offset := 15;
			for(j := 0; j < MapManager->Type->MAP_SIZE; j += 1;) {
				if(@player_location[1] = i & @player_location[0] = j) {
					# player tile: bright background + direction arrow
					renderer->BoxColor(x_offset, y_offset, x_offset + 13, y_offset + 13, Color->New(30, 55, 30));
					acx := x_offset + 7; acy := y_offset + 7;
					select(@player_direction) {
						label MapManager->Direction->NORTH {
							@tri_vx[0] := acx;     @tri_vy[0] := acy - 5;
							@tri_vx[1] := acx - 4; @tri_vy[1] := acy + 4;
							@tri_vx[2] := acx + 4; @tri_vy[2] := acy + 4;
						}
						label MapManager->Direction->SOUTH {
							@tri_vx[0] := acx;     @tri_vy[0] := acy + 5;
							@tri_vx[1] := acx - 4; @tri_vy[1] := acy - 4;
							@tri_vx[2] := acx + 4; @tri_vy[2] := acy - 4;
						}
						label MapManager->Direction->EAST {
							@tri_vx[0] := acx + 5; @tri_vy[0] := acy;
							@tri_vx[1] := acx - 4; @tri_vy[1] := acy - 4;
							@tri_vx[2] := acx - 4; @tri_vy[2] := acy + 4;
						}
						label MapManager->Direction->WEST {
							@tri_vx[0] := acx - 5; @tri_vy[0] := acy;
							@tri_vx[1] := acx + 4; @tri_vy[1] := acy - 4;
							@tri_vx[2] := acx + 4; @tri_vy[2] := acy + 4;
						}
					};
					renderer->FilledPolygonColor(@tri_vx, @tri_vy, Color->New(80, 220, 80));
				}
				else {
					if(@player_nav_map[j, i] = 0) {
						renderer->BoxColor(x_offset, y_offset, x_offset + 13, y_offset + 13, Color->New(14, 11, 8));
					}
					else {
						renderer->BoxColor(x_offset, y_offset, x_offset + 13, y_offset + 13, Color->New(52, 44, 34));

						# draw item/feature indicators on explored tiles
						tile := @map_manager->GetType(j, i);
						dot_x := x_offset + 8;
						dot_y := y_offset + 8;

						select(tile) {
							label MapManager->Type->POTION {
								# green dot
								renderer->FilledCircleColor(dot_x, dot_y, 3, Color->New(40, 200, 60, 220));
							}

							label MapManager->Type->LOOT {
								# gold dot
								renderer->FilledCircleColor(dot_x, dot_y, 3, Color->New(220, 180, 40, 220));
							}

							label MapManager->Type->LATTER_UP {
								# bright white filled down-triangle (ladder deeper)
								@tri_vx[0] := dot_x - 4; @tri_vy[0] := dot_y - 3;
								@tri_vx[1] := dot_x + 4; @tri_vy[1] := dot_y - 3;
								@tri_vx[2] := dot_x;     @tri_vy[2] := dot_y + 4;
								renderer->FilledPolygonColor(@tri_vx, @tri_vy, Color->New(230, 230, 255, 240));
							}

							label MapManager->Type->LATTER_DOWN {
								# light blue filled up-triangle (ladder back up)
								@tri_vx[0] := dot_x - 4; @tri_vy[0] := dot_y + 3;
								@tri_vx[1] := dot_x + 4; @tri_vy[1] := dot_y + 3;
								@tri_vx[2] := dot_x;     @tri_vy[2] := dot_y - 4;
								renderer->FilledPolygonColor(@tri_vx, @tri_vy, Color->New(180, 200, 240, 240));
							}

							label MapManager->Type->END {
								# red pulsing dot (boss door)
								renderer->FilledCircleColor(dot_x, dot_y, 4, Color->New(255, 40, 30, 200));
								renderer->FilledCircleColor(dot_x, dot_y, 2, Color->New(255, 150, 100, 220));
							}

							label MapManager->Type->MERCHANT {
								# purple dot
								renderer->FilledCircleColor(dot_x, dot_y, 3, Color->New(160, 80, 200, 220));
							}

							label MapManager->Type->MINI_BOSS {
								# orange dot
								renderer->FilledCircleColor(dot_x, dot_y, 3, Color->New(255, 160, 40, 220));
							}

							label MapManager->Type->RUNE_DOOR
							label MapManager->Type->SPELL_DOOR
							label MapManager->Type->KEY_DOOR {
								# cyan dot (puzzle door)
								renderer->FilledCircleColor(dot_x, dot_y, 3, Color->New(80, 180, 255, 220));
							}

							label MapManager->Type->DUNGEON_KEY {
								# yellow key shape
								renderer->FilledCircleColor(dot_x, dot_y, 3, Color->New(240, 220, 60, 230));
							}

							label MapManager->Type->SAFE_ROOM {
								# warm orange glow
								renderer->FilledCircleColor(dot_x, dot_y, 4, Color->New(255, 200, 80, 180));
								renderer->FilledCircleColor(dot_x, dot_y, 2, Color->New(255, 240, 150, 220));
							}

							label MapManager->Type->TRAP {
								# small red X
								renderer->LineColor(dot_x - 2, dot_y - 2, dot_x + 2, dot_y + 2, Color->New(200, 50, 40, 150));
								renderer->LineColor(dot_x + 2, dot_y - 2, dot_x - 2, dot_y + 2, Color->New(200, 50, 40, 150));
							}

							label MapManager->Type->BRIDGE {
								# tan bridge plank indicator
								renderer->BoxColor(dot_x - 4, dot_y - 1, dot_x + 4, dot_y + 1, Color->New(140, 95, 45, 220));
								renderer->BoxColor(dot_x - 3, dot_y - 3, dot_x + 3, dot_y + 3, Color->New(110, 75, 35, 180));
							}
						};

						# plaque indicator on walls next to explored tiles
						# check if any adjacent BLOCKED tile is actually a plaque
						if(j > 0 & @map_manager->GetType(j - 1, i) = MapManager->Type->PLAQUE) {
							renderer->FilledCircleColor(dot_x, dot_y - 6, 2, Color->New(180, 170, 140, 180));
						};
						if(j < MapManager->Type->MAP_SIZE - 1 & @map_manager->GetType(j + 1, i) = MapManager->Type->PLAQUE) {
							renderer->FilledCircleColor(dot_x, dot_y + 6, 2, Color->New(180, 170, 140, 180));
						};
						if(i > 0 & @map_manager->GetType(j, i - 1) = MapManager->Type->PLAQUE) {
							renderer->FilledCircleColor(dot_x - 6, dot_y, 2, Color->New(180, 170, 140, 180));
						};
						if(i < MapManager->Type->MAP_SIZE - 1 & @map_manager->GetType(j, i + 1) = MapManager->Type->PLAQUE) {
							renderer->FilledCircleColor(dot_x + 6, dot_y, 2, Color->New(180, 170, 140, 180));
						};
					};
				};
				y_offset += 17;
			};
			x_offset += 17;
		};
	}

	consts Game {
		SCREEN_WIDTH := 768,
		SCREEN_HEIGHT := 512
	}
}
