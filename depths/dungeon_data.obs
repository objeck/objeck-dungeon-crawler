#~
# Tiny Dungeon: Depths -- the data tables. No window, no sound: the constants and
# the numbers every other file shares (tiles, monsters, items, classes, themes),
# plus the small helpers and the seeded random generator.
#
# Everything a monster IS lives in one table (DgData->MonStat): hit points, attack,
# defence, experience, speed, which brain drives it (DgBrain, in dungeon_ai.obs)
# and how far it notices the hero. Change a row and the game changes.
~#

use Collection;

# --- what a square of the map is ---
consts DgTile {
  WALL := 0,
  FLOOR := 1,
  DOOR := 2,
  DOOR_OPEN := 3,
  STAIRS_DOWN := 4,
  STAIRS_UP := 5,
  WATER := 6,
  LAVA := 7,
  TORCH := 8,
  PILLAR := 9,
  SPIKES := 10,
  CHEST := 11,
  CHEST_OPEN := 12,
  SHRINE := 13,
  SHRINE_USED := 14,
  THRONE := 15,
  COUNT := 16
}

# --- the monsters, in table order ---
consts DgMon {
  RAT := 0,
  BAT := 1,
  SLIME := 2,
  SKELETON := 3,
  GOBLIN := 4,
  ARCHER := 5,
  ORC := 6,
  GHOST := 7,
  MAGE := 8,
  SPIDER := 9,
  YETI := 10,
  IMP := 11,
  WARLORD := 12,
  LICH := 13,
  COUNT := 14
}

# --- the brains (what drives a monster each turn) ---
consts DgAi {
  BFS := 0,        # breadth-first search: the fewest steps
  ERRATIC := 1,    # flutters: half random, half toward the hero
  GREEDY := 2,     # straight at the hero, no planning
  ASTAR := 3,      # A* over the local map
  FLANK := 4,      # A*, but to a free square beside the hero, to surround
  DIJKSTRA := 5,   # Dijkstra with walls that cost extra: walks through them
  TACTICAL := 6,   # minimax over a small duel: kites, shoots, closes in
  BOSS_MINIMAX := 7,
  BOSS_MCTS := 8
}

# --- the things you find ---
consts DgIt {
  GOLD := 0,
  POTION_HEAL := 1,
  POTION_MANA := 2,
  POTION_STR := 3,
  SCROLL_TELEPORT := 4,
  SCROLL_MAP := 5,
  SCROLL_FIRE := 6,
  WEAPON := 7,
  ARMOR := 8,
  GEM := 9,
  CROWN := 10,
  COUNT := 11
}

# --- the three heroes ---
consts DgCls {
  WARRIOR := 0,
  ROGUE := 1,
  MAGE := 2
}

